---
/**
 * Выезжающее справа меню. Перенесено из Ds2_2d9e23.BurgerMenu, дополнено
 * 2026-09: лого сверху панели и аккордеон «Услуги» с категориями —
 * тот же список, что в десктоп-меню (Header.astro) и в каталоге на
 * главной, единый источник — src/content/service-categories.
 */
import Icon from '../core/Icon.astro';
import IconButton from '../core/IconButton.astro';
import BrandIcon from '../core/BrandIcon.astro';
import Button from '../core/Button.astro';
import { clinic, navLinks } from '../../data/site';
import { withBase } from '../../lib/asset';
import { getCollection } from 'astro:content';

const href = withBase;
const { vk, max } = clinic.links;
const logo = withBase('logo-dentalcruise.svg');

const categories = (await getCollection('service-categories')).sort(
  (a, b) => a.data.order - b.data.order,
);
const pricelistHref = href('pricelist');
---

<div class="dc-burger" id="dc-menu" data-state="closed" aria-hidden="true">
  <div class="dc-burger__scrim" data-close></div>

  <nav class="dc-burger__panel" aria-label="Меню сайта">
    <div class="dc-burger__head">
      <a href={href('')} class="dc-burger__logo" aria-label={`${clinic.name} — на главную`} data-close>
        <img src={logo} alt={clinic.name} width="150" height="36" />
      </a>
      <IconButton label="Закрыть меню" variant="bare" data-close>
        <Icon name="x" size={24} />
      </IconButton>
    </div>

    <ul class="dc-burger__links">
      <li class="dc-burger__accordion">
        <button
          type="button"
          class="dc-burger__accordion-toggle"
          aria-expanded="false"
          aria-controls="burger-services"
        >
          Услуги
          <Icon name="chevron-down" size={22} />
        </button>
        <div class="dc-burger__accordion-body" id="burger-services">
          <ul class="dc-burger__sublist">
            {
              categories.map((cat) => (
                <li>
                  <a href={`${pricelistHref}#${cat.data.slug}`} data-close>
                    {cat.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </li>

      {
        navLinks
          .filter((l) => l.href !== '/')
          .map((link) => (
            <li>
              <a href={href(link.href.replace(/^\//, ''))} data-close>
                {link.label}
              </a>
            </li>
          ))
      }
    </ul>

    <div class="dc-burger__socials">
      {
        max && (
          <IconButton label="Написать в Max" href={max}>
            <BrandIcon name="max" size={20} />
          </IconButton>
        )
      }
      {
        vk && (
          <IconButton label="ВКонтакте" href={vk}>
            <BrandIcon name="vk" size={20} />
          </IconButton>
        )
      }
      <IconButton label="Позвонить" href={clinic.phoneHref} variant="accent">
        <Icon name="phone" size={20} />
      </IconButton>
    </div>

    <div class="dc-burger__info">
      <a href={clinic.phoneHref} class="dc-burger__phone">{clinic.phone}</a>
      <p>{clinic.scheduleLong}</p>
      <p>{clinic.address.locality}, {clinic.address.street}</p>
      <a href={`mailto:${clinic.email}`} class="dc-burger__mail">{clinic.email}</a>
      <p class="dc-burger__route">{clinic.metroNote}</p>
      <a href={clinic.links.yandexOrg} target="_blank" rel="noopener" class="dc-burger__map">
        <Icon name="map-pin" size={18} />
        Как добраться?
      </a>
    </div>

    <Button variant="primary" size="lg" fullWidth data-open="dc-book">Записаться на приём</Button>
  </nav>
</div>

<style>
  .dc-burger {
    position: fixed;
    inset: 0;
    z-index: 70;
    pointer-events: none;
  }
  .dc-burger[data-state='open'] {
    pointer-events: auto;
  }

  .dc-burger__scrim {
    position: absolute;
    inset: 0;
    background: rgba(7, 59, 75, 0.26);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out);
  }
  .dc-burger[data-state='open'] .dc-burger__scrim {
    opacity: 1;
  }

  .dc-burger__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: min(420px, 92vw);
    background: var(--surface-page);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
    overflow-y: auto;
    display: grid;
    align-content: start;
    gap: var(--space-6);
    transform: translateX(102%);
    opacity: 0;
    transition:
      transform var(--dur-mid) var(--ease-out),
      opacity var(--dur-mid) var(--ease-out);
  }
  .dc-burger[data-state='open'] .dc-burger__panel {
    transform: translateX(0);
    opacity: 1;
  }

  .dc-burger__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .dc-burger__logo img {
    height: 36px;
    width: auto;
  }

  .dc-burger__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .dc-burger__links > li > a {
    display: block;
    padding: 12px 0;
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: var(--type-h3);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--line-hairline);
  }
  .dc-burger__links > li > a:hover {
    color: var(--text-accent);
  }

  .dc-burger__accordion-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-hairline);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: var(--type-h3);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
  }
  .dc-burger__accordion-toggle :global(svg) {
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .dc-burger__accordion-toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .dc-burger__accordion-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-mid) var(--ease-out);
  }
  .dc-burger__accordion-toggle[aria-expanded='true'] + .dc-burger__accordion-body {
    grid-template-rows: 1fr;
  }
  .dc-burger__sublist {
    overflow: hidden;
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
    display: grid;
    gap: var(--space-1);
  }
  .dc-burger__sublist a {
    display: block;
    padding: 8px 0;
    font-family: var(--font-body);
    font-size: var(--type-body);
    font-weight: var(--fw-semibold);
    color: var(--text-body);
    text-decoration: none;
  }
  .dc-burger__sublist a:hover {
    color: var(--text-accent);
  }

  .dc-burger__socials {
    display: flex;
    gap: var(--space-2);
  }

  .dc-burger__info {
    display: grid;
    gap: var(--space-2);
  }
  .dc-burger__info p {
    color: var(--text-body);
    font-size: var(--type-body);
  }
  .dc-burger__phone {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    text-decoration: none;
  }
  .dc-burger__mail {
    color: var(--text-accent);
    font-weight: var(--fw-semibold);
  }
  .dc-burger__route {
    color: var(--text-muted) !important;
    font-size: var(--type-small) !important;
  }
  .dc-burger__map {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-accent);
    font-weight: var(--fw-bold);
    justify-self: start;
  }
</style>

<script>
  // Аккордеон «Услуги» — не открывает/закрывает бургер, поэтому не через overlays.ts
  document.querySelectorAll<HTMLButtonElement>('.dc-burger__accordion-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', String(btn.getAttribute('aria-expanded') !== 'true'));
    });
  });
</script>
