---
/**
 * Полоса «Как до нас добраться» перед подвалом — на каждой странице.
 * Светлая, как остальной сайт: подвал ниже тёмный, а этот блок — нет,
 * поэтому оформляем отдельной секцией, а не встраиваем в тёмный футер.
 */
import Icon from '../core/Icon.astro';
import YandexEmbed from '../content/YandexEmbed.astro';
import { clinic } from '../../data/site';

const { yandexPin, yandexMapWidget } = clinic.links;
---

<section class="dc-footer-map">
  <div class="dc-footer-map__inner">
    <div class="dc-footer-map__text">
      <h2>Как до нас добраться</h2>
      <p class="dc-footer-map__address">
        <Icon name="map-pin" size={18} color="var(--text-accent)" />
        {clinic.address.locality}, {clinic.address.street}
      </p>
      <p class="dc-footer-map__note">{clinic.metroNote}</p>
      <a href={yandexPin} target="_blank" rel="noopener" class="dc-footer-map__link">
        <Icon name="navigation" size={16} />
        Построить маршрут
      </a>
    </div>
    <YandexEmbed
      src={yandexMapWidget}
      title="Дентал Круиз на Яндекс Картах"
      height={220}
      class="dc-footer-map__embed"
    />
  </div>
</section>

<style>
  .dc-footer-map {
    background: var(--surface-warm);
    padding: var(--section-y-tight) var(--gutter);
  }
  .dc-footer-map__inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    gap: var(--space-6);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .dc-footer-map__inner {
      grid-template-columns: minmax(220px, 0.9fr) 1.4fr;
    }
  }
  .dc-footer-map__text {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .dc-footer-map__text h2 {
    font-family: var(--font-body);
    font-size: var(--type-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }
  .dc-footer-map__address {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-strong);
    font-weight: var(--fw-semibold);
  }
  .dc-footer-map__note {
    color: var(--text-muted);
    font-size: var(--type-small);
  }
  .dc-footer-map__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-2);
    color: var(--text-accent);
    font-weight: var(--fw-bold);
    font-size: var(--type-small);
    text-decoration: none;
  }
  .dc-footer-map__link:hover {
    text-decoration: underline;
  }
  .dc-footer-map__inner :global(.dc-footer-map__embed) {
    border-radius: var(--radius-lg);
  }
</style>
