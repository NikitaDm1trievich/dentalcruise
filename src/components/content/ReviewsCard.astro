---
/** Карточка рейтинга со ссылкой на Яндекс Карты. Из Ds2_2d9e23.ReviewsCard. */
import Icon from '../core/Icon.astro';
import Button from '../core/Button.astro';
import CountUp from '../core/CountUp.astro';
import { clinic } from '../../data/site';
import { cmsText } from '../../lib/cms-ref';
import { reviewsWord, yandexRating } from '../../lib/yandex-rating';
/* Рейтинг и число отзывов сайт берёт с Яндекс Карт при сборке
   (lib/yandex-rating); если Яндекс не ответил — запасные цифры из
   редактора («Главная страница» → «Отзывы»). Тот же источник у плашки
   рейтинга в полосе доверия, так что цифры на сайте везде одни и
   совпадают с виджетом Яндекс Карт на той же странице. */
import copy from '../../data/home.json';

interface Props {
  note?: string;
}
const { note = copy.reviews.cardNote } = Astro.props;

const { value, count } = await yandexRating();
const filled = Math.round(value);
---

<div class="dc-reviews" data-cms={cmsText('reviews.rating')}>
  <div class="dc-reviews__head">
    <span class="dc-reviews__value"><CountUp value={value} decimals={1} /></span>
    {/* role="img": без роли aria-label на span скринридер игнорирует,
        и пять декоративных звёзд остаются без названия. */}
    <span class="dc-reviews__stars" role="img" aria-label={`Рейтинг ${value} из 5`}>
      {
        [0, 1, 2, 3, 4].map((i) => (
          <Icon
            name="star"
            size={24}
            strokeWidth={1.5}
            color={i < filled ? 'var(--dc-turquoise)' : 'var(--dc-white-caps)'}
            fill={i < filled ? 'var(--dc-turquoise)' : 'none'}
          />
        ))
      }
    </span>
    <span class="dc-reviews__count" data-cms={cmsText('reviews.count')}><CountUp value={count} /> {reviewsWord(count)}</span>
  </div>

  <p class="dc-reviews__note" data-cms={cmsText('reviews.cardNote')}>{note}</p>

  <Button
    variant="secondary"
    href={clinic.links.yandexOrg}
    target="_blank"
    rel="noopener"
    data-cms={cmsText('reviews.cardButton')}
  >
    {copy.reviews.cardButton}
    <Icon slot="icon-right" name="arrow-up-right" size={20} />
  </Button>
</div>

<style>
  .dc-reviews {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding: var(--space-8);
    background: var(--surface-card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }
  .dc-reviews__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .dc-reviews__value {
    font-family: var(--font-display);
    font-size: var(--type-price);
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    line-height: 1;
  }
  .dc-reviews__stars {
    display: flex;
    gap: 2px;
  }
  .dc-reviews__count {
    color: var(--text-muted);
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
  }
  .dc-reviews__note {
    color: var(--text-body);
    max-width: min(var(--measure), 100%);
  }
</style>
