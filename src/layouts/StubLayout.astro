---
/**
 * Каркас для страниц, которые есть в навигации, но ещё не наполнены.
 *
 * Заглушка честная: говорит, что раздел готовится, и сразу даёт рабочие
 * каналы (телефон, запись, прайс). Пустая страница-«заглушка» без выхода
 * хуже отсутствия страницы.
 */
import BaseLayout from './BaseLayout.astro';
import SectionHeading from '../components/core/SectionHeading.astro';
import Button from '../components/core/Button.astro';
import Icon from '../components/core/Icon.astro';
import Reveal from '../components/core/Reveal.astro';
import { clinic } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  eyebrow: string;
  lead: string;
  noindex?: boolean;
}

const { title, description, path, heading, eyebrow, lead, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');
---

<BaseLayout title={title} description={description} path={path} noindex={noindex}>
  <section class="dc-stub">
    <div class="dc-stub__inner">
      <Reveal>
        <SectionHeading eyebrow={eyebrow} title={heading} lead={lead} />
      </Reveal>

      <Reveal delay={90}>
        <div class="dc-stub__body">
          <slot />
        </div>
      </Reveal>

      <Reveal delay={180}>
        <div class="dc-stub__actions">
          <Button variant="primary" size="lg" href={clinic.phoneHref}>
            <Icon slot="icon" name="phone" size={20} />
            {clinic.phone}
          </Button>
          <Button variant="secondary" size="lg" data-open="dc-book">Записаться на приём</Button>
          <Button variant="ghost" size="lg" href={asset('')}>На главную</Button>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .dc-stub {
    /* Отступ сверху — под фиксированную шапку */
    padding: calc(var(--header-h) + var(--section-y)) var(--gutter) var(--section-y);
    background: var(--grad-aqua);
    min-height: 70svh;
  }
  .dc-stub__inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
    display: grid;
    gap: var(--space-8);
  }
  .dc-stub__body:empty {
    display: none;
  }
  .dc-stub__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
