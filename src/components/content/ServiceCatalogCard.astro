---
/**
 * Карточка категории услуг в каталоге на главной. Referenced by scope
 * screenshot 3 (немецкий стоматологический центр): иконка + описание +
 * список входящих позиций с ценами, ссылка ведёт в раздел прайс-листа.
 *
 * Не флип-карточка — список позиций должен быть виден сразу, а не
 * прятаться за переворотом, как в ServiceFlipCard.
 */
import Icon from '../core/Icon.astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  items: { title: string; price: string }[];
  href: string;
}

const { title, description, icon, items, href } = Astro.props;

/**
 * Ровно три позиции на карточку: одинаковая высота списка держит ссылку
 * «Смотреть все услуги» на одной линии во всех карточках сетки.
 * Остальные позиции раздела — на странице прайса, куда ведёт ссылка.
 */
const shown = items.slice(0, 3);
---

<article class="dc-catalog-card">
  <div class="dc-catalog-card__icon">
    <Icon name={icon} size={26} strokeWidth={1.75} color="var(--text-accent)" />
  </div>

  <h3><a href={href} class="dc-catalog-card__title-link">{title}</a></h3>
  <p class="dc-catalog-card__desc">{description}</p>

  <ul class="dc-catalog-card__items">
    {
      shown.map((item) => (
        <li>
          <a href={href} class="dc-catalog-card__item">
            <span class="dc-catalog-card__item-title">{item.title}</span>
            <span class="dc-catalog-card__item-price">{item.price}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <a href={href} class="dc-catalog-card__link">
    Смотреть все услуги
    <Icon name="arrow-right" size={18} />
  </a>
</article>

<style>
  .dc-catalog-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: var(--space-3);
    height: 100%;
    min-width: 0;
    padding: var(--space-6);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    /* Карточка не двигается под курсором: за подпрыгивающей ссылкой
       неудобно целиться. Отклик — только тенью и рамкой. */
    transition:
      box-shadow var(--dur-mid) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out);
  }
  /* Фирменный подсвет в углу карточки — один цвет вместо палитры оригинала */
  .dc-catalog-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 14% 0%, var(--dc-turquoise-soft), transparent 58%);
    opacity: 0.45;
  }
  /* Линия у нижнего края растёт при наведении — карточка кликабельная */
  .dc-catalog-card::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    pointer-events: none;
    background: linear-gradient(90deg, var(--text-accent), transparent);
    transition: width var(--dur-slow) var(--ease-out);
  }
  .dc-catalog-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--line-strong);
  }
  .dc-catalog-card:hover::after {
    width: 100%;
  }

  .dc-catalog-card > * {
    position: relative;
    z-index: 1;
  }

  .dc-catalog-card__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--dc-turquoise-soft);
    background: var(--surface-quiet);
  }

  .dc-catalog-card h3 {
    font-size: var(--type-h3);
    /* Место под две строки: длинные названия не сдвигают прайс соседних карточек */
    min-height: calc(2em * var(--lh-heading));
  }
  .dc-catalog-card__title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .dc-catalog-card__title-link:hover,
  .dc-catalog-card__title-link:focus-visible {
    color: var(--text-accent);
  }

  .dc-catalog-card__desc {
    color: var(--text-muted);
    font-size: var(--type-small);
    /* То же выравнивание для описаний — три строки на всех карточках */
    min-height: calc(3em * var(--lh-body));
  }

  .dc-catalog-card__items {
    list-style: none;
    margin: 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--line-hairline);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .dc-catalog-card__items li {
    font-size: var(--type-small);
  }
  .dc-catalog-card__item {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }
  .dc-catalog-card__item-title {
    color: var(--text-body);
    min-width: 0;
    /* Подчёркивание — опознавательный знак ссылки: позиция кликабельна */
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .dc-catalog-card__item:hover .dc-catalog-card__item-title,
  .dc-catalog-card__item:focus-visible .dc-catalog-card__item-title {
    color: var(--text-accent);
    text-decoration-color: var(--text-accent);
  }
  .dc-catalog-card__item-price {
    flex: 0 0 auto;
    font-weight: var(--fw-bold);
    /* Усиленный контраст цены — тот же приём, что в карточках акций */
    color: var(--text-accent);
  }

  .dc-catalog-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: var(--fw-bold);
    color: var(--text-accent);
    text-decoration: none;
  }
  .dc-catalog-card__link:hover {
    color: var(--dc-turquoise-press);
  }
</style>
