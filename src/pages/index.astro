---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/core/SectionHeading.astro';
import Reveal from '../components/core/Reveal.astro';
import Button from '../components/core/Button.astro';
import Badge from '../components/core/Badge.astro';
import Icon from '../components/core/Icon.astro';

import CountUp from '../components/core/CountUp.astro';

import OceanHero from '../components/media/OceanHero.astro';
import PhotoGallery from '../components/media/PhotoGallery.astro';

import PromoBoard from '../components/content/PromoBoard.astro';
import ServiceCatalogCard from '../components/content/ServiceCatalogCard.astro';
import ProblemPicker from '../components/content/ProblemPicker.astro';
import BrandsMarquee from '../components/content/BrandsMarquee.astro';
import OfferStrip from '../components/content/OfferStrip.astro';
import ComparisonColumns from '../components/content/ComparisonColumns.astro';
import PriceChart from '../components/content/PriceChart.astro';
import DoctorFlipCard from '../components/content/DoctorFlipCard.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import ReviewsCard from '../components/content/ReviewsCard.astro';
import TrustBar from '../components/content/TrustBar.astro';
import YandexEmbed from '../components/content/YandexEmbed.astro';

import { clinic } from '../data/site';
import copy from '../data/home.json';
import { pageHref, withBase } from '../lib/asset';
import { clampText, priceValue } from '../lib/seo';
import { servicePageIndex } from '../lib/services';
import { cmsItem, cmsList, cmsText } from '../lib/cms-ref';

const asset = withBase;

type Ordered = { data: { order: number } };
const byOrder = (a: Ordered, b: Ordered) => a.data.order - b.data.order;

const promos = (await getCollection('promos')).sort(byOrder);
const categories = (await getCollection('service-categories')).sort(byOrder);
const brands = (await getCollection('brands')).sort(byOrder);
const comparison = (await getCollection('comparison')).sort(byOrder);
const doctors = (await getCollection('doctors')).filter((d) => d.data.featured).sort(byOrder);
const faq = (await getCollection('faq')).sort(byOrder);
const trust = (await getCollection('trust')).sort(byOrder);

/**
 * Позиции каталога ведут на страницы услуг, когда такая страница есть:
 * иначе главная не ссылалась ни на одну посадочную /uslugi/, и поисковик
 * не отдавал им веса с главной. Страница ищется по названию строки прайса;
 * позиции без своей страницы по-прежнему ведут в раздел прайс-листа.
 */
const pageFor = servicePageIndex(await getCollection('service-pages'));

/**
 * Подбор по проблеме. Врачи и раздел прайса в жалобе — ссылки по слагу:
 * имя, специальность и фото подтягиваются из карточки врача, название
 * раздела — из каталога, чтобы в ответе не устаревали копии.
 */
const allDoctors = await getCollection('doctors');
const minPrice = (prices: string[]) => {
  const amounts = prices.map(priceValue).filter((value) => value !== null);
  return amounts.length > 0 ? `от ${Math.min(...amounts).toLocaleString('ru-RU')} ₽` : undefined;
};
const problemCards = (await getCollection('problems')).sort(byOrder).map((problem) => {
  const section = categories.find((c) => c.data.slug === problem.data.section);
  return {
    id: problem.data.id,
    title: problem.data.title,
    short: problem.data.short,
    description: problem.data.description,
    icon: problem.data.icon,
    from: minPrice(problem.data.items.map((item) => item.price)),
    items: problem.data.items.map((item) => ({
      title: item.title,
      price: item.price,
      href: item.page ? pageHref(`uslugi/${item.page}`) : undefined,
    })),
    doctors: problem.data.doctors.flatMap((slug) => {
      const doctor = allDoctors.find((d) => d.id === slug);
      if (!doctor) return [];
      return [
        {
          name: doctor.data.name,
          speciality: doctor.data.speciality,
          photo: doctor.data.photo ? asset(doctor.data.photo) : undefined,
          href: pageHref(`doctors/${doctor.id}`),
        },
      ];
    }),
    section: section ? { title: section.data.title, href: pageHref(`pricelist#${section.data.slug}`) } : undefined,
    cms: cmsItem('problems', problem.data.id),
  };
});

/** «от N ₽» у направления в списке на телефоне — по всему разделу прайса */
const fromPrice = new Map(
  (await getCollection('price-list')).map((price) => [
    price.data.slug,
    minPrice(price.data.groups.flatMap((group) => group.items.map((item) => item.price))),
  ]),
);

/* cms — адрес блока в редакторе: в предпросмотре редактора по клику на
   блок открывается его поле (lib/cms-ref, lib/cms-preview). */
const compareItem = (c: (typeof comparison)[number]) => ({
  text: c.data.text,
  cms: cmsItem('comparison', c.data.id),
});
const them = comparison.filter((c) => c.data.side === 'them').map(compareItem);
const us = comparison.filter((c) => c.data.side === 'us').map(compareItem);
const faqItems = faq.map((f) => ({ id: f.data.id, q: f.data.q, a: f.data.a }));

/**
 * Интерьеры клиники для тизера «О клинике».
 * Список собирается на сборке, а не нумеруется от 1 до 8: снимок, удалённый
 * владельцем через редактор, иначе остался бы битой картинкой на главной.
 * import.meta.glob, а не readdirSync от import.meta.url: с Astro 7 модуль
 * страницы при сборке лежит в dist/, и относительный путь до public/
 * промахивался. Пути обычные, как в JSON-контенте: базовый путь подставит
 * сама галерея.
 */
const clinicPhotos = Object.keys(import.meta.glob('/public/images/clinic/*.{jpg,jpeg,png,webp,avif}'))
  .sort()
  .map((file) => file.replace(/^\/public/, ''));
---

<BaseLayout
  title={copy.seo.title}
  description={clampText(copy.seo.description)}
  path="/"
  overHero
  faq={faqItems}
>
  <OceanHero
    eyebrow={copy.hero.eyebrow}
    slogan={copy.hero.title}
    webm={asset('video/ocean-hero.webm')}
    mp4={asset('video/ocean-hero.mp4')}
    poster={asset('video/ocean-hero-poster.jpg')}
  >
    <p class="dc-hero__lead">{copy.hero.lead}</p>
    <div class="dc-hero__actions">
      <Button variant="primary" size="lg" data-open="dc-book">
        <Icon slot="icon" name="calendar" size={20} />
        {copy.hero.book}
      </Button>
      <Button variant="onDark" size="lg" href={clinic.phoneHref}>
        <Icon slot="icon" name="phone" size={20} />
        {copy.hero.call}
      </Button>
    </div>
  </OceanHero>

  <!-- Условия: сразу после hero, до акций -->
  <section id="terms" class="dc-section--tight dc-bg-fade" data-cms={cmsText('terms')}>
    <div class="dc-container">
      <Reveal>
        <OfferStrip items={copy.terms.map((term, i) => ({ ...term, cms: cmsText(`terms.${i}`) }))} />
      </Reveal>
    </div>
  </section>

  <!-- Акции -->
  <section id="promo" class="dc-section dc-bg-white" data-cms={cmsText('promo')}>
    <div class="dc-container">
      <Reveal>
        <PromoBoard
          eyebrow={copy.promo.eyebrow}
          title={copy.promo.title}
          ctaLabel={copy.promo.cta}
          ribbon={copy.promo.ribbon}
          ribbonCms={cmsText('promo.ribbon')}
          items={promos.map((p) => ({
            ...p.data,
            href: p.data.category ? pageHref(`pricelist#${p.data.category}`) : undefined,
            cms: cmsItem('promos', p.data.id),
          }))}
          note={copy.promo.note}
        />
      </Reveal>
    </div>
  </section>

  <!-- Каталог услуг: все направления клиники с ценами -->
  <section id="services" class="dc-section dc-bg-aqua" data-cms={cmsText('services')}>
    <div class="dc-container">
      <Reveal>
        <SectionHeading
          eyebrow={copy.services.eyebrow}
          title={copy.services.title}
          lead={copy.services.lead}
        />
      </Reveal>

      <Reveal>
        <ProblemPicker problems={problemCards} copy={copy.services.problems} />
      </Reveal>

      <div class="dc-dirs">
        <h3 class="dc-dirs__title" data-cms={cmsText('services.directions')}>{copy.services.directions}</h3>

        {/* Телефон и планшет: девять высоких карточек — несколько экранов
            прокрутки, поэтому там направления идут компактным списком. */}
        <ul class="dc-dirlist" role="list">
          {
            categories.map((category) => (
              <li>
                <a href={pageHref(`pricelist#${category.data.slug}`)} class="dc-dir" data-cms={cmsItem('catalog', category.data.id)}>
                  <span class="dc-dir__ico">
                    <Icon name={category.data.icon} size={20} strokeWidth={1.75} color="var(--text-accent)" />
                  </span>
                  <span class="dc-dir__name">{category.data.title}</span>
                  {fromPrice.get(category.data.slug) && <span class="dc-dir__from">{fromPrice.get(category.data.slug)}</span>}
                  <Icon name="chevron-right" size={18} strokeWidth={2} color="var(--text-muted)" />
                </a>
              </li>
            ))
          }
        </ul>

        <div class="dc-catalog-grid">
          {
            categories.map((category, i) => (
              <Reveal delay={i * 70}>
                <ServiceCatalogCard
                  title={category.data.title}
                  description={category.data.description}
                  icon={category.data.icon}
                  items={category.data.items.map((item, j) => {
                    /* Явный слаг из редактора важнее подбора по названию:
                       в каталоге названия короче строк прайса («Проф.
                       гигиена, ультразвук»), и совпадение находилось лишь
                       у половины позиций. */
                    const slug = item.page ?? pageFor(category.data.slug, item.title);
                    return {
                      ...item,
                      href: slug ? pageHref(`uslugi/${slug}`) : undefined,
                      cms: cmsItem('catalog', category.data.id, `items.${j}`),
                    };
                  })}
                  href={pageHref(`pricelist#${category.data.slug}`)}
                  cms={cmsItem('catalog', category.data.id)}
                />
              </Reveal>
            ))
          }
        </div>

        <div class="dc-dirs__all">
          <Button variant="secondary" size="lg" href={pageHref('pricelist')} data-cms={cmsText('services.all')}>
            {copy.services.all}
            <Icon slot="icon-right" name="arrow-right" size={20} />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Полублок-перебивка между каталогом и врачами: поставщики -->
  <section id="brands" class="dc-section--tight dc-bg-fade-aqua" data-cms={cmsText('brands')}>
    <div class="dc-container">
      <Reveal>
        <BrandsMarquee eyebrow={copy.brands.eyebrow} brands={brands.map((b) => b.data)} cms={cmsList('brands')} />
      </Reveal>
    </div>
  </section>

  <!-- Врачи -->
  <section id="doctors" class="dc-section dc-bg-white" data-cms={cmsText('doctors')}>
    <div class="dc-container">
      <Reveal>
        <SectionHeading
          eyebrow={copy.doctors.eyebrow}
          title={copy.doctors.title}
          lead={copy.doctors.lead}
        />
      </Reveal>

      <ul class="dc-doctors" role="list">
        {
          doctors.map((doctor, i) => (
            <Reveal as="li" delay={i * 90}>
              <DoctorFlipCard
                name={doctor.data.name}
                speciality={doctor.data.speciality}
                experience={doctor.data.experience}
                note={doctor.data.note}
                extra={doctor.data.extra}
                photo={doctor.data.photo}
                photoLabel={doctor.data.photoLabel}
                href={pageHref(`doctors/${doctor.id}`)}
                cms={`doctors/${doctor.id}`}
              />
            </Reveal>
          ))
        }
      </ul>

      <Reveal delay={320}>
        <div class="dc-actions">
          <Button variant="secondary" size="lg" href={pageHref('doctors')}>{copy.doctors.cta}</Button>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Почему мы -->
  <section id="why" class="dc-section dc-bg-warm" data-cms={cmsText('why')}>
    <div class="dc-container">
      <Reveal>
        <SectionHeading eyebrow={copy.why.eyebrow} title={copy.why.title} lead={copy.why.lead} />
      </Reveal>
      <Reveal delay={90}>
        <ComparisonColumns
          theirTitle={copy.why.theirTitle}
          ourTitle={copy.why.ourTitle}
          theirItems={them}
          ourItems={us}
        />
      </Reveal>
      <Reveal delay={140}>
        <PriceChart />
      </Reveal>
    </div>
  </section>

  <!-- Полоса доверия: полублок между аргументом о цене и рассказом о клинике -->
  <section id="trust" class="dc-section--tight dc-bg-cool" data-cms={cmsList('trust')}>
    <div class="dc-container">
      <Reveal>
        <TrustBar items={trust.map((t) => t.data)} />
      </Reveal>
    </div>
  </section>

  <!-- О клинике -->
  <section id="about" class="dc-section dc-bg-warm" data-cms={cmsText('about')}>
    <div class="dc-container dc-container--split">
      <Reveal>
        <div class="dc-about">
          <SectionHeading
            eyebrow={copy.about.eyebrow}
            title={copy.about.title}
            lead={copy.about.lead}
          />
          <Badge tone="quiet">{copy.about.badge}</Badge>
          <Button variant="secondary" size="lg" href={pageHref('about')}>{copy.about.cta}</Button>
        </div>
      </Reveal>
      <Reveal delay={120}>
        <PhotoGallery
          photos={clinicPhotos}
          alt="Клиника «Дентал Круиз» изнутри"
          label={copy.about.galleryLabel}
          ratio="4 / 3"
          interval={4000}
          cmsLock="photos"
        />
      </Reveal>
    </div>
  </section>

  <!-- Вопросы -->
  <section id="faq" class="dc-section dc-bg-cool" data-cms={cmsText('faq')}>
    <div class="dc-container dc-container--aside">
      <Reveal>
        <div class="dc-aside-col">
          <SectionHeading
            class="dc-aside-heading"
            eyebrow={copy.faq.eyebrow}
            title={copy.faq.title}
            lead={copy.faq.lead}
          />
          <Button variant="primary" data-open="dc-book">{copy.faq.cta}</Button>
        </div>
      </Reveal>
      <Reveal delay={90}>
        <FaqAccordion items={faqItems.map((item) => ({ ...item, cms: cmsItem('faq', item.id) }))} />
      </Reveal>
    </div>
  </section>

  <!-- Отзывы -->
  <section id="reviews" class="dc-section dc-bg-white" data-cms={cmsText('reviews')}>
    <div class="dc-container">
      <Reveal>
        <SectionHeading eyebrow={copy.reviews.eyebrow} title={copy.reviews.title} />
      </Reveal>

      <div class="dc-two-col">
        <Reveal delay={90}>
          <div class="dc-reviews-col">
            <ReviewsCard />
            {/* Рейтинг и число отзывов здесь не повторяем: они уже в карточке
                выше, а дважды подряд одна цифра читается как шум. Ниже —
                компактная подпись: один факт и заметка про отметку Яндекса. */}
            <div class="dc-facts">
              <p class="dc-facts__fact" data-cms={cmsText('reviews.since')}>
                <span class="dc-facts__value">
                  {/* Счёт с 2000, а не с нуля: год, бегущий от нуля, читается как ошибка */}
                  <CountUp value={copy.reviews.since.value} from={2000} prefix="с " grouping={false} />
                </span>
                <span class="dc-facts__cap">{copy.reviews.since.caption}</span>
              </p>
              <p class="dc-facts__note">
                <Icon name="award" size={22} color="var(--text-accent)" />
                <span>{copy.reviews.note}</span>
              </p>
            </div>
          </div>
        </Reveal>

        <Reveal delay={180}>
          <YandexEmbed
            src={clinic.links.yandexReviewsWidget}
            title="Отзывы о клинике «Дентал Круиз» на Яндекс Картах"
            height={526}
            linkHref={clinic.links.yandexOrg}
            linkLabel={copy.reviews.linkLabel}
            lock="reviews"
          />
        </Reveal>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dc-bg-white {
    background: var(--dc-white);
  }
  .dc-bg-warm {
    background: var(--surface-warm);
  }
  .dc-bg-cool {
    background: var(--surface-cool);
  }
  .dc-bg-aqua {
    background: var(--grad-aqua);
  }
  /* Лента поставщиков: сверху подхватывает холодный тон под hero и
     растворяется в белом к акциям — иначе полоса читалась как чужой
     прямоугольник, вставленный между двумя белыми блоками. */
  .dc-bg-fade {
    background: linear-gradient(180deg, var(--surface-cool) 0%, var(--dc-white) 100%);
  }
  /* Полоса условий: подхватывает мятный низ каталога и уходит в белое
     к врачам — та же логика, что у ленты поставщиков. */
  .dc-bg-fade-aqua {
    background: linear-gradient(180deg, var(--dc-aqua-tint) 0%, var(--dc-white) 100%);
  }
  /* Полублок с рассрочкой и консультацией: --section-y-tight на широких
     экранах разрастается почти до 90px и выглядит непропорционально
     двум невысоким карточкам. На телефоне тот же отступ уже у нижней
     границы clamp и смотрится нормально — трогаем только desktop. */
  @media (min-width: 900px) {
    #terms {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }
  }

  .dc-hero__lead {
    margin: var(--space-8) auto 0;
    max-width: 30ch;
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 2vw, 1.375rem);
    font-weight: var(--fw-medium);
    line-height: var(--lh-body);
    color: #ffffff;
    text-shadow: 0 2px 18px rgba(7, 59, 75, 0.55);
  }
  .dc-hero__actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }

  .dc-container--split {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: center;
  }

  /* Полублок: узкая колонка с заголовком слева, контент справа (ритм «блок — полублок») */
  .dc-container--aside {
    align-items: start;
  }
  @media (min-width: 900px) {
    .dc-container--aside {
      grid-template-columns: minmax(280px, 0.8fr) 1.2fr;
      gap: var(--space-8);
    }
  }
  .dc-aside-col {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    min-width: 0;
  }
  /* В узкой колонке display-размер заголовка не помещается и наезжает на соседей.
     :global целиком — класс приходит из SectionHeading, чужая область видимости. */
  :global(.dc-aside-heading .dc-heading__title) {
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    overflow-wrap: anywhere;
  }
  .dc-about {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    min-width: 0;
  }

  /* Направления под подбором по проблеме */
  .dc-dirs {
    display: grid;
    gap: var(--space-4);
  }
  .dc-dirs__title {
    margin: 0;
    font-size: clamp(1.25rem, 4.4vw, 1.5rem);
    line-height: 1.15;
  }
  .dc-dirlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-sm);
  }
  .dc-dirlist li + li {
    border-top: 1px solid var(--line-hairline);
  }
  .dc-dir {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto 18px;
    align-items: center;
    gap: var(--space-3);
    min-height: 60px;
    padding: var(--space-2) var(--space-4);
    color: var(--text-strong);
    text-decoration: none;
  }
  .dc-dir:hover {
    background: var(--surface-quiet);
  }
  .dc-dir__ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--surface-quiet);
    box-shadow: inset 0 0 0 1px var(--dc-turquoise-soft);
  }
  .dc-dir__name {
    font-weight: var(--fw-semibold);
    line-height: 1.25;
  }
  .dc-dir__from {
    font-size: 13px;
    font-weight: var(--fw-bold);
    color: var(--text-accent);
    white-space: nowrap;
  }
  .dc-dirs__all {
    display: flex;
  }
  .dc-dirs__all :global(.dc-btn) {
    width: 100%;
  }
  @media (min-width: 700px) {
    .dc-dirlist {
      grid-template-columns: 1fr 1fr;
    }
    .dc-dirlist li + li {
      border-top: 0;
    }
    .dc-dirlist li {
      border-bottom: 1px solid var(--line-hairline);
    }
    .dc-dirlist li:nth-child(odd) {
      border-right: 1px solid var(--line-hairline);
    }
    .dc-dirs__all {
      justify-content: center;
    }
    .dc-dirs__all :global(.dc-btn) {
      width: auto;
    }
  }

  /* Карточки направлений — только с компьютера: на узком экране девять
     высоких карточек заняли бы несколько экранов прокрутки. Ряды по три
     (3+3+3), одинаковая высота рядов держит ссылку «Смотреть все услуги»
     на одной линии во всех карточках. */
  .dc-catalog-grid {
    display: none;
  }
  @media (min-width: 1040px) {
