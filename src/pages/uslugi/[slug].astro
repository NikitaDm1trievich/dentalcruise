---
/**
 * Страница одной услуги. Одна вёрстка на все услуги — содержимое приходит
 * из коллекции service-pages, один JSON на услугу.
 *
 * Все блоки, кроме заголовка и лида, необязательные: если в JSON нет
 * `steps` или `faq`, соответствующей секции на странице просто не будет.
 * Шаблон для заполнения — src/content/service-pages/_template.json.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';

import PageLayout from '../../layouts/PageLayout.astro';
import Reveal from '../../components/core/Reveal.astro';
import Button from '../../components/core/Button.astro';
import Icon from '../../components/core/Icon.astro';
import SectionHeading from '../../components/core/SectionHeading.astro';
import ImplantProsthesis from '../../components/content/ImplantProsthesis.astro';
import ImplantVariants from '../../components/content/ImplantVariants.astro';
import PriceTable from '../../components/content/PriceTable.astro';
import FaqAccordion from '../../components/content/FaqAccordion.astro';
import TrustBar from '../../components/content/TrustBar.astro';
import MedicalWarning from '../../components/content/MedicalWarning.astro';
import PhotoPlaceholder from '../../components/media/PhotoPlaceholder.astro';
import { clinic } from '../../data/site';
import { pricesPage, servicePage as copy } from '../../data/pages';
import { pageHref } from '../../lib/asset';
import { cmsItem, cmsList, cmsPage, cmsSite } from '../../lib/cms-ref';
import { fill } from '../../lib/format';
import { absolute, clampText, clinicRef, isFromPrice, priceValue } from '../../lib/seo';

export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await getCollection('service-pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
};

interface Props {
  page: CollectionEntry<'service-pages'>;
}

const { page } = Astro.props as unknown as Props;
const s = page.data;
/* Цена посреди заголовка: «Бесплатно» из прайса — со строчной, суммы как есть */
const titlePrice = s.price ? s.price.charAt(0).toLowerCase() + s.price.slice(1) : '';

const categories = await getCollection('service-categories');
const category = categories.find((c) => c.data.slug === s.category);
const trust = (await getCollection('trust')).sort((a, b) => a.data.order - b.data.order);

/** Другие услуги того же направления — переход между карточками без возврата в прайс */
const siblings = (await getCollection('service-pages'))
  .filter((p) => p.data.category === s.category && p.id !== page.id)
  .sort((a, b) => a.data.order - b.data.order);

const pricelistHref = pageHref('pricelist');

/**
 * Общее описание материала (service-descriptions): один текст на несколько
 * услуг. Ссылка на несуществующий файл — ошибка сборки, а не пустая секция.
 */
const description = s.description ? await getEntry('service-descriptions', s.description) : undefined;
if (s.description && !description) {
  throw new Error(`uslugi/${page.id}: описание «${s.description}» не найдено в src/content/service-descriptions`);
}
const about = description?.data;
const aboutEntry = description && `service-descriptions/${description.id}`;

/** Короткие факты в шапке — показываем только заполненные */
const facts = [
  s.price && { icon: 'wallet', label: copy.facts.price, key: 'price', value: s.price, note: s.priceNote },
  s.duration && { icon: 'clock', label: copy.facts.duration, key: 'duration', value: s.duration },
  s.warranty && { icon: 'shield-check', label: copy.facts.warranty, key: 'warranty', value: s.warranty },
].filter(Boolean) as { icon: string; label: string; key: string; value: string; note?: string }[];

/** Запись этой услуги в редакторе: блоки страницы ведут в её поля */
const entry = `service-pages/${page.id}`;

/** Метки заголовка вопросов — тот же набор уходит в предпросмотр редактора */
const faqVars = { услуга: s.title.toLowerCase() };

/**
 * Карточка услуги для поисковика: тип Service с ценой и исполнителем.
 * Цена в разметке — то, из-за чего сниппет в выдаче показывает сумму:
 * по запросу «винир цена Москва» страница выглядит как ответ, а не как
 * ещё одна ссылка. Исполнитель указан ссылкой на клинику по общему
 * `@id`, а не копией её карточки.
 *
 * Цену отдаём только числом. «от 25 000 ₽» — это нижняя граница, для неё
 * есть отдельная форма PriceSpecification: подать её как точную цену
 * значило бы обещать в выдаче сумму, которой на приёме не будет.
 */
const servicePageUrl = absolute(`uslugi/${page.id}`, Astro.site);
const amount = priceValue(s.price);
const serviceSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${servicePageUrl}#service`,
  name: s.title,
  url: servicePageUrl,
  description: s.lead,
  serviceType: category?.data.title ?? 'Стоматология',
  provider: clinicRef(Astro.site, clinic),
  areaServed: { '@type': 'City', name: clinic.address.locality },
};
if (amount) {
  serviceSchema.offers = {
    '@type': 'Offer',
    url: servicePageUrl,
    priceCurrency: 'RUB',
    availability: 'https://schema.org/InStock',
    ...(isFromPrice(s.price)
      ? {
          priceSpecification: {
            '@type': 'PriceSpecification',
            minPrice: amount,
            priceCurrency: 'RUB',
          },
        }
      : { price: amount }),
  };
}

---

{/*
  Title с ценой и городом: по запросу «коронка цена Москва» сниппет с суммой
  выглядит ответом, а не ещё одной ссылкой. Длинный шаблон «— цена в
  стоматологии …, м. Полежаевская» выдача обрезала.
  Запасные значения через `||`, а не `??`: поля SEO в редакторе — пустые
  строки, а не null, и `??` пропускал их дальше.
*/}
<PageLayout
  title={
    s.seoTitle ||
    (s.price ? `${s.title} — ${titlePrice} | Дентал Круиз, Москва` : `${s.title} | Дентал Круиз, Москва`)
  }
  description={
    s.seoDescription ||
    clampText(
      `${s.title}${s.price ? ` — ${titlePrice}` : ''} в стоматологии «Дентал Круиз», м. Полежаевская. ${s.lead}`,
    )
  }
  path={`/uslugi/${page.id}`}
  eyebrow={category?.data.title ?? copy.category}
  heading={s.title}
  lead={s.lead}
  breadcrumbs={[
    { label: pricesPage.breadcrumb, href: pricelistHref, cms: cmsPage('prices', 'breadcrumb') },
    ...(category
      ? [
          {
            label: category.data.title,
            href: pageHref(`pricelist#${category.data.slug}`),
            cms: cmsItem('catalog', category.data.id, 'title'),
          },
        ]
      : []),
    { label: s.title },
  ]}
  schema={[serviceSchema]}
  faq={s.faq}
  cms={entry}
>
  <div slot="head-extra" class="dc-service__actions">
    <Button variant="primary" size="md" data-open="dc-book" data-cms={cmsPage('service-page', 'book')}>
      <Icon slot="icon" name="calendar" size={20} />
      {copy.book}
    </Button>
    <Button variant="secondary" size="md" href={clinic.phoneHref} data-cms={cmsSite('clinic', 'phone')}>
      <Icon slot="icon" name="phone" size={20} />
      {clinic.phone}
    </Button>
  </div>

  {/* Операция и протез отдельно, переключатель 4 / 6 имплантов — только у страниц с полем implantVariants */}
  {
    s.implantVariants && (
      <section class="dc-section dc-bg-warm" data-cms={entry}>
        <div class="dc-container">
          <Reveal>
            <ImplantVariants active={s.implantVariants} category={s.category} />
          </Reveal>
        </div>
      </section>
    )
  }

  {/* Варианты протезов с ценами из прайса — на тех же страницах; на этот блок ссылается карусель выше */}
  {
    s.implantVariants && (
      <section id="implant-prosthesis" class="dc-section dc-bg-white dc-service__anchor" data-cms={entry}>
        <div class="dc-container">
          <Reveal>
            <ImplantProsthesis active={s.implantVariants} category={s.category} />
          </Reveal>
        </div>
      </section>
    )
  }

  {/*
    Цена и предупреждение о противопоказаниях (ч. 7 ст. 24 38-ФЗ) — рядом,
    один раз на странице. Секция есть всегда: предупреждение нужно и
    услуге без заполненных фактов.
  */}
  <section class="dc-section--tight dc-bg-white" data-cms={entry}>
    <div class="dc-container">
      {
        facts.length > 0 && (
          <Reveal>
            <ul class="dc-facts-row" role="list">
              {facts.map((fact) => (
                <li>
                  <span class="dc-facts-row__icon">
                    <Icon name={fact.icon} size={22} strokeWidth={1.9} color="var(--text-accent)" />
                  </span>
                  <span class="dc-facts-row__body">
                    <span class="dc-facts-row__label" data-cms={cmsPage('service-page', `facts.${fact.key}`)}>
                      {fact.label}
                    </span>
                    <span class="dc-facts-row__value">{fact.value}</span>
                    {fact.note && <span class="dc-facts-row__note">{fact.note}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </Reveal>
        )
      }
      <Reveal>
        <MedicalWarning />
      </Reveal>
    </div>
  </section>

  {
    (s.includes.length > 0 || s.indications.length > 0) && (
      <section class="dc-section dc-bg-white" data-cms={entry}>
        <div class="dc-container dc-two-col">
          {s.includes.length > 0 && (
            <Reveal>
              <div class="dc-panel" data-cms={`${entry}:includes`}>
                <h2 data-cms={cmsPage('service-page', 'includes')}>{copy.includes}</h2>
                <ul class="dc-checklist" role="list">
                  {s.includes.map((item) => (
                    <li>
                      <Icon name="check" size={18} strokeWidth={2.6} color="var(--text-accent)" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </Reveal>
          )}

          {s.indications.length > 0 && (
            <Reveal delay={90}>
              <div class="dc-panel dc-panel--quiet" data-cms={`${entry}:indications`}>
                <h2 data-cms={cmsPage('service-page', 'indications')}>{copy.indications}</h2>
                <ul class="dc-checklist" role="list">
                  {s.indications.map((item) => (
                    <li>
                      <Icon name="check" size={18} strokeWidth={2.6} color="var(--text-accent)" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </Reveal>
          )}
        </div>
      </section>
    )
  }

  {
    s.steps.length > 0 && (
      <section class="dc-section dc-bg-warm" data-cms={`${entry}:steps`}>
        <div class="dc-container">
          <Reveal>
            <SectionHeading
              eyebrow={copy.steps.eyebrow}
              title={copy.steps.title}
              cms={cmsPage('service-page', 'steps')}
            />
          </Reveal>
          <ol class="dc-steps" role="list">
            {s.steps.map((step, i) => (
              <Reveal as="li" delay={i * 70}>
                <div class="dc-step" data-cms={`${entry}:steps.${i}`}>
                  <span class="dc-step__num">{i + 1}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </Reveal>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {/*
    Описание материала — после этапов: сначала что и как делают, затем
    подробно о самом материале, потом цены. Разделы в <details>: на телефоне
    свёрнуты (страница и так длинная), на ПК их раскрывает скрипт ниже до
    первой отрисовки. Текст в HTML в любом случае — поисковик его видит.
  */}
  {
    about && (
      <section class="dc-section dc-bg-cool" data-cms={aboutEntry}>
        <div class="dc-container dc-container--aside">
          <Reveal class="dc-about__aside">
            <SectionHeading class="dc-aside-heading" title={about.title} cms={`${aboutEntry}:title`} />
          </Reveal>
          <div class="dc-about">
            {about.intro.length > 0 && (
              <Reveal delay={90}>
                <div class="dc-about__intro" data-cms={`${aboutEntry}:intro`}>
                  {about.intro.map((text) => (
                    <p>{text}</p>
                  ))}
                </div>
              </Reveal>
            )}

            {about.benefits.length > 0 && (
              <Reveal delay={90}>
                <div class="dc-about__benefits" data-cms={`${aboutEntry}:benefits`}>
                  {about.benefitsTitle && (
                    <h3 class="dc-about__subtitle" data-cms={`${aboutEntry}:benefitsTitle`}>
                      {about.benefitsTitle}
                    </h3>
                  )}
                  <ul class="dc-about__grid" role="list">
                    {about.benefits.map((benefit, i) => (
                      <li class="dc-about__card" data-cms={`${aboutEntry}:benefits.${i}`}>
                        <span class="dc-facts-row__icon">
                          <Icon name={benefit.icon} size={22} strokeWidth={1.9} color="var(--text-accent)" />
                        </span>
                        <h4>{benefit.title}</h4>
                        <p>{(s.descriptionLayered && benefit.layeredText) || benefit.text}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              </Reveal>
            )}

            {about.sections.length > 0 && (
              <details class="dc-about__more" data-about-more>
                <summary class="dc-about__toggle" data-cms={cmsPage('service-page', 'about')}>
                  <span class="dc-about__toggle-more">{copy.about.more}</span>
                  <span class="dc-about__toggle-less">{copy.about.less}</span>
                  <Icon name="chevron-down" size={18} />
                </summary>
                <div class="dc-about__sections">
                  {about.sections.map((section, i) => (
                    <div
                      class:list={[
                        'dc-about__section',
                        section.sub && 'dc-about__section--sub',
                        !section.title && i > 0 && 'dc-about__section--cont',
                      ]}
                      data-cms={`${aboutEntry}:sections.${i}`}
                    >
                      {section.title &&
                        (section.sub ? (
                          <h4 class="dc-about__minor">{section.title}</h4>
                        ) : (
                          <h3 class="dc-about__subtitle">{section.title}</h3>
                        ))}
                      {section.paragraphs.map((text) => (
                        <p>{text}</p>
                      ))}
                      {section.items.length > 0 && (
                        <ul class="dc-about__list">
                          {section.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      )}
                      {section.afterItems.map((text) => (
                        <p>{text}</p>
                      ))}
                    </div>
                  ))}
                </div>
              </details>
            )}

          </div>
        </div>
      </section>
    )
  }
  {
    about && (
      <script is:inline>
        if (window.matchMedia('(min-width: 900px)').matches) {
          document.querySelectorAll('[data-about-more]').forEach(function (d) {
            d.open = true;
          });
        }
      </script>
    )
  }

  {
    s.prices.length > 0 && (
      <section class="dc-section dc-bg-white" data-cms={`${entry}:prices`}>
        <div class="dc-container dc-container--aside">
          <Reveal>
            <div class="dc-aside-col" data-cms={cmsPage('service-page', 'prices')}>
              <SectionHeading
                class="dc-aside-heading"
                eyebrow={copy.prices.eyebrow}
                title={copy.prices.title}
                lead={copy.prices.lead}
              />
              <Button variant="secondary" href={pageHref(`pricelist#${s.category}`)}>
                {copy.prices.all}
              </Button>
            </div>
          </Reveal>
          <Reveal delay={90}>
            <div class="dc-panel">
              <PriceTable items={s.prices} />
            </div>
          </Reveal>
        </div>
      </section>
    )
  }

  <section class="dc-section dc-bg-aqua" data-cms={entry}>
    <div class="dc-container dc-two-col">
      <Reveal>
        <PhotoPlaceholder label={s.photoLabel} src={s.photo} alt={s.title} ratio="4 / 3" />
      </Reveal>
      <Reveal delay={90}>
        <div class="dc-panel" data-cms={cmsPage('service-page', 'why')}>
          <h2>{copy.why.title}</h2>
          <p>{copy.why.text}</p>
          <div class="dc-actions">
            <Button variant="primary" size="md" data-open="dc-book">{copy.why.book}</Button>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  {
    s.faq.length > 0 && (
      <section class="dc-section dc-bg-cool" data-cms={`${entry}:faq`}>
        <div class="dc-container dc-container--aside">
          <Reveal>
            <SectionHeading
              class="dc-aside-heading"
              eyebrow={copy.faq.eyebrow}
              title={fill(copy.faq.title, faqVars)}
              titleCms={cmsPage('service-page', 'faq.title')}
              titleVars={faqVars}
              lead={copy.faq.lead}
              cms={cmsPage('service-page', 'faq')}
            />
          </Reveal>
          <Reveal delay={90}>
            <FaqAccordion
              items={s.faq.map((item, i) => ({ id: `svc-${i}`, q: item.q, a: item.a, cms: `${entry}:faq.${i}` }))}
            />
          </Reveal>
        </div>
      </section>
    )
  }

  {
    (siblings.length > 0 || category) && (
      <section class="dc-section dc-bg-warm">
        <div class="dc-container">
          <Reveal>
            <div class="dc-related__head" data-cms={cmsPage('service-page', 'related')}>
              <SectionHeading
                eyebrow={category?.data.title ?? copy.category}
                title={copy.related.title}
              />
              {category && (
                <Button variant="secondary" href={pageHref(`pricelist#${category.data.slug}`)}>
                  {copy.related.all}
                  <Icon slot="icon" name="arrow-right" size={18} />
                </Button>
              )}
            </div>
          </Reveal>

          {siblings.length > 0 && (
            <ul class="dc-related__grid" role="list">
              {siblings.slice(0, 8).map((sibling, i) => (
                <Reveal as="li" delay={i * 50}>
                  <a
                    href={pageHref(`uslugi/${sibling.id}`)}
                    class="dc-related__card"
                    data-cms={`service-pages/${sibling.id}`}
                  >
                    <span class="dc-related__title">{sibling.data.title}</span>
                    {sibling.data.price && <span class="dc-related__price">{sibling.data.price}</span>}
                  </a>
                </Reveal>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }

  <section class="dc-section--tight dc-bg-white" data-cms={cmsList('trust')}>
    <div class="dc-container">
      <Reveal>
        <TrustBar items={trust.map((t) => t.data)} />
      </Reveal>
    </div>
  </section>
</PageLayout>

<style>
  /*
   * Плотный ритм только для страниц услуг: правила scoped, поэтому
   * общие .dc-section и .dc-container на главной, «О клинике» и «Врачах»
   * не меняются. Соседние белые секции (факты → «Что входит») не
   * складывают отступы: у второй верхний снимаем, хватает нижнего у первой.
   */
  .dc-section {
    padding-block: var(--section-y-compact);
  }
  .dc-section--tight {
    padding-block: var(--section-y-compact-tight);
  }
  .dc-bg-white + .dc-bg-white {
    padding-top: 0;
  }
  .dc-container {
    gap: var(--space-6);
  }

  .dc-service__anchor {
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }

  .dc-service__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .dc-facts-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .dc-facts-row li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-sm);
  }
  .dc-facts-row__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--surface-quiet);
    box-shadow: inset 0 0 0 1px var(--dc-turquoise-soft);
  }
  .dc-facts-row__body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .dc-facts-row__label {
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .dc-facts-row__value {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    font-weight: var(--fw-black);
    color: var(--text-strong);
  }
  .dc-facts-row__note {
    font-size: var(--type-small);
    color: var(--text-muted);
  }

  .dc-panel {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: clamp(var(--space-6), 3vw, var(--space-8));
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-sm);
    height: 100%;
  }
  .dc-panel--quiet {
    background: var(--surface-quiet);
  }
  .dc-panel h2 {
    font-size: var(--type-h3);
  }
  .dc-panel p {
    color: var(--text-body);
    max-width: min(var(--measure), 100%);
  }

  .dc-checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .dc-checklist li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--text-body);
  }
  .dc-checklist :global(svg) {
    flex: 0 0 auto;
    margin-top: 3px;
