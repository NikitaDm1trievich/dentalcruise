---
/**
 * Каркас наполненной внутренней страницы: шапка с крошками и заголовком,
 * дальше — произвольные секции через слот.
 *
 * Отличие от StubLayout: тот честно говорит «раздел готовится» и уводит
 * в телефон, этот — для страниц, где контент есть.
 */
import BaseLayout from './BaseLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Icon from '../components/core/Icon.astro';
import { withBase } from '../lib/asset';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow?: string;
  heading: string;
  lead?: string;
  /** Хлебные крошки без «Главная» — она добавляется сама */
  breadcrumbs?: { label: string; href?: string }[];
  noindex?: boolean;
  hideContactsCta?: boolean;
}

const {
  title,
  description,
  path,
  eyebrow,
  heading,
  lead,
  breadcrumbs = [],
  noindex = false,
  hideContactsCta = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  hideContactsCta={hideContactsCta}
>
  <header class="dc-page__top">
    <div class="dc-page__inner">
      <nav class="dc-crumbs" aria-label="Хлебные крошки">
        <a href={withBase('')}>Главная</a>
        {
          breadcrumbs.map((crumb) => (
            <>
              <Icon name="chevron-right" size={14} />
              {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
            </>
          ))
        }
      </nav>

      <Reveal>
        <div class="dc-page__head">
          {eyebrow && <span class="dc-page__eyebrow">{eyebrow}</span>}
          <h1 class="dc-page__title">{heading}</h1>
          {lead && <p class="dc-page__lead">{lead}</p>}
          <slot name="head-extra" />
        </div>
      </Reveal>
    </div>
  </header>

  <slot />
</BaseLayout>

<style>
  .dc-page__top {
    padding: calc(var(--header-h) + var(--space-10)) var(--gutter) var(--space-10);
    background: var(--grad-aqua);
  }
  .dc-page__inner {
    max-width: var(--container);
    margin-inline: auto;
    display: grid;
    gap: var(--space-6);
  }

  .dc-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .dc-crumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .dc-crumbs a:hover {
    color: var(--text-accent);
  }

  .dc-page__head {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .dc-page__eyebrow {
    font-family: var(--font-body);
    font-size: var(--type-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-muted);
  }
  .dc-page__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: var(--fw-black);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
    margin: 0;
  }
  .dc-page__lead {
    font-size: var(--type-lead);
    line-height: var(--lh-body);
    color: var(--text-body);
    max-width: min(var(--measure), 100%);
  }
</style>
