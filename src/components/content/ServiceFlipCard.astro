---
/**
 * Карточка услуги с переворотом. Портировано из Ds2_2d9e23.ServiceFlipCard
 * (в основе — «Card Flip» Kokonut UI, MIT; классы Tailwind заменены токенами).
 *
 * ПК — переворот по наведению, тач — по нажатию (там :hover не работает).
 */
import Icon from '../core/Icon.astro';
import Badge from '../core/Badge.astro';
import PhotoPlaceholder from '../media/PhotoPlaceholder.astro';

interface Props {
  title: string;
  price: string;
  priceNote?: string;
  benefit: string;
  features?: string[];
  photo?: string;
  photoLabel: string;
  badge?: string;
  href?: string;
  cta?: string;
  height?: number;
}

const {
  title,
  price,
  priceNote,
  benefit,
  features = [],
  photo,
  photoLabel,
  badge,
  href = '#gallery',
  cta = 'Смотреть работы',
  height = 440,
} = Astro.props;
---

<div class="dc-flip" style={`--dc-flip-h:${height}px`} data-flip>
  <button
    type="button"
    class="dc-flip__toggle"
    aria-label={`${title} — показать подробности`}
    data-flip-toggle></button>

  <div class="dc-flip__inner" data-flip-inner>
    <article class="dc-flip__face dc-flip__face--front">
      <div class="dc-flip__photo">
        <PhotoPlaceholder label={photoLabel} src={photo} alt={title} ratio="4 / 3" radius="0" cover />
        {badge && <Badge tone="promo" class="dc-flip__badge">{badge}</Badge>}
      </div>
      <div class="dc-flip__body">
        <h3>{title}</h3>
        <span class="dc-flip__price">{price}</span>
        {priceNote && <span class="dc-flip__pricenote">{priceNote}</span>}
        <span class="dc-flip__hint">
          <Icon name="repeat-2" size={16} />
          {/* На тач-экранах наводить нечем — подсказка меняется по типу указателя */}
          <span class="dc-flip__hint--hover">Подробнее — наведите</span>
          <span class="dc-flip__hint--tap">Подробнее — нажмите</span>
        </span>
      </div>
    </article>

    <div class="dc-flip__face dc-flip__face--back">
      <div class="dc-flip__backhead">
        <h3>{title}</h3>
        <p>{benefit}</p>
      </div>
      <ul class="dc-flip__features">
        {
          features.map((feature, i) => (
            <li style={`--dc-flip-delay:${i * 50 + 150}ms`}>
              <Icon name="check" size={16} strokeWidth={2.6} color="var(--text-accent)" />
              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
      <a href={href} class="dc-flip__cta">
        {cta}
        <Icon name="arrow-right" size={20} />
      </a>
    </div>
  </div>
</div>

<style>
  .dc-flip {
    position: relative;
    height: var(--dc-flip-h);
    min-width: 0;
  }
  /* Перспектива и preserve-3d включаются только на время переворота
     (класс ставит src/lib/flip.ts): постоянный 3D-контекст уводит карточку
     на отдельный слой композитора и размывает текст лицевой стороны. */
  .dc-flip.is-3d {
    perspective: 2000px;
  }
  /* Кнопка-подложка: переворот доступен и с клавиатуры, и на тач-экране */
  .dc-flip__toggle {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: transparent;
    border: 0;
    border-radius: var(--radius-lg);
    cursor: pointer;
  }
  .dc-flip[data-flipped='true'] .dc-flip__toggle {
    /* Перевёрнутая карточка отдаёт клики ссылке «Смотреть работы» */
    inset: 0 0 var(--tap-min) 0;
  }

  .dc-flip__inner {
    position: relative;
    height: 100%;
    width: 100%;
    transform-style: flat;
    transition: transform 560ms cubic-bezier(0.77, 0, 0.175, 1);
  }
  .dc-flip.is-3d .dc-flip__inner {
    transform-style: preserve-3d;
  }
  .dc-flip[data-flipped='true'] .dc-flip__inner {
    transform: rotateY(180deg);
  }

  .dc-flip__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--dur-mid) var(--ease-out);
  }
  .dc-flip[data-flipped='true'] .dc-flip__face {
    box-shadow: var(--shadow-lg);
  }

  .dc-flip__face--front {
    transform: rotateY(0deg);
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .dc-flip__photo {
    position: relative;
    overflow: hidden;
  }
  /* :global — класс уезжает в дочерний компонент Badge, у него своя область видимости стилей */
  .dc-flip__photo :global(.dc-flip__badge) {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 1;
  }
  .dc-flip__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }
  .dc-flip__body h3 {
    font-size: var(--type-h3);

    letter-spacing: var(--ls-display);
  }
  .dc-flip__price {
    font-family: var(--font-display);
    font-size: var(--type-price);
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    line-height: 1.05;
  }
  .dc-flip__pricenote {
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .dc-flip__hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-2);
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    color: var(--text-accent);
  }
  .dc-flip__hint--hover {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .dc-flip__hint--hover {
      display: inline;
    }
    .dc-flip__hint--tap {
      display: none;
    }
  }

  .dc-flip__face--back {
    /* Без 3D-контекста backface-visibility не работает — прячем изнанку явно */
    visibility: hidden;
    transform: rotateY(180deg);
    background: var(--grad-aqua);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-4);
    padding: var(--space-6);
  }
  .dc-flip.is-3d .dc-flip__face--back {
    visibility: visible;
  }
  .dc-flip__backhead {
    display: grid;
    gap: var(--space-2);
  }
  .dc-flip__backhead h3 {
    font-size: var(--type-h3);

    letter-spacing: var(--ls-display);
  }
  .dc-flip__backhead p {
    color: var(--text-body);
    font-size: var(--type-small);
  }

  .dc-flip__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .dc-flip__features li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--type-small);
    color: var(--text-body);
    opacity: 0;
    transform: translateX(-10px);
    transition:
      transform var(--dur-mid) var(--ease-out) var(--dc-flip-delay),
      opacity var(--dur-mid) var(--ease-out) var(--dc-flip-delay);
  }
  .dc-flip[data-flipped='true'] .dc-flip__features li {
    opacity: 1;
    transform: translateX(0);
  }
  .dc-flip__features :global(.dc-icon) {
    margin-top: 3px;
  }

  .dc-flip__cta {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tap-min);
    padding: 0 var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--cta-bg);
    color: var(--cta-fg);
    font-weight: var(--fw-bold);
    text-decoration: none;
  }
  .dc-flip__cta:hover {
    background: var(--cta-bg-hover);
    color: var(--cta-fg);
  }
</style>
