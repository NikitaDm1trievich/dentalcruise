---
/**
 * Список врачей. Карточки (components/content/DoctorList и DoctorCard) ведут на
 * персональную страницу /doctors/<файл>, которую собирает
 * src/pages/doctors/[slug].astro из того же JSON.
 */
import { getCollection } from 'astro:content';

import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Button from '../components/core/Button.astro';
import Icon from '../components/core/Icon.astro';
import DoctorList from '../components/content/DoctorList.astro';
import TrustBar from '../components/content/TrustBar.astro';
import { clinic } from '../data/site';
import { teamPage as page } from '../data/pages';
import { cmsList, cmsPage, cmsSite } from '../lib/cms-ref';

type Ordered = { data: { order: number } };
const byOrder = (a: Ordered, b: Ordered) => a.data.order - b.data.order;

const doctors = (await getCollection('doctors')).sort(byOrder);
const trust = (await getCollection('trust')).sort(byOrder);

/**
 * Заголовок и описание собираем из самой коллекции. Раньше они были вписаны
 * руками и отстали от жизни: обещали зубного техника и керамиста, которых
 * владелец уже удалил, и стаж, которого ни у кого нет. Список врачей
 * меняется через редактор, поэтому и текст должен считаться из данных.
 * Владелец может задать их сам в «Страницы сайта» → «Врачи — страница
 * списка»; пустые поля — собираем, как раньше.
 */
const specialities = [...new Set(doctors.map((d) => d.data.speciality.toLowerCase().split(/,\s*/)).flat())];
const names = doctors.map((d) => d.data.name).join(', ');
---

<PageLayout
  title={page.seo.title || `Врачи стоматологии «${clinic.name}» — ${specialities.join(', ')}`}
  description={
    page.seo.description ||
    `Команда клиники «${clinic.name}»: ${names}. Своя зуботехническая лаборатория, ${clinic.address.locality}, ${clinic.address.streetShort}.`
  }
  path="/doctors"
  eyebrow={page.eyebrow}
  heading={page.heading}
  lead={page.lead}
  breadcrumbs={[{ label: page.breadcrumb }]}
  cms={cmsPage('team')}
>
  <section class="dc-section dc-bg-white">
    <div class="dc-container">
      <DoctorList doctors={doctors} />

      <Reveal delay={320}>
        <div class="dc-actions">
          <Button variant="primary" size="md" data-open="dc-book" data-cms={cmsPage('team', 'book')}>
            <Icon slot="icon" name="calendar" size={20} />
            {page.book}
          </Button>
          <Button variant="secondary" size="md" href={clinic.phoneHref} data-cms={cmsSite('clinic', 'phone')}>
            <Icon slot="icon" name="phone" size={20} />
            {clinic.phone}
          </Button>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="dc-section--tight dc-bg-cool" data-cms={cmsList('trust')}>
    <div class="dc-container">
      <Reveal>
        <TrustBar items={trust.map((t) => t.data)} />
      </Reveal>
    </div>
  </section>
</PageLayout>

<style>
  .dc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .dc-bg-white {
    background: var(--dc-white);
  }
  .dc-bg-cool {
    background: var(--surface-cool);
  }
</style>
