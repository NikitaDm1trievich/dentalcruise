---
/**
 * Шторка с лицензией — снизу вверх. Открывается из полосы доверия.
 * Перенесено из собственного компонента LicenseDrawer.dc.html.
 */
import Icon from '../core/Icon.astro';
import Button from '../core/Button.astro';
import PhotoPlaceholder from '../media/PhotoPlaceholder.astro';
import { clinic } from '../../data/site';
---

<div class="dc-drawer" id="dc-license" data-state="closed" aria-hidden="true">
  <div class="dc-drawer__scrim" data-close></div>

  <section
    class="dc-drawer__sheet"
    role="dialog"
    aria-modal="true"
    aria-labelledby="dc-license-title"
  >
    <div aria-hidden="true" class="dc-drawer__grip"></div>

    <div class="dc-drawer__head">
      <div class="dc-drawer__title-row">
        <span class="dc-drawer__mark">
          <Icon name="shield-check" size={24} color="var(--text-accent)" />
        </span>
        <h2 id="dc-license-title">Лицензия</h2>
      </div>
      <p>
        {clinic.license.title} выдана на клинику «{clinic.name}», {clinic.address.locality},
        {clinic.address.streetShort}. Документ можно посмотреть здесь или запросить в клинике.
      </p>
    </div>

    <PhotoPlaceholder
      label="Здесь скан лицензии на медицинскую деятельность"
      src={clinic.license.scan || undefined}
      alt={clinic.license.title}
      ratio="3 / 4"
    />

    <div class="dc-drawer__actions">
      {
        clinic.license.pdf && (
          <Button variant="primary" size="lg" fullWidth href={clinic.license.pdf} target="_blank" rel="noopener">
            Открыть документ
          </Button>
        )
      }
      <Button variant="secondary" size="lg" fullWidth data-close>Закрыть</Button>
    </div>
  </section>
</div>

<style>
  .dc-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
  }
  .dc-drawer[data-state='open'] {
    pointer-events: auto;
  }
  .dc-drawer__scrim {
    position: absolute;
    inset: 0;
    background: rgba(7, 59, 75, 0.42);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out);
  }
  .dc-drawer[data-state='open'] .dc-drawer__scrim {
    opacity: 1;
  }

  .dc-drawer__sheet {
    position: relative;
    width: min(520px, 100%);
    max-height: 92svh;
    overflow-y: auto;
    background: var(--surface-page);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    box-shadow: var(--shadow-lg);
    padding: var(--space-6) var(--space-6) var(--space-8);
    display: grid;
    gap: var(--space-6);
    transform: translateY(100%);
    transition: transform 420ms var(--ease-out);
  }
  .dc-drawer[data-state='open'] .dc-drawer__sheet {
    transform: translateY(0);
  }

  .dc-drawer__grip {
    width: 56px;
    height: 5px;
    border-radius: var(--radius-pill);
    background: var(--dc-sea-glass);
    justify-self: center;
  }

  .dc-drawer__head,
  .dc-drawer__actions {
    display: grid;
    gap: var(--space-3);
    opacity: 0;
    transform: translateY(20px);
    transition:
      transform 420ms var(--ease-out) 80ms,
      opacity 420ms var(--ease-out) 80ms;
  }
  .dc-drawer__actions {
    transition-delay: 220ms;
  }
  .dc-drawer[data-state='open'] .dc-drawer__head,
  .dc-drawer[data-state='open'] .dc-drawer__actions {
    opacity: 1;
    transform: translateY(0);
  }

  .dc-drawer__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .dc-drawer__mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--surface-quiet);
  }
  .dc-drawer__head h2 {
    font-size: var(--type-h3);

    letter-spacing: var(--ls-display);
    margin: 0;
  }
  .dc-drawer__head p {
    color: var(--text-body);
    font-size: var(--type-body);
  }
</style>
