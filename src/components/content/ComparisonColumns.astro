---
/**
 * «Обычная клиника» vs «Дентал Круиз». Из Ds2_2d9e23.ComparisonColumns.
 * Заголовки колонок на главной приходят из редактора («8. Почему мы»).
 *
 * Пары стоят по строкам друг напротив друга: N-й пункт левой колонки
 * против N-го правой (обе отсортированы по «Порядку в колонке»). Так блок
 * и на телефоне остаётся в две колонки и помещается в один экран.
 * Настоящая <table>: скринридер читает строку парой с заголовками колонок.
 * Наша колонка — одна карточка в бирюзовой рамке за ячейками.
 */

interface Props {
  theirTitle?: string;
  ourTitle?: string;
  /** cms — адрес пункта в редакторе для выбора блока в предпросмотре (lib/cms-ref) */
  theirItems: { text: string; cms?: string }[];
  ourItems: { text: string; cms?: string }[];
}

const {
  theirTitle = 'Обычная клиника',
  ourTitle = 'Дентал Круиз',
  theirItems,
  ourItems,
} = Astro.props;

/* Пунктов в колонках может оказаться не поровну — лишним достаётся пустая
   соседняя ячейка. */
const rows = Array.from({ length: Math.max(theirItems.length, ourItems.length) }, (_, i) => ({
  them: theirItems[i],
  us: ourItems[i],
}));
---

<div class="dc-compare">
  <div class="dc-compare__ours" aria-hidden="true"></div>
  <table class="dc-compare__table">
    <caption class="dc-compare__caption">{theirTitle} и {ourTitle}</caption>
    <thead>
      <tr>
        <th scope="col">{theirTitle}</th>
        <th scope="col" class="dc-compare__head-ours">{ourTitle}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td class="dc-compare__them" data-cms={row.them?.cms}>
              {row.them?.text}
            </td>
            <td class="dc-compare__us" data-cms={row.us?.cms}>
              {row.us?.text}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .dc-compare {
    /* половина промежутка между колонками: слева от рамки и внутри неё */
    --dc-compare-half-gap: var(--space-1);
    position: relative;
    min-width: 0;
  }
  .dc-compare__ours {
    position: absolute;
    inset: 0 0 0 calc(50% + var(--dc-compare-half-gap));
    border: 2px solid var(--dc-turquoise);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-lg);
  }
  .dc-compare__table {
    /* поверх рамки: иначе её фон закроет текст правой колонки */
    position: relative;
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }
  .dc-compare__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .dc-compare__table th,
  .dc-compare__table td {
    width: 50%;
    padding: 10px var(--space-3);
    text-align: left;
    vertical-align: top;
    font-size: var(--type-small);
    line-height: 1.35;
  }
  .dc-compare__table th:first-child,
  .dc-compare__table td:first-child {
    padding-right: calc(var(--space-3) + var(--dc-compare-half-gap));
  }
  .dc-compare__table th:last-child,
  .dc-compare__table td:last-child {
    padding-left: calc(var(--space-3) + var(--dc-compare-half-gap));
  }
  .dc-compare__table th {
    padding-top: var(--space-3);
    padding-bottom: var(--space-1);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    color: var(--text-muted);
  }
  .dc-compare__table .dc-compare__head-ours {
    color: var(--text-accent);
  }
  .dc-compare__table td {
    hyphens: auto;
    /* переносим только длинные слова: «бы-стрые» в узкой колонке читается хуже;
       хвост от 3 букв — иначе «стоматологические» рвалась без дефиса */
    hyphenate-limit-chars: 12 5 3;
    overflow-wrap: anywhere;
  }
  .dc-compare__table tbody tr + tr td {
    border-top: 1px solid var(--line-hairline);
  }
  .dc-compare__table tbody tr:last-child td {
    padding-bottom: var(--space-3);
  }
  .dc-compare__them {
    color: var(--text-muted);
  }
  .dc-compare__us {
    color: var(--text-strong);
    font-weight: var(--fw-semibold);
  }
  @media (min-width: 900px) {
    .dc-compare__table th,
    .dc-compare__table td {
      padding: var(--space-4) var(--space-6);
      font-size: var(--type-body);
    }
    .dc-compare__table th:first-child,
    .dc-compare__table td:first-child {
      padding-right: calc(var(--space-6) + var(--dc-compare-half-gap));
    }
    .dc-compare__table th:last-child,
    .dc-compare__table td:last-child {
      padding-left: calc(var(--space-6) + var(--dc-compare-half-gap));
    }
    .dc-compare__table th {
      padding-top: var(--space-5);
      padding-bottom: var(--space-2);
      font-size: var(--type-h4);
    }
  }
</style>
