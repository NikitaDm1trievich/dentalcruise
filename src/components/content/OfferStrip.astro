---
/**
 * Полублок-перебивка между крупными секциями — та же роль, что у ленты
 * поставщиков: невысокая полоса, которая даёт странице «выдохнуть» между
 * двумя большими блоками. Не секция с заголовком: только короткие факты.
 *
 * Сетка и подача карточек — по мотивам kokonut ui (spotlight cards):
 * белая карточка на тонированном фоне секции, иконка в бейдже с
 * внутренней обводкой, мягкий радиальный подсвет в углу, соседи гаснут
 * при наведении. Цвет один, фирменный: радуги из оригинала не берём.
 */
import Icon from '../core/Icon.astro';

interface Props {
  items: { icon: string; title: string; text: string }[];
}

const { items } = Astro.props;
---

<ul class="dc-strip" role="list">
  {
    items.map((item) => (
      <li class="dc-strip__card">
        <span class="dc-strip__icon">
          <Icon name={item.icon} size={22} strokeWidth={1.9} color="var(--text-accent)" />
        </span>
        <span class="dc-strip__body">
          <span class="dc-strip__title">{item.title}</span>
          <span class="dc-strip__text">{item.text}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .dc-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .dc-strip {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    }
  }

  .dc-strip__card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-sm);
    /* Появление по очереди после того, как проявилась сама полоса.
       Свой `.dc-reveal` тут не поставить — он на родителе. */
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
  }
  .dc-strip__card:nth-child(2) {
    transition-delay: 110ms;
  }
  :global(.dc-reveal.is-visible) .dc-strip__card,
  :global(.no-js) .dc-strip__card {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-strip__card {
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
  }
  /* Мягкий фирменный подсвет в углу — вместо цветного градиента оригинала */
  .dc-strip__card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 12% 0%, var(--dc-turquoise-soft), transparent 62%);
    opacity: 0.5;
  }

  .dc-strip__icon {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--surface-quiet);
    box-shadow: inset 0 0 0 1px var(--dc-turquoise-soft);
  }
  .dc-strip__body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .dc-strip__title {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    font-weight: var(--fw-black);
    color: var(--text-strong);
  }
  .dc-strip__text {
    font-size: var(--type-small);
    color: var(--text-muted);
    max-width: min(var(--measure), 100%);
  }
</style>
