---
/**
 * Подвал: лого + соцсети, карта сайта, информация, контакты, копирайт.
 * Перенесено из Ds2_2d9e23.Footer.
 */
import BrandIcon from '../core/BrandIcon.astro';
import MetroStations from '../core/MetroStations.astro';
import LicenseLine from '../content/LicenseLine.astro';
import { clinic, menu } from '../../data/site';
import { blocks } from '../../data/ui';
import { pageHref, withBase } from '../../lib/asset';
import { cmsSite } from '../../lib/cms-ref';

const year = new Date().getFullYear();
const { footer } = menu;
const { license, legal } = clinic;

/* Реквизиты юрлица мелкой строкой. Пустое поле не выводится. */
const requisites = [
  { text: legal.orgName, cms: 'legal.orgName' },
  { text: legal.inn && `ИНН ${legal.inn}`, cms: 'legal.inn' },
  { text: legal.ogrn && `ОГРН ${legal.ogrn}`, cms: 'legal.ogrn' },
].filter((item): item is { text: string; cms: string } => !!item.text);

const socials = [
  { label: 'ВКонтакте', mark: 'vk' as const, href: clinic.links.vk, cms: 'links.vk' },
  { label: 'Max', mark: 'max' as const, href: clinic.links.max, cms: 'links.max' },
  { label: 'Instagram', mark: 'instagram' as const, href: clinic.links.instagram, cms: 'links.instagram' },
].filter((s) => s.href);
---

<footer class="dc-footer" data-cms={cmsSite('menu', 'footer')}>
  <div class="dc-footer__grid">
    <div class="dc-footer__brand">
      <img
        src={withBase('logo-dentalcruise.svg')}
        alt={clinic.name}
        width="180"
        height="40"
        class="dc-footer__logo"
        data-cms-lock="logo"
      />
      <p data-cms={cmsSite('menu', 'footer.text')}>{footer.text}</p>
      {
        socials.length > 0 && (
          <div class="dc-footer__socials">
            {socials.map((s) => (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener" data-cms={cmsSite('clinic', s.cms)}>
                <BrandIcon name={s.mark} size={20} />
              </a>
            ))}
          </div>
        )
      }
    </div>

    <nav class="dc-footer__col" aria-label="Страницы сайта">
      <h2 data-cms={cmsSite('menu', 'footer.pagesTitle')}>{footer.pagesTitle}</h2>
      <ul>
        {
          footer.pages.map((l, i) => (
            <li>
              <a href={pageHref(l.href)} data-cms={cmsSite('menu', `footer.pages.${i}`)}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="dc-footer__col" aria-label="Информация">
      <h2 data-cms={cmsSite('menu', 'footer.infoTitle')}>{footer.infoTitle}</h2>
      <ul>
        {
          footer.info.map((l, i) => (
            <li>
              <a href={pageHref(l.href)} data-cms={cmsSite('menu', `footer.info.${i}`)}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="dc-footer__col" data-cms={cmsSite('clinic')}>
      <h2 data-cms={cmsSite('menu', 'footer.contactsTitle')}>{footer.contactsTitle}</h2>
      <a href={clinic.phoneHref} class="dc-footer__phone">{clinic.phone}</a>
      <p>{clinic.address.locality}, {clinic.address.street}</p>
      <p><MetroStations /></p>
      <p>{clinic.scheduleLong}</p>
      <a href={`mailto:${clinic.email}`}>{clinic.email}</a>
    </div>
  </div>

  {/* Лицензия — как принято у клиник: миниатюра выписки из реестра со
      ссылкой на PDF и строка с номером. Строка открывает ту же шторку со
      сканами, что и плашка «Лицензия» в полосе доверия. */}
  <div class="dc-footer__license" data-cms={cmsSite('clinic', 'license')}>
    {
      license.pdf && license.pdfPreview && (
        <a
          class="dc-footer__doc"
          href={encodeURI(withBase(license.pdf))}
          target="_blank"
          rel="noopener"
          data-cms={cmsSite('clinic', 'license.pdfPreview')}
        >
          <img
            src={encodeURI(withBase(license.pdfPreview))}
            alt={`${blocks.license.open}: открыть в новой вкладке`}
            width="60"
            height="80"
            loading="lazy"
            decoding="async"
          />
        </a>
      )
    }
    <div class="dc-footer__license-text">
      <button type="button" class="dc-footer__license-open" data-open="dc-license"><LicenseLine /></button>
      {
        license.registryUrl && (
          <a
            href={license.registryUrl}
            target="_blank"
            rel="noopener"
            data-cms={cmsSite('clinic', 'license.registryUrl')}
          >
            {blocks.license.registry}
          </a>
        )
      }
    </div>
  </div>

  <div class="dc-footer__legal">
    <span data-cms={cmsSite('clinic', 'name')}>© {year} {clinic.name}</span>
    {
      requisites.length > 0 && (
        <span class="dc-footer__requisites" data-cms={cmsSite('clinic', 'legal')}>
          {requisites.map((item) => (
            <span data-cms={cmsSite('clinic', item.cms)}>{item.text}</span>
          ))}
        </span>
      )
    }
  </div>
</footer>

<style>
  .dc-footer {
    background: var(--surface-footer);
    color: var(--text-on-dark);
    padding: var(--section-y-tight) var(--gutter) var(--space-8);
  }
  .dc-footer__grid {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    gap: var(--space-12);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .dc-footer__brand {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .dc-footer__logo {
    height: 40px;
    width: auto;
    filter: brightness(0) invert(1);
  }
  .dc-footer__brand p {
    color: var(--text-on-dark-muted);
    font-size: var(--type-body);
    max-width: 32ch;
  }
  .dc-footer__socials {
    display: flex;
    gap: var(--space-2);
  }
  .dc-footer__socials a {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-on-dark);
    color: var(--text-on-dark);
  }
  .dc-footer__socials a:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--text-on-dark);
  }

  .dc-footer__col {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .dc-footer__col h2 {
    font-family: var(--font-body);
    font-size: var(--type-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);

    color: var(--text-on-dark-muted);
  }
  .dc-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .dc-footer__col a {
    color: var(--text-on-dark);
    text-decoration: none;
    font-size: var(--type-body);
  }
  .dc-footer__col a:hover {
    color: var(--dc-turquoise);
    text-decoration: underline;
  }
  .dc-footer__col p {
    color: var(--text-on-dark-muted);
  }
  .dc-footer__phone {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    font-weight: var(--fw-bold);
  }

  .dc-footer__license {
    max-width: var(--container);
    margin: var(--space-12) auto 0;
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--line-on-dark);
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    font-size: var(--type-small);
  }
  /* Миниатюра первой страницы выписки — бумажный лист на тёмном подвале */
  .dc-footer__doc {
    flex: none;
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--dc-white);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .dc-footer__doc:hover {
    transform: translateY(-2px);
  }
  .dc-footer__doc img {
    display: block;
    width: 60px;
    height: 80px;
    object-fit: cover;
    object-position: top;
  }
  .dc-footer__license-text {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    max-width: var(--measure);
  }
  .dc-footer__license-open {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    line-height: var(--lh-body);
    text-align: left;
    color: var(--text-on-dark);
    cursor: pointer;
  }
  .dc-footer__license-open:hover {
    color: var(--dc-turquoise);
    text-decoration: underline;
  }
  .dc-footer__license-text a {
    color: var(--text-on-dark-muted);
    text-decoration: underline;
  }
  .dc-footer__license-text a:hover {
    color: var(--dc-turquoise);
  }

  .dc-footer__legal {
    max-width: var(--container);
    margin: var(--space-6) auto 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    justify-content: space-between;
    color: var(--text-on-dark-muted);
    font-size: var(--type-small);
  }
  .dc-footer__requisites {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
</style>
