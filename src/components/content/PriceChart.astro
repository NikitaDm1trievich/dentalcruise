---
/**
 * График «рынок против нашей цены» — области с градиентной заливкой,
 * пунктирная сетка, подписи по-русски, проявление слева направо.
 *
 * Почему не готовая библиотека. Сначала пробовали bklit ui (его нет в npm —
 * это registry в стиле shadcn на React + visx), затем tremor. Tremor v3
 * рассчитан на Tailwind v3 со своим preset, а проект на Tailwind v4 — стили
 * бы не применились; связка @astrojs/react с Rolldown-сборщиком Astro 5.15
 * при этом ломала и dev-сервер, и сборку. Ради одного декоративного блока
 * это ~180 КБ клиентского JS и сломанный тулчейн, поэтому график собран
 * вручную на SVG: та же подача, единицы килобайт, ноль зависимостей.
 *
 * Два варианта одних данных (2026-09): широкий на весь год для десктопа и
 * короткий — лето и сентябрь, без прогнозных месяцев — для телефона.
 * Сам SVG рисует PriceChartPlot.
 */
import PriceChartPlot from './PriceChartPlot.astro';
import { priceChart } from '../../data/price-chart';

const { data, title, marketLabel, clinicLabel, note, anchorMonth } = priceChart;

/**
 * Мобильный ряд: с июня по сентябрь. Прогнозные месяцы отброшены — на
 * узком экране они занимали треть ширины, а показывали плоский хвост.
 * Остаётся самое существенное: летнее снижение до акционной цены.
 */
const narrowData = data.filter((d) => !d.forecast).slice(-4);

const anchorIndex = data.findIndex((d) => d.month === anchorMonth);
const gap = data[anchorIndex].market - data[anchorIndex].clinic;
const rub = new Intl.NumberFormat('ru-RU');
---

<figure class="dc-chart">
  <figcaption class="dc-chart__head">
    <span class="dc-chart__eyebrow">{title}</span>
    <div class="dc-chart__legend">
      <span><i class="dc-chart__swatch dc-chart__swatch--market"></i>{marketLabel}</span>
      <span><i class="dc-chart__swatch dc-chart__swatch--clinic"></i>{clinicLabel}</span>
    </div>
  </figcaption>

  <PriceChartPlot
    data={data}
    anchorMonth={anchorMonth}
    title={title}
    uid="wide"
    thinTicks
    class="dc-chart__plot--wide"
  />
  <PriceChartPlot
    data={narrowData}
    anchorMonth={anchorMonth}
    title={title}
    uid="narrow"
    width={400}
    height={300}
    class="dc-chart__plot--narrow"
  />

  <p class="dc-chart__gap">
    В сентябре разница составляет <b>{rub.format(gap)} ₽</b> на каждой коронке.
  </p>

  <p class="dc-chart__note">{note}</p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-chart]').forEach((chart) => {
    const svg = chart.querySelector('svg');
    const tip = chart.querySelector<HTMLElement>('[data-chart-tip]');
    const cursor = chart.querySelector<SVGLineElement>('.dc-chart__cursor');
    if (!svg || !tip || !cursor) return;

    const chartWidth = Number(chart.dataset.w) || 660;
    const rub = new Intl.NumberFormat('ru-RU');
    const money = (value: string) => `${rub.format(Number(value))} ₽`;

    const hide = () => {
      tip.hidden = true;
      cursor.setAttribute('data-on', 'false');
    };

    svg.querySelectorAll<SVGRectElement>('[data-hit]').forEach((hit) => {
      const show = () => {
        const d = hit.dataset;

        tip.innerHTML = `
          <span class="dc-chart__tip-date">${d.month} 2026${d.forecast === 'true' ? ' · прогноз' : ''}</span>
          <span class="dc-chart__tip-row">
            <i class="dc-chart__tip-dot" style="background:var(--dc-white-caps)"></i>
            В среднем по Москве<b>${money(d.market!)}</b>
          </span>
          <span class="dc-chart__tip-row">
            <i class="dc-chart__tip-dot" style="background:var(--dc-turquoise-ink)"></i>
            Дентал Круиз<b>${money(d.clinic!)}</b>
          </span>`;
        tip.hidden = false;

        // Подсказку ставим над колонкой месяца, в долях ширины графика.
        // У крайних месяцев прижимаем к границам, иначе на узком экране
        // подсказка вылезает за края карточки.
        const ratio = Number(d.cx) / chartWidth;
        tip.style.left = `${Math.min(Math.max(ratio, 0.3), 0.7) * 100}%`;

        cursor.setAttribute('x1', d.cx!);
        cursor.setAttribute('x2', d.cx!);
        cursor.setAttribute('data-on', 'true');
      };

      hit.addEventListener('mouseenter', show);
      hit.addEventListener('focus', show);
      hit.addEventListener('touchstart', show, { passive: true });
    });

    chart.addEventListener('mouseleave', hide);
    svg.addEventListener('blur', hide, true);
  });
</script>
