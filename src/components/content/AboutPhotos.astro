---
/**
 * Иллюстрации описания материала (поле `images`) в левой колонке под
 * заголовком; на телефоне колонка стоит над каруселью.
 */
import PhotoPlaceholder from '../media/PhotoPlaceholder.astro';

interface Props {
  images: { image: string; alt: string; caption?: string; ratio?: string }[];
  entry: string;
}
const { images, entry } = Astro.props;
---

<div class="dc-about__photos" data-cms={`${entry}:images`}>
  {
    images.map((img, i) => (
      <figure data-cms={`${entry}:images.${i}`}>
        <PhotoPlaceholder src={img.image} alt={img.alt} ratio={img.ratio || '4 / 3'} radius="var(--radius-lg)" />
        {img.caption && <figcaption>{img.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .dc-about__photos {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .dc-about__photos figure {
    margin: 0;
    display: grid;
    gap: var(--space-2);
    max-width: 560px;
  }
  .dc-about__photos figcaption {
    font-size: var(--type-small);
    color: var(--text-muted);
  }
</style>
