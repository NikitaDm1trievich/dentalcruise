---
/**
 * Появление блока при скролле. Обёртка только помечает элемент классом
 * и задержкой — саму анимацию запускает Anime.js в `src/lib/reveal.ts`.
 * Без JS блок виден сразу (класс .no-js снимается скриптом в <head>).
 */
interface Props {
  delay?: number;
  as?: 'div' | 'section' | 'li' | 'article';
  class?: string;
}
const { delay = 0, as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['dc-reveal', className]} data-reveal-delay={delay}>
  <slot />
</Tag>

<style>
  .dc-reveal {
    min-width: 0;
  }
</style>
