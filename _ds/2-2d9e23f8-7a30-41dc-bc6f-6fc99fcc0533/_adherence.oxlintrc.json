        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|accent|onDark|bare)$/]",
        "message": "<IconButton> variant must be one of 'light' | 'accent' | 'onDark' | 'bare'."
