---
/**
 * Три слоя волн, дрейфующих с разной скоростью — фирменный мотив бренда.
 * Перенесено из Ds2_2d9e23.WaveField.
 */
interface Props {
  colors?: [string, string, string];
  height?: number;
  class?: string;
}

const {
  colors = ['rgba(194,204,196,.55)', 'rgba(143,162,172,.75)', 'var(--dc-depths)'],
  height = 180,
  class: className,
} = Astro.props;

const PATHS = [
  'M0,60 C180,110 360,10 540,60 C720,110 900,10 1080,60 C1260,110 1440,10 1620,60 L1620,160 L0,160 Z',
  'M0,80 C240,20 480,130 720,80 C960,30 1200,130 1440,80 C1560,55 1620,70 1620,70 L1620,160 L0,160 Z',
  'M0,100 C200,150 400,60 600,100 C800,140 1000,60 1200,100 C1400,140 1520,80 1620,100 L1620,160 L0,160 Z',
];
const SPEEDS = ['var(--dur-wave-1)', 'var(--dur-wave-2)', 'var(--dur-wave-3)'];
---

<div aria-hidden="true" class:list={['dc-waves', className]} style={`height:${height}px`}>
  {
    PATHS.map((d, i) => (
      <svg
        viewBox="0 0 1620 160"
        preserveAspectRatio="none"
        style={`height:${height * (0.72 + i * 0.14)}px;animation-duration:${SPEEDS[i]}`}
      >
        <path d={d} fill={colors[i]} />
      </svg>
    ))
  }
</div>

<style>
  .dc-waves {
    position: relative;
    overflow: hidden;
    pointer-events: none;
  }
  .dc-waves svg {
    position: absolute;
    bottom: 0;
    /* Полосы шире экрана с двух сторон, чтобы дрейф не обнажал край (правка макета) */
    width: 130vw;
    max-width: none;
    left: -15vw;
    animation-name: dc-wave-drift;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }
  @keyframes dc-wave-drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-6%, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-waves svg {
      animation: none;
    }
  }
</style>
