---
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import Header from '../components/layout/Header.astro';
import BurgerMenu from '../components/layout/BurgerMenu.astro';
import Footer from '../components/layout/Footer.astro';
import AppointmentModal from '../components/forms/AppointmentModal.astro';
import LicenseDrawer from '../components/content/LicenseDrawer.astro';
import ScrollToTop from '../components/core/ScrollToTop.astro';
import { withBase } from '../lib/asset';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Шапка лежит поверх hero-видео (только главная) */
  overHero?: boolean;
  noindex?: boolean;
  faq?: { q: string; a: string }[];
}

const { title, description, path = '/', overHero = false, noindex = false, faq } = Astro.props;
const asset = withBase;
---

<!doctype html>
<html lang="ru" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#00B189" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <script is:inline>
      // Снимаем .no-js до первой отрисовки — контент со скролл-анимацией
      // прячется только тогда, когда его точно есть кому показать.
      document.documentElement.classList.remove('no-js');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Golos+Text:wght@400;500;600;700;800&display=swap"
    />

    <Seo title={title} description={description} path={path} noindex={noindex} faq={faq} />
  </head>

  <body>
    <div class="dc-preloader" data-preloader aria-hidden="true">
      <span class="loader"></span>
    </div>

    <a href="#main" class="dc-skip">Перейти к содержимому</a>

    <Header overHero={overHero} />
    <BurgerMenu />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <AppointmentModal />
    <LicenseDrawer />
    <ScrollToTop />

    <script>
      import { initReveal } from '../lib/reveal';
      import { initOverlays } from '../lib/overlays';
      import { initFlipCards } from '../lib/flip';
      import { initCountUp } from '../lib/count-up';

      initOverlays();
      initReveal();
      initFlipCards();
      initCountUp();

      // Прелоадер прячем, когда страница действительно готова — иначе
      // мелькание на быстрых соединениях выглядит хуже, чем его отсутствие.
      const preloader = document.querySelector<HTMLElement>('[data-preloader]');
      if (preloader) {
        const hide = () => {
          preloader.classList.add('is-hidden');
          preloader.addEventListener('transitionend', () => preloader.remove(), { once: true });
        };
        if (document.readyState === 'complete') hide();
        else window.addEventListener('load', hide, { once: true });
      }
    </script>

    <style>
      .dc-preloader {
        position: fixed;
        inset: 0;
        z-index: 300;
        display: grid;
        place-items: center;
        background: var(--dc-white);
        opacity: 1;
        transition: opacity 320ms var(--ease-out);
      }
      .dc-preloader.is-hidden {
        opacity: 0;
        pointer-events: none;
      }
      .no-js .dc-preloader {
        display: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .dc-preloader {
          transition: none;
        }
      }

      /* From Uiverse.io by alexruix */
      .loader {
        width: 48px;
        height: 48px;
        margin: auto;
        position: relative;
      }
      .loader:before {
        content: '';
        width: 48px;
        height: 5px;
        background: color-mix(in srgb, var(--dc-coral) 30%, transparent);
        position: absolute;
        top: 60px;
        left: 0;
        border-radius: 50%;
        animation: dc-loader-shadow 0.5s linear infinite;
      }
      .loader:after {
        content: '';
        width: 100%;
        height: 100%;
        background: var(--dc-coral);
        position: absolute;
        top: 0;
        left: 0;
        border-radius: 4px;
        animation: dc-loader-jump 0.5s linear infinite;
      }
      @keyframes dc-loader-jump {
        15% {
          border-bottom-right-radius: 3px;
        }
        25% {
          transform: translateY(9px) rotate(22.5deg);
        }
        50% {
          transform: translateY(18px) scale(1, 0.9) rotate(45deg);
          border-bottom-right-radius: 40px;
        }
        75% {
          transform: translateY(9px) rotate(67.5deg);
        }
        100% {
          transform: translateY(0) rotate(90deg);
        }
      }
      @keyframes dc-loader-shadow {
        0%,
        100% {
          transform: scale(1, 1);
        }
        50% {
          transform: scale(1.2, 1);
        }
      }

      .dc-skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        padding: 12px 20px;
        background: var(--dc-white);
        color: var(--text-strong);
        font-weight: var(--fw-bold);
        border-radius: 0 0 var(--radius-md) 0;
      }
      .dc-skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
