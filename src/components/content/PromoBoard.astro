---
/**
 * Плашка акций. Перенесено из Ds2_2d9e23.PromoBoard с правками макета:
 * подложка не красная, а из палитры сайта; красными остаются только
 * ярлык «Акции», цены и лента через угол карточки.
 */
import Icon from '../core/Icon.astro';
import Button from '../core/Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  note?: string;
  ctaLabel?: string;
  items: {
    id: string;
    title: string;
    price: string;
    was?: string;
    note?: string;
    attributes?: { label: string; value: string }[];
  }[];
}

const {
  eyebrow = 'Акции месяца',
  title,
  note,
  ctaLabel = 'Записаться по акции',
  items,
} = Astro.props;
---

<div class="dc-promo">
  <div class="dc-promo__head">
    <span class="dc-promo__eyebrow">{eyebrow}</span>
    <h2 class="dc-promo__title">{title}</h2>
  </div>

  <div class="dc-promo__grid">
    {
      items.map((item) => (
        <div class="dc-promo__card">
          <span class="dc-promo__ribbon" aria-hidden="true">Акция</span>
          <span class="dc-promo__label">{item.title}</span>
          <span class="dc-promo__price">{item.price}</span>
          {item.was && <span class="dc-promo__was">{item.was}</span>}
          {item.note && <span class="dc-promo__note">{item.note}</span>}
          {item.attributes && item.attributes.length > 0 && (
            <dl class="dc-promo__attrs">
              {item.attributes.map((attr) => (
                <div>
                  <dt>{attr.label}</dt>
                  <dd>{attr.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      ))
    }
  </div>

  <div class="dc-promo__foot">
    {note && <p class="dc-promo__text">{note}</p>}
    <Button variant="primary" size="lg" data-open="dc-book">
      <Icon slot="icon" name="phone" size={20} />
      {ctaLabel}
    </Button>
  </div>
</div>

<style>
  .dc-promo {
    background: var(--grad-aqua);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-xl);
    padding: clamp(24px, 4vw, 48px);
    box-shadow: var(--shadow-sm);
    display: grid;
    gap: var(--space-8);
  }
  .dc-promo__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .dc-promo__eyebrow {
    display: inline-flex;
    align-items: center;
    background: var(--dc-coral);
    color: var(--text-on-coral);
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--type-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);

  }
  .dc-promo__title {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    font-weight: var(--fw-black);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);

    color: var(--text-strong);
    margin: 0;
  }

  .dc-promo__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .dc-promo__card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    background: var(--dc-white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
  }
  /* Лента «Акция» через правый верхний угол */
  .dc-promo__ribbon {
    position: absolute;
    top: 18px;
    right: -52px;
    width: 170px;
    transform: rotate(38deg);
    padding: 5px 0;
    background: var(--dc-coral);
    color: var(--text-on-coral);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: var(--fw-bold);
    line-height: 1.2;
    text-align: center;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 10px rgba(7, 59, 75, 0.18);
  }
  .dc-promo__label {
    font-family: var(--font-body);
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    color: var(--text-muted);
    /* уступаем место ленте в углу */
    padding-right: 60px;
  }
  .dc-promo__price {
    font-family: var(--font-display);
    font-size: var(--type-price);
    font-weight: var(--fw-black);
    /* Акцентный цвет, не нейтральный: усиливаем контраст на самом
       «горячем» числе карточки — красным остаётся только лента/ярлык. */
    color: var(--text-accent);
    line-height: 1.05;
  }
  .dc-promo__was {
    font-size: var(--type-small);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .dc-promo__note {
    font-size: var(--type-small);
    color: var(--text-body);
  }
  .dc-promo__attrs {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-hairline);
  }
  .dc-promo__attrs div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--type-small);
  }
  .dc-promo__attrs dt {
    color: var(--text-muted);
  }
  .dc-promo__attrs dd {
    margin: 0;
    font-weight: var(--fw-semibold);
    color: var(--text-body);
    text-align: right;
  }

  .dc-promo__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
    justify-content: space-between;
  }
  .dc-promo__text {
    max-width: 46ch;
    color: var(--text-body);
    font-weight: var(--fw-medium);
  }
</style>
