---
/** Бегущая строка поставщиков. Перенесено из Ds2_2d9e23.BrandsMarquee. */
import { withBase } from '../../lib/asset';

interface Props {
  eyebrow?: string;
  brands: { id: string; name: string; logo?: string; note?: string }[];
  speed?: number;
}

const { eyebrow = 'Материалы и поставщики', brands, speed = 38 } = Astro.props;
// Дубль списка — чтобы лента замыкалась без стыка
const row = [...brands, ...brands];
---

<div class="dc-marquee">
  {eyebrow && <span class="dc-marquee__eyebrow">{eyebrow}</span>}
  <div
    class="dc-marquee__viewport"
    data-marquee-viewport
    data-marquee-speed={speed}
    tabindex="0"
    role="group"
    aria-label="Поставщики материалов, лента прокручивается вручную"
  >
    <div class="dc-marquee__row" data-marquee-row data-marquee-set-count={brands.length}>
      {
        row.map((brand, i) => (
          <span class="dc-marquee__item" title={brand.note ?? brand.name} aria-hidden={i >= brands.length}>
            {brand.logo ? <img src={withBase(brand.logo)} alt={brand.name} height="34" /> : brand.name}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .dc-marquee {
    display: grid;
    gap: var(--space-6);
  }
  .dc-marquee__eyebrow {
    font-family: var(--font-body);
    font-size: var(--type-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);

    color: var(--text-muted);
    text-align: center;
  }
  .dc-marquee__viewport {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    /* Обычный скролл — тачем как страницу, колесом/трекпадом, полосой
       прокрутки; авто-игра и «бесшовное» зацикливание крутят тот же
       scrollLeft поверх, а не отдельный жест поверх скролла. */
    -webkit-overflow-scrolling: touch;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .dc-marquee__viewport::-webkit-scrollbar {
    display: none;
  }
  .dc-marquee__row {
    display: flex;
    width: max-content;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-marquee__viewport {
      overflow: visible;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .dc-marquee__row {
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
    }
  }
  .dc-marquee__item {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
    white-space: nowrap;
    opacity: 0.78;
  }
  .dc-marquee__item img {
    height: 34px;
    width: auto;
  }
</style>

<script>
  /**
   * Лента листается как обычный горизонтальный скролл — тачем, трекпадом,
   * колесом, полосой прокрутки — а не отдельным жестом перетаскивания.
   * Автопрокрутка просто прибавляет к тому же scrollLeft каждый кадр, а
   * «бесконечность» держится на том, что список задублирован (в разметке)
   * и при подходе к любому краю мы молча переносим scrollLeft на ширину
   * одного набора назад/вперёд — стык совпадает пиксель в пиксель, поэтому
   * скачка не видно.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-marquee-viewport]').forEach((viewport) => {
    const row = viewport.querySelector<HTMLElement>('[data-marquee-row]');
    if (!row || reduced) return;

    // В разметке лежит два набора карточек (см. .astro выше). Если карточек
    // мало (широкий экран, короткий список поставщиков), двух наборов не
    // хватает: край прокрутки упирается раньше, чем доедет до точки
    // «бесшовной» перемотки, и лента залипает. Досклеиваем ещё наборов,
    // пока по обе стороны от текущей позиции не останется солидный запас.
    const setCount = Number(row.dataset.marqueeSetCount ?? 1) || 1;
    const originals = Array.from(row.children).slice(0, setCount);
    let sets = Math.round(row.children.length / setCount) || 1;

    while ((sets < 3 || row.scrollWidth < viewport.clientWidth * (sets + 2)) && sets < 20) {
      for (const node of originals) {
        const clone = node.cloneNode(true) as HTMLElement;
        // Это чисто декоративный повтор ради бесшовной перемотки —
        // скринридеру достаточно назвать поставщиков один раз
        clone.setAttribute('aria-hidden', 'true');
        row.appendChild(clone);
      }
      sets += 1;
    }

    // Ширина одного набора карточек
    const setWidth = () => row.scrollWidth / sets;
    // px/сек: время на полный цикл задаётся тем же числом, что раньше шло в animation-duration
    const speedSetting = Number(viewport.dataset.marqueeSpeed ?? 38);

    let paused = false;
    let resumeTimer: number | undefined;
    let lastFrame: number | undefined;
    let programmatic = false;

    const setScroll = (v: number) => {
      programmatic = true;
      viewport.scrollLeft = v;
    };

    // Стартуем на один набор от края: со всех сторон есть запас на перемотку
    setScroll(setWidth());

    const wrapIfNeeded = () => {
      const width = setWidth();
      if (width <= 0) return;
      if (viewport.scrollLeft >= width * (sets - 1)) setScroll(viewport.scrollLeft - width);
      else if (viewport.scrollLeft < width) setScroll(viewport.scrollLeft + width);
    };

    const pauseAutoplay = () => {
      paused = true;
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => (paused = false), 1800);
    };

    viewport.addEventListener(
      'scroll',
      () => {
        if (programmatic) {
          programmatic = false;
          return;
        }
        // Настоящий скролл пользователя — тач, колесо, трекпад, полоса
        pauseAutoplay();
        wrapIfNeeded();
      },
      { passive: true },
    );

    const tick = (now: number) => {
      if (lastFrame === undefined) lastFrame = now;
      const dt = (now - lastFrame) / 1000;
      lastFrame = now;

      if (!paused && !document.hidden) {
        setScroll(viewport.scrollLeft + (setWidth() / speedSetting) * dt);
        wrapIfNeeded();
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
