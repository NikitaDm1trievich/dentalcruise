---
/**
 * Первый экран: видео океана на весь экран, слоган поверх, волны внизу.
 * Перенесено из Ds2_2d9e23.OceanHero.
 *
 * Видео не грузится, пока скрипт не убедится, что это уместно:
 * при экономии трафика, медленном соединении, prefers-reduced-motion или
 * на экране уже 1024px остаётся только poster-кадр (требование брифа —
 * mobile-first аудитория; ролик весит 2,1–2,5 МБ и на телефоне только
 * тормозил первый экран). Poster на телефоне — кандидат в LCP, поэтому
 * его просим предзагрузить с высоким приоритетом.
 */
import WaveField from './WaveField.astro';
import { cmsText } from '../../lib/cms-ref';

interface Props {
  eyebrow?: string;
  slogan: string;
  webm?: string;
  mp4?: string;
  poster?: string;
}

const { eyebrow = 'Центр стоматологии', slogan, webm, mp4, poster } = Astro.props;
---

<section id="top" class="dc-hero" data-cms={cmsText('hero')}>
  {/* <link rel="preload"> допустим и в <body>; сканер предзагрузки видит
      его раньше, чем парсер дойдёт до атрибута poster у <video>. */}
  {poster && <link rel="preload" as="image" href={poster} fetchpriority="high" />}
  <video
    class="dc-hero__video"
    poster={poster}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    data-hero-video
    data-webm={webm}
    data-mp4={mp4}></video>

  <div aria-hidden="true" class="dc-hero__scrim"></div>

  <div class="dc-hero__inner">
    {eyebrow && <span class="dc-hero__eyebrow">{eyebrow}</span>}
    <h1 class="dc-hero__title">{slogan}</h1>
    <slot />
  </div>

  <WaveField
    height={92}
    colors={['rgba(255,255,255,.28)', 'rgba(255,255,255,.5)', 'var(--surface-cool)']}
    class="dc-hero__waves"
  />
</section>

<style>
  .dc-hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--grad-deep);
  }
  .dc-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* На телефонах виден только poster. Растянутый cover на всю высоту экрана
     превращал кадр 2:1 в гигантское размытое лицо, поэтому на узких экранах
     кадр — верхняя полоса умеренной высоты (лицо правее середины, фокус 57%),
     а низ плавно растворяется в тёмном фоне секции. */
  @media (max-width: 1023px) {
    .dc-hero {
      align-items: end;
      padding-bottom: 112px;
    }
    .dc-hero__video {
      bottom: auto;
      height: clamp(340px, 46svh, 480px);
      object-position: 57% 40%;
      -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
    }
  }
  .dc-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(4, 48, 65, 0.42) 0%,
      rgba(4, 48, 65, 0.28) 45%,
      rgba(4, 48, 65, 0.62) 100%
    );
  }
  .dc-hero__inner {
    position: relative;
    z-index: 2;
    padding: 0 var(--gutter);
    text-align: center;
    max-width: min(1000px, 92vw);
    margin-inline: auto;
  }
  .dc-hero__eyebrow {
    display: block;
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.4vw, 1.0625rem);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);

    color: #fff;
    text-shadow: 0 2px 18px rgba(7, 59, 75, 0.6);
  }
  .dc-hero__title {
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: var(--type-hero);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-hero);

    color: #fff;
    text-shadow: 0 4px 40px rgba(2, 32, 41, 0.55);
    margin: 0;
    overflow-wrap: break-word;
  }
  /* :global — класс уезжает в дочерний компонент WaveField, у него своя область видимости стилей */
  .dc-hero :global(.dc-hero__waves) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    z-index: 3;
  }

  /* «Прилив»: пока первый экран уходит вверх, кадр океана отстаёт на 7%,
     а задние полупрозрачные слои волн поднимаются на 40 и 20px за передним.
     Передний слой стоит: он цвета верха следующей секции, и стык с ней
     остаётся чистым. При прогрессе 0 ничего не сдвинуто — poster на месте
     и LCP не страдает. Без поддержки animation-timeline экран статичен. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .dc-hero {
        view-timeline: --dc-hero block;
      }
      .dc-hero__video,
      .dc-hero :global(.dc-hero__waves .dc-waves__layer:not(:last-child)) {
        animation-timing-function: var(--ease-swell);
        animation-fill-mode: both;
        animation-duration: auto;
        animation-timeline: --dc-hero;
        animation-range: exit 0% exit 100%;
      }
      /* will-change только на волнах: держать полноэкранное видео
         отдельным слоем постоянно слишком дорого */
      .dc-hero :global(.dc-hero__waves .dc-waves__layer:not(:last-child)) {
        will-change: transform;
      }
      .dc-hero__video {
        animation-name: dc-hero-lag;
      }
      .dc-hero :global(.dc-hero__waves .dc-waves__layer:nth-child(1)) {
        --wave-rise: -40px;
        animation-name: dc-hero-rise;
      }
      .dc-hero :global(.dc-hero__waves .dc-waves__layer:nth-child(2)) {
        --wave-rise: -20px;
        animation-name: dc-hero-rise;
      }
    }
  }
  @keyframes dc-hero-lag {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, calc(7% * var(--parallax-shift)), 0);
    }
  }
  @keyframes dc-hero-rise {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, calc(var(--wave-rise) * var(--parallax-shift)), 0);
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (video) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
      .connection;
    const slow = conn?.saveData === true || /^(slow-2g|2g|3g)$/.test(conn?.effectiveType ?? '');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Телефоны и планшеты обходятся poster-кадром: ролик там ни разу не
    // окупал свои мегабайты (аудит: грузился и на мобильных).
    const wide = window.matchMedia('(min-width: 1024px)').matches;

    if (!slow && !reduced && wide) {
      const add = (src: string | null, type: string) => {
        if (!src) return;
        const s = document.createElement('source');
        s.src = src;
        s.type = type;
        video.appendChild(s);
      };
      add(video.dataset.webm ?? null, 'video/webm');
      add(video.dataset.mp4 ?? null, 'video/mp4');

      video.preload = 'auto';
      video.load();
      // play() отклоняется, если браузер всё же запретил автозапуск — poster остаётся.
      video.play().catch(() => {});
    }
  }
</script>
