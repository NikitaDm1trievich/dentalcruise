---
/**
 * Каркас наполненной внутренней страницы: шапка с крошками и заголовком,
 * дальше — произвольные секции через слот.
 *
 * Отличие от StubLayout: тот честно говорит «раздел готовится» и уводит
 * в телефон, этот — для страниц, где контент есть.
 */
import BaseLayout from './BaseLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Icon from '../components/core/Icon.astro';
import { menu } from '../data/site';
import { pageHref } from '../lib/asset';
import { cmsSite } from '../lib/cms-ref';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow?: string;
  heading: string;
  lead?: string;
  /** Хлебные крошки без «Главная» — она добавляется сама. cms — адрес подписи в редакторе */
  breadcrumbs?: { label: string; href?: string; cms?: string }[];
  noindex?: boolean;
  hideContactsCta?: boolean;
  /** Дополнительные блоки JSON-LD страницы: врач, услуга, галерея */
  schema?: Record<string, unknown>[];
  /** Вопросы страницы — уходят в схему FAQPage и в сниппет выдачи */
  faq?: { q: string; a: string }[];
  /** Запись шапки страницы в редакторе для выбора блока в предпросмотре (lib/cms-ref) */
  cms?: string;
  /** Адрес лида в редакторе, если он не в записи шапки (адрес клиники на «Контактах») */
  leadCms?: string;
  /**
   * Адрес надписи над заголовком. Нужен, когда она совпадает по тексту с
   * другим полем записи (крошка «Контакты»): по тексту предпросмотр их не
   * различит и откроет не то поле.
   */
  eyebrowCms?: string;
  /**
   * Лид — текст из редактора с метками (`{позиций}`): значения меток. По ним
   * предпросмотр редактора собирает лид так же, как сборка (lib/cms-preview).
   */
  leadVars?: Record<string, string>;
}

const {
  title,
  description,
  path,
  eyebrow,
  heading,
  lead,
  breadcrumbs = [],
  noindex = false,
  hideContactsCta = false,
  schema,
  faq,
  cms,
  leadCms,
  eyebrowCms,
  leadVars,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  hideContactsCta={hideContactsCta}
  schema={schema}
  faq={faq}
  breadcrumbs={breadcrumbs.map((crumb) => ({ label: crumb.label, path: crumb.href }))}
>
  <header class="dc-page__top" data-cms={cms}>
    <div class="dc-page__inner">
      <nav class="dc-crumbs" aria-label="Хлебные крошки">
        <a href={pageHref('')} data-cms={cmsSite('menu', 'crumbsHome')}>{menu.crumbsHome}</a>
        {
          breadcrumbs.map((crumb) => (
            <>
              <Icon name="chevron-right" size={14} />
              {crumb.href ? (
                <a href={crumb.href} data-cms={crumb.cms}>{crumb.label}</a>
              ) : (
                <span data-cms={crumb.cms}>{crumb.label}</span>
              )}
            </>
          ))
        }
      </nav>

      <Reveal>
        <div class="dc-page__head">
          {eyebrow && <span class="dc-page__eyebrow" data-cms={eyebrowCms}>{eyebrow}</span>}
          <h1 class="dc-page__title">{heading}</h1>
          {lead && <p class="dc-page__lead" data-cms={leadCms} data-cms-vars={leadVars && JSON.stringify(leadVars)}>{lead}</p>}
          <slot name="head-extra" />
        </div>
      </Reveal>
    </div>
  </header>

  <slot />
</BaseLayout>

<style>
  .dc-page__top {
    padding: calc(var(--header-h) + var(--space-10)) var(--gutter) var(--space-10);
    background: var(--grad-aqua);
  }
  .dc-page__inner {
    max-width: var(--container);
    margin-inline: auto;
    display: grid;
    gap: var(--space-6);
  }

  .dc-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .dc-crumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .dc-crumbs a:hover {
    color: var(--text-accent);
  }

  .dc-page__head {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .dc-page__eyebrow {
    font-family: var(--font-body);
    font-size: var(--type-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-muted);
  }
  .dc-page__title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: var(--fw-black);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
    margin: 0;
    /* Названия услуг вроде «Металлокерамическая» на 320px шире экрана —
       без переноса заголовок растягивал страницу вбок. */
    hyphens: auto;
    overflow-wrap: anywhere;
  }
  .dc-page__lead {
    font-size: var(--type-lead);
    line-height: var(--lh-body);
    color: var(--text-body);
    max-width: min(var(--measure), 100%);
  }
</style>
