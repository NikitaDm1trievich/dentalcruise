---
/** Карточка врача с переворотом. Портировано из DoctorFlipCard.dc.html. */
import Icon from '../core/Icon.astro';
import PhotoPlaceholder from '../media/PhotoPlaceholder.astro';
import { doctorPage } from '../../data/pages';
import { cmsText } from '../../lib/cms-ref';
/* Подписи карточки правит владелец: «Главная страница» → «7. Врачи»;
   слово «Стаж» — общее со страницами врачей («Страницы сайта»). */
import copy from '../../data/home.json';

interface Props {
  name: string;
  speciality: string;
  experience: string;
  note: string;
  extra?: string;
  photo?: string;
  photoLabel: string;
  /**
   * Страница врача (/doctors/<id>). Ссылка стоит на обороте рядом с кнопкой
   * записи: без неё главная не вела ни к одному врачу, а флип-карточка
   * была тупиком — с неё можно было только записаться.
   */
  href?: string;
  /** Не врач (зубной техник): своя подпись ссылки на страницу */
  staff?: boolean;
  /**
   * Кадр по вертикали, как второе число object-position: 0 — верх снимка,
   * 100 — низ. Пусто — по верхнему краю (см. стили .dc-doc__photo).
   */
  photoY?: number;
  /** Запись врача в редакторе для выбора блока в предпросмотре (lib/cms-ref) */
  cms?: string;
}

const { name, speciality, experience, note, extra, photo, photoLabel, href, staff, photoY, cms } = Astro.props;
const facts = [experience && `${doctorPage.experience} ${experience}`, note, extra].filter(Boolean) as string[];
const photoStyle = photoY === undefined ? undefined : `--dc-doc-photo-y:${photoY}%`;
---

<div class="dc-doc" data-flip data-cms={cms}>
  <button
    type="button"
    class="dc-doc__toggle"
    aria-label={`${speciality} — подробнее`}
    data-flip-toggle></button>

  <div class="dc-doc__inner" data-flip-inner>
    <article class="dc-doc__face dc-doc__face--front">
      <div class="dc-doc__photo" style={photoStyle}>
        <PhotoPlaceholder label={photoLabel} src={photo} alt={name} ratio="3 / 4" radius="0" cover />
      </div>
      <div class="dc-doc__body">
        <h3>{name}</h3>
        <p class="dc-doc__spec">{speciality}</p>
        {experience && <span class="dc-doc__exp">{doctorPage.experience} {experience}</span>}
        <span class="dc-doc__hint" data-cms={cmsText('doctors.cardHint')}>
          <Icon name="repeat-2" size={18} strokeWidth={2.2} />
          {copy.doctors.cardHint}
        </span>
      </div>
    </article>

    <div class="dc-doc__face dc-doc__face--back">
      <div class="dc-doc__backhead">
        <h3>{name}</h3>
        <p class="dc-doc__spec">{speciality}</p>
      </div>
      <ul class="dc-doc__facts">
        {
          facts.map((fact, i) => (
            <li style={`--dc-doc-delay:${i * 50 + 150}ms`}>
              <Icon name="check" size={16} strokeWidth={2.6} color="var(--text-accent)" />
              <span>{fact}</span>
            </li>
          ))
        }
      </ul>
      <div class="dc-doc__actions">
        {
          href && (
            <a href={href} class="dc-doc__more" data-cms={cmsText(staff ? 'doctors.cardPageStaff' : 'doctors.cardPage')}>
              {staff ? copy.doctors.cardPageStaff : copy.doctors.cardPage}
              <Icon name="arrow-right" size={16} strokeWidth={2.2} />
            </a>
          )
        }
        <button type="button" class="dc-doc__cta" data-open="dc-book" data-cms={cmsText('doctors.cardBook')}>
          {copy.doctors.cardBook}
          <Icon name="arrow-right" size={20} />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Ширина карточки — контейнер: от неё считается высота окна под фото
     (cqw в .dc-doc__inner и .dc-doc__photo). */
  .dc-doc {
    position: relative;
    width: 100%;
    min-width: 0;
    container-type: inline-size;
  }
  /* 3D-контекст только на время переворота — см. src/lib/flip.ts */
  .dc-doc.is-3d {
    perspective: 2000px;
  }
  .dc-doc__toggle {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: transparent;
    border: 0;
    border-radius: var(--radius-lg);
    cursor: pointer;
  }
  /* На обороте кнопка-переворот уходит под карточку, а сама карточка
     пропускает касания насквозь — кроме ссылки на страницу врача и кнопки
     записи. Так переворачивает назад касание в любом месте оборота, кроме
     этих двух кнопок, какой бы высоты ни был блок действий (в одну строку
     или в две). Прежний фиксированный отступ снизу (2×48+8px) оставлял на
     широкой карточке полосу, касание по которой ничего не делало. */
  .dc-doc[data-flipped='true'] .dc-doc__toggle {
    z-index: 0;
  }
  .dc-doc[data-flipped='true'] .dc-doc__inner {
    pointer-events: none;
  }
  .dc-doc[data-flipped='true'] .dc-doc__more,
  .dc-doc[data-flipped='true'] .dc-doc__cta {
    pointer-events: auto;
  }

  /* Высота карточки растёт с шириной: окно под фото (всё, что над текстом,
     ~12rem) держится около 4:3. При фиксированных 440px на широкой
     карточке окно становилось почти вдвое шире своей высоты, и в него
     не помещалась голова целиком — от макушки до подбородка. */
  .dc-doc__inner {
    position: relative;
    width: 100%;
    height: max(440px, calc(75cqw + 12rem));
    transform-style: flat;
    transition: transform 560ms cubic-bezier(0.77, 0, 0.175, 1);
  }
  .dc-doc.is-3d .dc-doc__inner {
    transform-style: preserve-3d;
  }
  .dc-doc[data-flipped='true'] .dc-doc__inner {
    transform: rotateY(180deg);
  }
  /* Покой изнанкой вверх: вращения нет, слой плоский — текст не мылится */
  .dc-doc.is-back .dc-doc__inner {
    transform: none;
    /* Переворот уже доигран: контейнер и изнанка разворачиваются
       одновременно и мгновенно, иначе карточка дёрнется второй раз. */
    transition: none;
  }
  /* Тот же стоп-кадр на обратном пути — см. src/lib/flip.ts */
  .dc-doc.is-no-anim .dc-doc__inner {
    transition: none;
  }
  .dc-doc.is-back .dc-doc__face--front {
    visibility: hidden;
  }
  .dc-doc.is-back .dc-doc__face--back {
    visibility: visible;
    transform: none;
  }

  .dc-doc__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  .dc-doc__face--front {
    transform: rotateY(0deg);
    background: var(--surface-card);
    box-shadow: var(--shadow-md);
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .dc-doc__photo {
    position: relative;
    overflow: hidden;
  }
  /* Окно под фото шире портрета 3:4 и показывает примерно верхние 56%
     снимка. Кадр по умолчанию — от верхнего края: так макушку не срежет
     ни на одном снимке, а голова на портретах всегда в верхней половине.
     Если над головой на снимке много пустого места, кадр сдвигают полем
     врача «Положение фото по вертикали, %» (photoY). */
  .dc-doc__photo :global(.dc-photo__img) {
    object-position: 50% var(--dc-doc-photo-y, 0%);
  }
  .dc-doc__body {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
  }
  .dc-doc__body h3,
  .dc-doc__backhead h3 {
    font-size: var(--type-h4);
    text-transform: none;
    letter-spacing: 0;
  }
  .dc-doc__spec {
    color: var(--text-body);
    font-size: var(--type-small);
    font-weight: var(--fw-semibold);
  }
  .dc-doc__exp {
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    color: var(--text-accent);
  }
  .dc-doc__hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-2);
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface-quiet);
    box-shadow: inset 0 0 0 1px var(--dc-turquoise-soft);
    font-size: var(--type-body);
    font-weight: var(--fw-bold);
    color: var(--text-accent);
  }

  .dc-doc__face--back {
    /* Без 3D-контекста backface-visibility не работает — прячем изнанку явно */
    visibility: hidden;
    transform: rotateY(180deg);
    background: var(--grad-aqua);
    box-shadow: var(--shadow-lg);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-4);
    padding: var(--space-6);
  }
  .dc-doc.is-3d .dc-doc__face--back {
    visibility: visible;
  }
  .dc-doc__backhead {
    display: grid;
    gap: var(--space-2);
  }
  .dc-doc__facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .dc-doc__facts li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--type-small);
    color: var(--text-body);
    opacity: 0;
    transform: translateX(-10px);
    transition:
      transform var(--dur-mid) var(--ease-out) var(--dc-doc-delay),
      opacity var(--dur-mid) var(--ease-out) var(--dc-doc-delay);
  }
  .dc-doc[data-flipped='true'] .dc-doc__facts li {
    opacity: 1;
    transform: translateX(0);
  }
  .dc-doc__facts :global(.dc-icon) {
    margin-top: 3px;
  }

  .dc-doc__actions {
    display: grid;
    gap: var(--space-2);
  }
  /* Ссылка на страницу врача. Как и кнопка записи — выше кнопки-переворота
     по z-index, иначе нажатие уходило бы в переворот карточки. */
  .dc-doc__more {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    min-height: var(--tap-min);
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    color: var(--text-accent);
    text-decoration: none;
  }
  .dc-doc__more:hover,
  .dc-doc__more:focus-visible {
    color: var(--dc-turquoise-press);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dc-doc__cta {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--tap-min);
    padding: 0 var(--space-5);
    border: none;
    border-radius: var(--radius-pill);
    background: var(--cta-bg);
    color: var(--cta-fg);
    font-family: var(--font-body);
    font-size: var(--type-body);
    font-weight: var(--fw-bold);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .dc-doc__cta:hover {
    background: var(--cta-bg-hover);
  }
  .dc-doc__cta:active {
    transform: scale(0.975);
  }

  /* ── Телефон: карточка в одну колонку, компактнее ──
     Высоту карточки задаёт содержимое, а не формула выше: обе стороны
     лежат в одной ячейке грида, и карточка ровно по более высокой из них.
     Так изнанку не обрезает на 320px, а лицо не стоит с пустым низом.
     Фото занимает всё, что осталось над текстом, но не ниже 4:3 от ширины
     (и не ниже 210px): при прежних 210px на карточке шириной 335–500px
     окно было в 1,6–2,4 раза шире своей высоты и срезало то макушку, то
     подбородок. */
  @media (max-width: 559px) {
    .dc-doc__inner {
      display: grid;
      height: auto;
    }
    .dc-doc__face {
      position: relative;
      inset: auto;
      grid-area: 1 / 1;
    }
    .dc-doc__photo {
      min-height: max(210px, 75cqw);
    }
    /* Снимок не должен раздвигать карточку своей высотой: он только
       заполняет окно, размер которого задают текст и изнанка. */
    .dc-doc__photo :global(.dc-photo) {
      position: absolute;
      inset: 0;
    }
    .dc-doc__body {
      gap: var(--space-1);
      padding: var(--space-3) var(--space-4) var(--space-4);
    }
    .dc-doc__body h3,
    .dc-doc__backhead h3 {
      font-size: var(--type-body);
    }
    .dc-doc__hint {
      margin-top: var(--space-1);
      padding: 5px 12px;
      font-size: var(--type-small);
    }
    .dc-doc__face--back {
      gap: var(--space-3);
      padding: var(--space-4);
    }
    .dc-doc__backhead {
      gap: var(--space-1);
    }
    .dc-doc__facts {
      gap: var(--space-2);
    }
  }

  /* ── Широкая карточка (сетка в две колонки на ПК): фото слева ──
     В вертикальной раскладке окно под фото ~4:3 от ширины, и карточка
     шириной 600–700px вырастала бы почти до 700px в высоту. Здесь фото —
     портретное окно на всю высоту карточки, текст справа. Высота — не ниже
     окна 3:4 у колонки фото (42% ширины) и не ниже 360px; как на телефоне,
     обе стороны лежат в одной ячейке грида, и карточка растёт по более
     высокой из них, так что длинный оборот из редактора не обрежется.
     На узкой карточке окно выходит уже 3:4 — снимок обрезается по бокам,
     голова по высоте остаётся целиком. Телефон (до 559px) не трогаем. */
  @media (min-width: 560px) {
    /* Карточка тянется на высоту ряда сетки — соседи в ряду ровные */
    .dc-doc {
      height: 100%;
    }
    /* Высота по формуле выше — только нижняя граница: обе стороны лежат в
       одной ячейке грида, и длинный оборот из редактора (или перенос
       кнопки записи на узкой карточке) растит карточку, а не обрезается.
       Фото по-прежнему заполняет всё над текстом лица. */
    .dc-doc__inner {
      display: grid;
      height: 100%;
      min-height: max(440px, calc(75cqw + 12rem));
    }
    .dc-doc__face {
      position: relative;
      inset: auto;
      grid-area: 1 / 1;
    }
    .dc-doc__photo :global(.dc-photo) {
      position: absolute;
      inset: 0;
    }
    @container (min-width: 440px) {
      .dc-doc__inner {
        min-height: max(360px, 56cqw);
      }
      .dc-doc__face--front {
        grid-template-columns: 42% minmax(0, 1fr);
        grid-template-rows: none;
      }
      .dc-doc__body {
        align-content: center;
        padding: var(--space-6);
      }
      /* Плашка по своему тексту, а не полосой на всю колонку */
      .dc-doc__hint {
        justify-self: start;
      }
      /* Ссылка и запись в один ряд, если помещаются; иначе запись ниже
         на всю ширину, как в вертикальной карточке. */
      .dc-doc__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-5);
      }
      .dc-doc__cta {
        flex: 1 1 15rem;
        width: auto;
      }
    }
  }
</style>
