---
/**
 * Палитра, которую правит владелец в редакторе (раздел «Цвета сайта»), подмешивается
 * поверх токенов из styles/tokens/colors.css.
 *
 * Селектор `:root:root` намеренно удвоен: так специфичность выше обычного
 * `:root`, и порядок подключения стилей перестаёт иметь значение. Ключа нет
 * в JSON — остаётся значение по умолчанию из colors.css.
 *
 * Здесь же сборка проверяет контраст: сломанная пара «текст на фоне» пишется
 * в лог сборки, а не обнаруживается на живом сайте.
 */
import theme from '../../data/theme.json';
import { checkTheme } from '../../lib/contrast';
import { themeEntries } from '../../lib/theme-vars';

const failed = checkTheme(theme).filter((c) => !c.passes);
if (failed.length) {
  console.warn(
    `\n[тема] Контраст ниже нормы WCAG AA (${failed.length}):\n` +
      failed.map((c) => `  ${c.label}: ${c.ratio}:1, нужно ${c.min}:1`).join('\n') +
      '\n  Поправьте цвета в src/data/theme.json или в разделе «Цвета сайта».\n',
  );
}

const css = `:root:root{${themeEntries(theme).map(([name, value]) => `${name}:${value};`).join('')}}`;
---

<style is:inline set:html={css}></style>
