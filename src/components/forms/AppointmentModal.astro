---
/** Модалка записи. Перенесено из Ds2_2d9e23.AppointmentModal. */
import Icon from '../core/Icon.astro';
import IconButton from '../core/IconButton.astro';
import AppointmentForm from './AppointmentForm.astro';
---

<div class="dc-modal" id="dc-book" data-state="closed" aria-hidden="true" inert>
  <div class="dc-modal__scrim" data-close></div>

  <div class="dc-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="dc-book-title">
    <div class="dc-modal__head">
      <div>
        <h2 id="dc-book-title">Записаться на приём</h2>
        <p>Оставьте номер — мы перезвоним и подберём удобное время.</p>
      </div>
      <IconButton label="Закрыть" variant="bare" data-close>
        <Icon name="x" size={24} />
      </IconButton>
    </div>

    <AppointmentForm />
  </div>
</div>

<style>
  .dc-modal {
    --dc-modal-gap: var(--gutter);
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    /* Диалог короче экрана центрируется; диалог выше экрана начинается
       сверху и не обрезается: ряд грида, не влезающий в контейнер,
       прижимается к его началу */
    place-items: center;
    padding: var(--dc-modal-gap) var(--dc-modal-gap)
      max(var(--dc-modal-gap), env(safe-area-inset-bottom));
    /* Диалог выше экрана (телефон, тем более с клавиатурой) прокручивается
       вместе с подложкой, как страница: обрез контента приходится на край
       экрана, а низ карточки со скруглением и отступом дорисовывается целиком.
       Скролл внутри самого диалога резал строку с телефоном у скруглённого
       низа — выглядело обрывом, а не «дальше есть ещё». */
    overflow-y: auto;
    /* Иначе скролл модалки на телефоне протекает на страницу под ней */
    overscroll-behavior: contain;
    pointer-events: none;
  }
  .dc-modal[data-state='open'] {
    pointer-events: auto;
  }
  .dc-modal__scrim {
    /* fixed, а не absolute: подложка не должна уезжать вместе со скроллом модалки */
    position: fixed;
    inset: 0;
    background: rgba(2, 32, 41, 0.62);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out);
  }
  .dc-modal[data-state='open'] .dc-modal__scrim {
    opacity: 1;
  }

  .dc-modal__dialog {
    position: relative;
    width: min(520px, 100%);
    background: var(--surface-page);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition:
      transform var(--dur-mid) var(--ease-out),
      opacity var(--dur-mid) var(--ease-out);
  }
  .dc-modal[data-state='open'] .dc-modal__dialog {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .dc-modal__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .dc-modal__head h2 {
    font-size: var(--type-h2);

    letter-spacing: var(--ls-display);
    margin-bottom: var(--space-2);
  }
  .dc-modal__head p {
    color: var(--text-body);
  }

  /* На телефоне отступы теснее: в экран помещается больше формы, скроллить меньше */
  @media (max-width: 480px) {
    .dc-modal {
      --dc-modal-gap: var(--space-4);
    }
    .dc-modal__dialog {
      padding: var(--space-6);
    }
  }
</style>
