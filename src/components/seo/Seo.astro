---
/**
 * Мета-теги, Open Graph и JSON-LD.
 *
 * Схема — Dentist (подтип MedicalBusiness/LocalBusiness) с реальными
 * российскими данными: адрес в Москве, телефон +7, часы пн–сб.
 * Пустые поля (индекс, ИНН/ОГРН, номер лицензии) в разметку не попадают —
 * лучше не отдавать поле, чем отдать выдуманное.
 *
 * Организация описана один раз, здесь, и получает постоянный `@id`.
 * Страницы врачей и услуг не повторяют её, а ссылаются на этот же `@id`:
 * так поисковик видит одну клинику с врачами и прайсом, а не десяток
 * независимых организаций с одинаковым адресом.
 */
import { clinic } from '../../data/site';
import seo from '../../data/seo.json';
import { absolute, breadcrumbSchema, clinicId, isIndexable, siteRoot } from '../../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Путь страницы относительно корня, напр. "/pricelist" */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Вопросы FAQ — попадают в схему FAQPage (сниппеты в поиске) */
  faq?: { q: string; a: string }[];
  /** Хлебные крошки без «Главная» — она добавляется сама */
  breadcrumbs?: { label: string; path?: string }[];
  /** Дополнительные блоки JSON-LD страницы: врач, услуга, галерея */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  path = '/',
  ogImage,
  noindex = false,
  faq,
  breadcrumbs,
  schema = [],
} = Astro.props;

const site = Astro.site;
const canonical = absolute(path, site);
const root = siteRoot(site);

/* Страница закрыта от поиска либо своим noindex (404, заглушки), либо
   всей сборкой: на staging (GitHub Pages) и в локальных сборках
   isIndexable даёт false, и noindex получают все страницы разом. */
const indexable = isIndexable(site) && !noindex;

/* Обложка для соцсетей: кадр интерьера клиники, обрезанный под 1200×630 —
   размер превью ссылки во ВКонтакте, Telegram и мессенджерах. Отдельного
   баннера у клиники пока нет; появится — достаточно заменить файл.
   Размеры отдаём только для неё: чужой картинке они бы не подошли. */
const OG_FALLBACK = 'og-cover.jpg';
const image = absolute(ogImage ?? OG_FALLBACK, site);
const imageSize = ogImage ? null : { width: 1200, height: 630 };

const address: Record<string, string> = {
  '@type': 'PostalAddress',
  streetAddress: clinic.address.street,
  addressLocality: clinic.address.locality,
  addressRegion: clinic.address.region,
  addressCountry: clinic.address.country,
};
if (clinic.address.postalCode) address.postalCode = clinic.address.postalCode;

/* sameAs связывает сайт с карточками в справочниках. Для локального
   поиска это главный сигнал «сайт и организация на картах — одно и то
   же»: по нему Яндекс и Google подтягивают отзывы и рейтинг. */
const sameAs = [
  clinic.links.yandexOrg,
  clinic.links.vk,
  clinic.links.telegram,
  clinic.links.twoGis,
  clinic.links.googleMaps,
  clinic.links.prodoctorov,
  clinic.links.zoon,
].filter(Boolean);

const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  '@id': clinicId(site),
  name: clinic.name,
  description: clinic.description,
  url: root,
  telephone: clinic.phoneE164,
  email: clinic.email,
  image,
  /* Логотип — объектом, а не голой ссылкой: так его понимают и Google
     (панель знаний), и Яндекс, а поле можно расширить размерами. */
  logo: { '@type': 'ImageObject', url: absolute('logo-dentalcruise.svg', site) },
  address,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: clinic.geo.lat,
    longitude: clinic.geo.lng,
  },
  hasMap: clinic.links.yandexPin,
  openingHoursSpecification: clinic.openingHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  priceRange: '₽₽',
  currenciesAccepted: 'RUB',
  paymentAccepted: 'Наличные, банковская карта, рассрочка',
  medicalSpecialty: 'Dentistry',
  /* Ближайшее метро — сильный локальный запрос: «стоматология
     Полежаевская» ищут чаще, чем по улице. */
  publicAccess: true,
  areaServed: [
    { '@type': 'City', name: clinic.address.locality },
    ...clinic.metroStations.map((s) => ({ '@type': 'Place', name: `м. ${s.name}` })),
  ],
  /* aggregateRating намеренно не отдаём: рейтинг, проставленный самой
     организацией, Google и Яндекс считают самооценкой и могут наказать
     за разметку; реальный рейтинг они берут из карточки на Картах. */
};
if (sameAs.length > 0) business.sameAs = sameAs;

/* Сайт как отдельная сущность рядом с организацией: по `WebSite` поисковик
   берёт название сайта для сниппета и связывает его с владельцем через
   тот же `@id` клиники. */
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${root}#website`,
  name: clinic.name,
  url: root,
  inLanguage: 'ru-RU',
  publisher: { '@id': clinicId(site) },
};

const faqSchema =
  faq && faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;

const crumbSchema = breadcrumbs && breadcrumbs.length > 0 ? breadcrumbSchema(breadcrumbs, site) : null;

/* Организацию и сайт описываем только на главной. На внутренних страницах
   хватает ссылки по `@id` из блоков врача и услуги: дубль полной карточки
   на каждой странице поисковику ничего не добавляет, а вес размывает. */
const isHome = path === '/' || path === '';
const blocks = [
  isHome ? business : null,
  isHome ? website : null,
  crumbSchema,
  faqSchema,
  ...schema,
].filter(Boolean) as Record<string, unknown>[];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/* Открытой странице — права на индексацию для конкретных роботов: без
    них Яндекс по умолчанию сокращает сниппет и не показывает быстрые
    ссылки. Закрытой (и всему staging) — noindex без исключений. */}
<meta
  name="robots"
  content={indexable ? 'index, follow, max-snippet:-1, max-image-preview:large' : 'noindex, nofollow'}
/>

{/* Подтверждение прав на сайт. Коды выдают Вебмастер и Search Console,
    владелец вставляет их в редакторе — раздел «SEO». */}
{seo.verification.yandex && <meta name="yandex-verification" content={seo.verification.yandex} />}
{seo.verification.google && <meta name="google-site-verification" content={seo.verification.google} />}
{seo.verification.mailru && <meta name="mailru-verification" content={seo.verification.mailru} />}

{/* Гео-теги: устаревший, но всё ещё читаемый рядом справочников способ
    сказать, к какому городу относится сайт. */}
<meta name="geo.region" content="RU-MOW" />
<meta name="geo.placename" content={clinic.address.locality} />
<meta name="geo.position" content={`${clinic.geo.lat};${clinic.geo.lng}`} />
<meta name="ICBM" content={`${clinic.geo.lat}, ${clinic.geo.lng}`} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={clinic.name} />
<meta property="og:locale" content="ru_RU" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
{imageSize && <meta property="og:image:width" content={String(imageSize.width)} />}
{imageSize && <meta property="og:image:height" content={String(imageSize.height)} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{blocks.map((block) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
))}
