<script is:inline>
  // Скрипт стоит сразу за разметкой и выполняется синхронно — до первой
  // отрисовки. Иначе на возврате из внутренней страницы заставка успела бы
  // моргнуть кадром, прежде чем её убрали.
  (function () {
    var el = document.querySelector('[data-preloader]');
    if (!el) return;
    var seen = false;
    try {
      seen = sessionStorage.getItem('dc-preloader-seen') === '1';
      sessionStorage.setItem('dc-preloader-seen', '1');
    } catch (e) {
      // Приватный режим — просто показываем заставку каждый раз
    }
    if (seen) {
      el.remove();
      return;
    }
    // Точка отсчёта для BaseLayout: анимация стартует с отрисовкой элемента,
    // а модульный скрипт выполняется на сотни миллисекунд позже.
    window.__dcPreloaderStart = performance.now();
  })();
</script>

<style>
  .dc-preloader {
    --ink: var(--dc-depths);
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(
      ellipse at 50% 40%,
      var(--dc-white) 0%,
      var(--dc-seashell) 55%,
      var(--dc-mist) 100%
    );
    color: var(--ink);
    opacity: 1;
    transition: opacity 450ms var(--ease-out);
  }
  .dc-preloader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  /* :global — иначе Astro повесит cid-атрибут и на <html>, где его нет */
  :global(.no-js) .dc-preloader {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-preloader {
      transition: opacity 200ms linear;
    }
  }

  .dental-loader *, .dental-loader *::before, .dental-loader *::after { box-sizing: border-box; }
  .loader-content { position: relative; width: min(100%, 700px); padding: 52px 20px; text-align: center; }
  .sculpture { width: min(100%, 570px); margin: 20px auto -10px; }
  .dental-model { display: block; width: 100%; overflow: visible; }
  .ground-shadow { fill: #0E5566; opacity: .14; filter: blur(12px); transform-origin: 300px 370px; animation: shadow-breathe 5.8s ease-in-out infinite; }
  .jaw { animation: model-float 5.8s ease-in-out infinite; }
  .plaster-side { fill: #d5e2e2; stroke: #c2d5d7; stroke-width: 1; }
  .plaster-top { fill: #FAF7F5; stroke: #FFFFFF; stroke-width: 2; }
  .plaster-inner { fill: #9bbdc1; opacity: .65; }
  .plaster-edge { stroke: #FFFFFF; stroke-width: 2; opacity: .65; }
  .socket { fill: #007C88; opacity: .58; }
  .tooth-flight { transform-box: fill-box; transform-origin: center; animation: tooth-dance 5.8s cubic-bezier(.45,0,.2,1) infinite; animation-delay: var(--delay); }
  .tooth-side { fill: #e5eeec; stroke: #b6cccb; stroke-width: .7; }
  .tooth-front { fill: #cfdfdd; }
  .tooth-crown { fill: #FFFFFF; stroke: #d5e5e0; stroke-width: 1; }
  .tooth-ridge { stroke: #9bbfbb; stroke-width: 1.5; stroke-linecap: round; opacity: .7; }
  .tooth-shine { stroke: white; stroke-width: 2; stroke-linecap: round; }
  .loader-title { margin: 0; font-family: var(--font-display); font-weight: var(--fw-black); font-size: clamp(26px, 4.6vw, 38px); line-height: 1.25; letter-spacing: var(--ls-display); color: var(--text-strong); }
  .loader-progress { width: 108px; height: 2px; margin: 29px auto 16px; overflow: hidden; background: #E8F5F1; border-radius: 2px; }
  .loader-progress span { display: block; height: 100%; width: 40%; background: #00B189; animation: progress-travel 2.4s ease-in-out infinite; }
  .loader-orbit { position: absolute; z-index: -1; width: min(82vw, 950px); aspect-ratio: 1; border: 1px solid #007C8810; border-radius: 50%; pointer-events: none; }
  .orbit-one { transform: translate(-37%, -5%); }
  .orbit-two { transform: translate(37%, 5%); }
  @keyframes tooth-dance {
    0%, 8%, 92%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(var(--drift), -82px) rotate(calc(var(--turn) * -1)); }
    52% { transform: translate(var(--drift), -112px) rotate(360deg); }
    68% { transform: translate(0, -37px) rotate(355deg); }
    79% { transform: translate(0, 2px) rotate(360deg); }
    83% { transform: translate(0, -2px) rotate(360deg); }
    88% { transform: translate(0, 0) rotate(360deg); }
    88.01% { transform: translate(0, 0) rotate(0deg); }
  }
  @keyframes model-float { 0%,100% { transform: translateY(0); } 48% { transform: translateY(-7px); } }
  @keyframes shadow-breathe { 0%,100% { transform: scaleX(1); opacity: .14; } 48% { transform: scaleX(.9); opacity: .09; } }
  @keyframes progress-travel { 0% { transform: translateX(-110%); } 100% { transform: translateX(360%); } }
  @media (max-width: 480px) { .loader-content { padding: 36px 16px; } .sculpture { margin-top: 35px; margin-bottom: 12px; } }
  @media (prefers-reduced-motion: reduce) {
    .dental-loader *, .dental-loader *::before, .dental-loader *::after { animation: none !important; }
    .loader-progress span { width: 100%; opacity: .55; }
  }
</style>
