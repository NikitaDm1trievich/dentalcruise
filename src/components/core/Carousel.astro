---
/**
 * Карусель: лента слайдов на CSS scroll-snap, стрелки, точки, свайп и
 * клавиши (lib/carousel.ts). Слайды — прямые потомки в слоте, каждый с
 * `data-slide`, `role="group"`, `aria-roledescription="slide"` и подписью.
 * Без JS слайды идут друг под другом.
 */
import { servicePage } from '../../data/pages';

const copy = servicePage.carousel;

interface Props {
  /** Название карусели для чтения с экрана */
  label: string;
  /** Подписи слайдов для точек; пусто — точек нет, только стрелки */
  dots?: string[];
  /** `text` — точка с подписью, `number` — кружок с номером (подпись в aria-label) */
  dotStyle?: 'text' | 'number';
  /** Слайдов в ряду на экране шире 700 px */
  perView?: 1 | 2;
  /** Подгонять высоту ленты под видимый слайд */
  adaptHeight?: boolean;
  prev?: string;
  next?: string;
  class?: string;
}

const {
  label,
  dots = [],
  dotStyle = 'text',
  perView = 1,
  adaptHeight = true,
  prev = copy.prev,
  next = copy.next,
  class: className,
} = Astro.props;
---

<div
  class:list={['dc-car', className]}
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
  style={`--car-pv:${perView}`}
  data-carousel
  data-adapt={adaptHeight ? '' : undefined}
>
  <div class="dc-car__track" data-car-track>
    <slot />
  </div>
  <div class="dc-car__nav" hidden data-car-nav>
    <button type="button" class="dc-car__arrow" aria-label={prev} data-car-prev>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <div class="dc-car__dots">
      {
        dots.map((d, i) => (
          <button
            type="button"
            class:list={['dc-car__dot', dotStyle === 'number' && 'dc-car__dot--num']}
            aria-label={dotStyle === 'number' ? d : undefined}
            title={dotStyle === 'number' ? d : undefined}
            data-car-dot
          >
            {dotStyle === 'number' ? i + 1 : d}
          </button>
        ))
      }
    </div>
    <button type="button" class="dc-car__arrow" aria-label={next} data-car-next>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
</div>

<style>
  .dc-car {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  /* Без JS: слайды друг под другом */
  .dc-car__track {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .dc-car.is-carousel > .dc-car__track {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .dc-car.is-carousel > .dc-car__track::-webkit-scrollbar {
    display: none;
  }
  .dc-car.is-carousel > .dc-car__track:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .dc-car.is-carousel > .dc-car__track > :global([data-slide]) {
    flex: 0 0 100%;
    box-sizing: border-box;
    scroll-snap-align: start;
    min-width: 0;
    /* Высоту ленты задаёт скрипт; слишком высокий слайд прокручивается внутри */
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior-y: auto;
  }
  .dc-car.is-carousel > .dc-car__track > :global([data-slide]:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }
  /* Украшения между слайдами («+») нужны только в вертикальном ряду */
  .dc-car.is-carousel > .dc-car__track > :global(:not([data-slide])) {
    display: none;
  }
  @media (min-width: 700px) {
    .dc-car.is-carousel > .dc-car__track > :global([data-slide]) {
      flex-basis: calc((100% - (var(--car-pv) - 1) * var(--space-3)) / var(--car-pv));
    }
  }
  .dc-car__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .dc-car__nav[hidden] {
    display: none;
  }
  .dc-car__dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .dc-car__dot {
    min-height: 44px;
    padding: 0 clamp(var(--space-3), 3vw, var(--space-4));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-strong);
    font: inherit;
    font-size: var(--type-small);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .dc-car__dot--num {
    min-width: 44px;
    padding: 0;
  }
  .dc-car__dot[aria-current='true'] {
    background: var(--surface-card);
    border-color: var(--dc-turquoise-ink);
    color: var(--text-accent);
    font-weight: var(--fw-bold);
  }
  .dc-car__arrow {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--surface-card);
    color: var(--text-strong);
    cursor: pointer;
  }
  .dc-car__arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .dc-car__dot:focus-visible,
  .dc-car__arrow:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-car__dot {
      transition: none;
    }
  }
</style>

<script>
  import { initCarousels } from '../../lib/carousel';
  initCarousels();
</script>
