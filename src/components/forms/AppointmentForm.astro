---
/**
 * Заявка на приём. Уходит POST-запросом на Cloudflare Worker,
 * который пересылает её в Telegram-бота (токен — секрет Worker'а).
 *
 * Адрес эндпоинта задаётся переменной PUBLIC_BOOKING_ENDPOINT (.env).
 * Пока она не задана, форма честно предлагает позвонить, а не делает вид,
 * что заявка ушла.
 *
 * Проверка полей своя, а не браузерная (novalidate): нативные подсказки
 * исчезают через несколько секунд и не читаются скринридером вместе
 * с полем. Ошибка живёт под полем и связана с ним через aria-describedby.
 */
import Button from '../core/Button.astro';
import Icon from '../core/Icon.astro';
import BrandIcon from '../core/BrandIcon.astro';
import { clinic } from '../../data/site';
import { pageHref } from '../../lib/asset';

const endpoint = import.meta.env.PUBLIC_BOOKING_ENDPOINT ?? '';
---

<form class="dc-form" data-booking-form data-endpoint={endpoint} novalidate>
  <div class="dc-field">
    <label for="dc-name">Ваше имя</label>
    <input id="dc-name" name="name" type="text" required autocomplete="name" maxlength="80" />
    <p class="dc-field__error" id="dc-name-error" hidden></p>
  </div>

  <div class="dc-field">
    <label for="dc-contact">Телефон</label>
    <!-- maxlength с запасом к маске: вставка «+7 (925) 577-76-77» не должна обрезаться до форматирования -->
    <input
      id="dc-contact"
      name="contact"
      type="tel"
      required
      autocomplete="tel"
      inputmode="tel"
      maxlength="40"
      placeholder="+7 900 000-00-00"
      aria-describedby="dc-contact-hint"
    />
    <p class="dc-field__error" id="dc-contact-error" hidden></p>
    <span class="dc-field__hint" id="dc-contact-hint">Перезвоним или напишем в Max</span>
  </div>

  <div class="dc-field">
    <label for="dc-comment">Что беспокоит (необязательно)</label>
    <textarea id="dc-comment" name="comment" rows="3" maxlength="600"></textarea>
  </div>

  <!-- Ловушка для ботов: живой человек это поле не увидит и не заполнит -->
  <div class="dc-honeypot" aria-hidden="true">
    <label for="dc-website">Не заполняйте это поле</label>
    <input id="dc-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <!-- Откуда пришла заявка: адрес страницы с utm-метками и реферер. Заполняет скрипт перед отправкой -->
  <input type="hidden" name="page" />
  <input type="hidden" name="referrer" />

  <div class="dc-consent">
    <label class="dc-checkbox">
      <input id="dc-consent" type="checkbox" name="consent" required />
      <span class="dc-checkbox__box" aria-hidden="true">
        <Icon name="check" size={18} strokeWidth={3} />
      </span>
      <!-- Ссылка внутри label: клик по интерактивному потомку по спецификации
           не переключает чекбокс, а Tab доходит до ссылки как до любой другой -->
      <span>
        Согласен на обработку персональных данных —
        <a href={pageHref('privacy')} target="_blank" rel="noopener">политика конфиденциальности</a>
      </span>
    </label>
    <p class="dc-field__error" id="dc-consent-error" hidden></p>
  </div>

  <Button type="submit" variant="primary" size="lg" fullWidth>Оставить заявку</Button>

  <p class="dc-form__error" data-form-error hidden role="alert"></p>

  <p class="dc-form__fallback">
    Или просто позвоните: <a href={clinic.phoneHref}>{clinic.phone}</a>
  </p>
</form>

<div class="dc-form-done" data-booking-done hidden tabindex="-1" role="status" aria-live="polite">
  <Icon name="circle-check" size={34} color="var(--text-accent)" />
  <h3>Заявка отправлена</h3>
  <p>Перезвоним в рабочее время — {clinic.scheduleShort}.</p>
  <div class="dc-form-done__actions">
    <Button href={clinic.phoneHref} variant="primary">
      <Icon slot="icon" name="phone" size={20} />
      Позвонить
    </Button>
    {
      clinic.links.max && (
        <Button href={clinic.links.max} variant="secondary" target="_blank" rel="noopener">
          <BrandIcon slot="icon" name="max" size={20} />
          Написать в Max
        </Button>
      )
    }
  </div>
</div>

<style>
  .dc-form {
    display: grid;
    gap: var(--space-4);
  }
  .dc-field {
    display: grid;
    gap: var(--space-2);
  }
  .dc-field label {
    font-family: var(--font-body);
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    color: var(--text-strong);
  }
  .dc-field input,
  .dc-field textarea {
    min-height: var(--tap-min);
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: var(--type-body);
    color: var(--text-strong);
    background: var(--surface-card);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    outline-offset: 2px;
    width: 100%;
    resize: vertical;
  }
  /* Невалидность ставит скрипт, а не браузер: :user-invalid сработал бы
     от одного required и подсветил бы поле без объяснения */
  .dc-field input[aria-invalid='true'],
  .dc-field textarea[aria-invalid='true'] {
    border-color: var(--dc-coral);
  }
  .dc-field__hint {
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .dc-field__error,
  .dc-form__error {
    color: var(--dc-coral);
    font-size: var(--type-small);
    font-weight: var(--fw-semibold);
  }

  .dc-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .dc-consent {
    display: grid;
    gap: var(--space-2);
  }
  .dc-checkbox {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    cursor: pointer;
    font-size: var(--type-small);
    color: var(--text-body);
    line-height: var(--lh-body);
  }
  .dc-checkbox a {
    font-weight: var(--fw-semibold);
  }
  .dc-checkbox input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .dc-checkbox__box {
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--surface-card);
    border: 2px solid var(--line-strong);
    color: transparent;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .dc-checkbox input:checked + .dc-checkbox__box {
    background: var(--cta-bg);
    border-color: var(--cta-bg);
    color: var(--cta-fg);
  }
  .dc-checkbox input[aria-invalid='true'] + .dc-checkbox__box {
    border-color: var(--dc-coral);
  }
  .dc-checkbox input:focus-visible + .dc-checkbox__box {
    outline: 2px solid var(--dc-depths);
    outline-offset: 2px;
  }

  .dc-form__fallback {
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .dc-form__fallback a {
    font-weight: var(--fw-bold);
  }

  .dc-form-done {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-6);
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-inset-line);
  }
  .dc-form-done h3 {
    font-size: var(--type-h3);
  }
  .dc-form-done p {
    color: var(--text-body);
  }
  .dc-form-done__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>

<script>
  import { maskPhone, phoneToE164 } from '../../lib/phone';

  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
  const done = document.querySelector<HTMLElement>('[data-booking-done]');
  const error = document.querySelector<HTMLElement>('[data-form-error]');
  const nameField = form?.querySelector<HTMLInputElement>('#dc-name');
  const phoneField = form?.querySelector<HTMLInputElement>('#dc-contact');
  const consentField = form?.querySelector<HTMLInputElement>('#dc-consent');

  const GENERIC_ERROR = 'Не удалось отправить заявку. Попробуйте ещё раз или позвоните нам.';

  /** Ошибка формы целиком: сеть, сервер, неподключённый эндпоинт */
  const fail = (message: string) => {
    if (!error) return;
    error.textContent = message;
    error.hidden = false;
  };

  const describedBy = (field: HTMLElement) =>
    (field.getAttribute('aria-describedby') ?? '').split(' ').filter(Boolean);

  /** Ошибка под полем: текст, aria-invalid и связь с полем через aria-describedby */
  const setFieldError = (field: HTMLInputElement, message: string) => {
    const box = document.getElementById(`${field.id}-error`);
    if (!box) return;
    box.textContent = message;
    box.hidden = false;
    field.setAttribute('aria-invalid', 'true');
    // Ошибку ставим первой, чтобы скринридер прочитал её раньше подсказки
    const ids = describedBy(field).filter((id) => id !== box.id);
    field.setAttribute('aria-describedby', [box.id, ...ids].join(' '));
  };

  const clearFieldError = (field: HTMLInputElement) => {
    const box = document.getElementById(`${field.id}-error`);
    if (!box || box.hidden) return;
    box.hidden = true;
    field.removeAttribute('aria-invalid');
    const ids = describedBy(field).filter((id) => id !== box.id);
    if (ids.length) field.setAttribute('aria-describedby', ids.join(' '));
    else field.removeAttribute('aria-describedby');
  };

  if (form && nameField && phoneField && consentField) {
    // Маска телефона: форматируем значение целиком и возвращаем каретку на место
    let prevPhone = phoneField.value;
    phoneField.addEventListener('input', (event) => {
      const caret = phoneField.selectionStart ?? phoneField.value.length;
      const masked = maskPhone(phoneField.value, caret, {
        prev: prevPhone,
        inputType: (event as InputEvent).inputType,
      });
      phoneField.value = masked.value;
      phoneField.setSelectionRange(masked.caret, masked.caret);
      prevPhone = masked.value;
    });

    // Ошибка снимается, как только пользователь взялся исправлять поле
    nameField.addEventListener('input', () => clearFieldError(nameField));
    phoneField.addEventListener('input', () => clearFieldError(phoneField));
    consentField.addEventListener('change', () => clearFieldError(consentField));

    let sending = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      if (error) error.hidden = true;

      // Своя проверка вместо reportValidity: сообщения под полями, фокус на первом невалидном
      const phone = phoneToE164(phoneField.value);
      const problems: Array<[HTMLInputElement, string]> = [];
      if (nameField.value.trim().length < 2) {
        problems.push([nameField, 'Укажите имя — не короче двух букв']);
      }
      if (!phone) problems.push([phoneField, 'Введите номер в формате +7 900 000-00-00']);
      if (!consentField.checked) {
        problems.push([consentField, 'Нужно согласие на обработку персональных данных']);
      }
      const first = problems[0];
      if (first) {
        problems.forEach(([field, message]) => setFieldError(field, message));
        first[0].focus();
        return;
      }

      if (!navigator.onLine) {
        fail('Нет соединения. Проверьте интернет или позвоните нам.');
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        fail('Форма пока не подключена к серверу. Позвоните нам — ответим сразу.');
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = submit?.textContent;
      sending = true;
      form.setAttribute('aria-busy', 'true');
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Отправляем…';
      }

      // Откуда пришла заявка — адрес с utm-метками и реферер
      const pageField = form.querySelector<HTMLInputElement>('input[name="page"]');
      const referrerField = form.querySelector<HTMLInputElement>('input[name="referrer"]');
      if (pageField) pageField.value = location.href;
      if (referrerField) referrerField.value = document.referrer;

      try {
        // В JSON поле остаётся `contact`, но уже в E.164 — воркер деплоится отдельно от сайта
        const payload = { ...Object.fromEntries(new FormData(form).entries()), contact: phone };
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          // Зависший запрос не должен держать «Отправляем…» вечно.
          // AbortSignal.timeout появился в Safari 16 — без него просто без таймаута.
          signal: 'timeout' in AbortSignal ? AbortSignal.timeout(10_000) : undefined,
        });
        const data: { error?: unknown } | null = await response.json().catch(() => null);

        if (response.ok) {
          form.hidden = true;
          if (done) {
            done.hidden = false;
            // aria-live один не гарантирует объявление — переносим фокус явно
            done.focus();
          }
          return;
        }
        // Воркер отвечает { ok: false, error }: лимит частоты, неполный номер — текст показываем как есть
        fail(typeof data?.error === 'string' && data.error ? data.error : GENERIC_ERROR);
      } catch (err) {
        const timedOut = err instanceof DOMException && err.name === 'TimeoutError';
        fail(timedOut ? 'Сервер не ответил. Попробуйте ещё раз или позвоните нам.' : GENERIC_ERROR);
      } finally {
        sending = false;
        form.removeAttribute('aria-busy');
        if (submit) {
          submit.disabled = false;
          submit.textContent = label ?? 'Оставить заявку';
        }
      }
    });
  }
</script>
