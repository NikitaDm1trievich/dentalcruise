---
/** Модалка записи. Перенесено из Ds2_2d9e23.AppointmentModal. */
import Icon from '../core/Icon.astro';
import IconButton from '../core/IconButton.astro';
import AppointmentForm from './AppointmentForm.astro';
import { form } from '../../data/ui';
import { cmsSite } from '../../lib/cms-ref';
---

<div class="dc-modal" id="dc-book" data-state="closed" aria-hidden="true" inert data-picked-comment={form.pickedComment}>
  <div class="dc-modal__scrim" data-close></div>

  <div
    class="dc-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="dc-book-title"
    data-cms={cmsSite('form')}
  >
    <div class="dc-modal__head">
      <div>
        <h2 id="dc-book-title">{form.title}</h2>
        <p>{form.lead}</p>
        {/* Запись из подбора по проблеме: жалоба видна сразу, а не только
            в поле комментария внизу формы, за краем экрана телефона */}
        <p class="dc-modal__picked" hidden data-book-picked>
          <span data-cms={cmsSite('form', 'picked')}>{form.picked}</span>
          <b data-book-picked-text></b>
        </p>
      </div>
      <IconButton label="Закрыть" variant="bare" data-close>
        <Icon name="x" size={24} />
      </IconButton>
    </div>

    <AppointmentForm />
  </div>
</div>

<style>
  .dc-modal {
    --dc-modal-gap: var(--gutter);
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    /* Диалог короче экрана центрируется; диалог выше экрана начинается
       сверху и не обрезается: ряд грида, не влезающий в контейнер,
       прижимается к его началу */
    place-items: center;
    padding: var(--dc-modal-gap) var(--dc-modal-gap)
      max(var(--dc-modal-gap), env(safe-area-inset-bottom));
    /* Диалог выше экрана (телефон, тем более с клавиатурой) прокручивается
       вместе с подложкой, как страница: обрез контента приходится на край
       экрана, а низ карточки со скруглением и отступом дорисовывается целиком.
       Скролл внутри самого диалога резал строку с телефоном у скруглённого
       низа — выглядело обрывом, а не «дальше есть ещё». */
    overflow-y: auto;
    /* Иначе скролл модалки на телефоне протекает на страницу под ней */
    overscroll-behavior: contain;
    pointer-events: none;
  }
  .dc-modal[data-state='open'] {
    pointer-events: auto;
  }
  .dc-modal__scrim {
    /* fixed, а не absolute: подложка не должна уезжать вместе со скроллом модалки */
    position: fixed;
    inset: 0;
    background: rgba(2, 32, 41, 0.62);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out);
  }
  .dc-modal[data-state='open'] .dc-modal__scrim {
    opacity: 1;
  }

  .dc-modal__dialog {
    position: relative;
    width: min(520px, 100%);
    background: var(--surface-page);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition:
      transform var(--dur-mid) var(--ease-out),
      opacity var(--dur-mid) var(--ease-out);
  }
  .dc-modal[data-state='open'] .dc-modal__dialog {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .dc-modal__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .dc-modal__head h2 {
    font-size: var(--type-h2);

    letter-spacing: var(--ls-display);
    margin-bottom: var(--space-2);
  }
  .dc-modal__head p {
    color: var(--text-body);
  }
  .dc-modal__head .dc-modal__picked {
    margin-top: var(--space-3);
    padding: 8px 12px;
    border-radius: var(--radius-md);
    background: var(--surface-quiet);
    box-shadow: inset 0 0 0 1px var(--dc-turquoise-soft);
    font-size: var(--type-small);
    line-height: 1.35;
    color: var(--text-muted);
  }
  .dc-modal__picked b {
    color: var(--text-accent);
  }

  /* На телефоне отступы теснее: в экран помещается больше формы, скроллить меньше */
  @media (max-width: 480px) {
    .dc-modal {
      --dc-modal-gap: var(--space-4);
    }
    .dc-modal__dialog {
      padding: var(--space-6);
    }
  }
</style>

<script>
  /**
   * Кнопка записи с `data-book-topic` (подбор по проблеме на главной)
   * открывает форму с выбранной жалобой: строкой под заголовком и текстом в
   * поле комментария. Обычная кнопка «Записаться» убирает строку и стирает
   * комментарий, только если его вписал сайт, а не человек.
   */
  const modal = document.getElementById('dc-book');
  const picked = modal?.querySelector<HTMLElement>('[data-book-picked]');
  const pickedText = modal?.querySelector<HTMLElement>('[data-book-picked-text]');
  const comment = modal?.querySelector<HTMLTextAreaElement>('#dc-comment');
  let autoComment = '';

  document.addEventListener(
    'click',
    (event) => {
      const opener = (event.target as HTMLElement).closest<HTMLElement>('[data-open="dc-book"]');
      if (!opener || !modal || !picked || !pickedText || !comment) return;
      const topic = opener.dataset.bookTopic?.trim() ?? '';
      picked.hidden = !topic;
      pickedText.textContent = topic;
      if (topic) {
        if (!comment.value || comment.value === autoComment) {
          autoComment = `${modal.dataset.pickedComment ?? ''} ${topic}`.trim();
          comment.value = autoComment;
        }
      } else if (comment.value === autoComment) {
        comment.value = '';
        autoComment = '';
      }
    },
    // Раньше обработчика оверлеев: окно открывается уже с нужным текстом
    true,
  );
</script>
