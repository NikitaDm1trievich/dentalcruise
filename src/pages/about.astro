---
import StubLayout from '../layouts/StubLayout.astro';
import { aboutPage as page } from '../data/pages';
import { cmsPage } from '../lib/cms-ref';
---

{/* Заглушка «раздел готовится» — в индексе ей делать нечего. Открыть для
    индексации (убрать noindex) и вернуть в sitemap (astro.config.mjs),
    когда раздел наполнится. Тексты — в редакторе, «Страницы сайта». */}
<StubLayout
  title={page.seo.title}
  description={page.seo.description}
  path="/about"
  noindex
  eyebrow={page.eyebrow}
  heading={page.heading}
  lead={page.lead}
  cms={cmsPage('about')}
/>
