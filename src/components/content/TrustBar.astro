---
/** Полоса доверия перед подвалом. Из Ds2_2d9e23.TrustBar. */
import Icon from '../core/Icon.astro';

interface Props {
  items: { id: string; title: string; text: string; icon: string; href?: string; opensLicense: boolean }[];
  tone?: 'light' | 'dark';
}
const { items, tone = 'light' } = Astro.props;
---

<div class:list={['dc-trust', tone === 'dark' && 'dc-trust--dark']}>
  <div class="dc-trust__grid">
    {
      items.map((item) => {
        const attrs = item.opensLicense
          ? { 'data-open': 'dc-license', type: 'button' as const }
          : {};
        const Tag = item.opensLicense ? 'button' : item.href ? 'a' : 'div';
        return (
          <Tag
            class="dc-trust__card"
            href={!item.opensLicense && item.href ? item.href : undefined}
            target={!item.opensLicense && item.href ? '_blank' : undefined}
            rel={!item.opensLicense && item.href ? 'noopener' : undefined}
            {...attrs}
          >
            <Icon
              name={item.icon}
              size={30}
              strokeWidth={1.6}
              color={tone === 'dark' ? 'var(--dc-turquoise)' : 'var(--text-accent)'}
            />
            <span class="dc-trust__title">{item.title}</span>
            <span class="dc-trust__text">{item.text}</span>
          </Tag>
        );
      })
    }
  </div>
</div>

<style>
  .dc-trust {
    background: var(--surface-quiet);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }
  .dc-trust--dark {
    background: var(--surface-dark);
  }
  .dc-trust__grid {
    display: grid;
    gap: var(--space-5);
    /* min(100%, …): на 320px колонка уже 240px, и без этого единственный
       трек вылезал за край полосы — горизонтальный скролл страницы. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .dc-trust__card {
    min-width: 0;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
    text-align: left;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--text-body);
    font-family: var(--font-body);
  }
  button.dc-trust__card,
  a.dc-trust__card {
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  button.dc-trust__card:hover,
  a.dc-trust__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: var(--text-body);
  }
  .dc-trust--dark .dc-trust__card {
    background: var(--surface-dark-lift);
    border-color: var(--line-on-dark);
    box-shadow: none;
    color: var(--text-on-dark);
  }
  .dc-trust__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--type-h4);
    color: var(--text-strong);
  }
  .dc-trust--dark .dc-trust__title {
    color: var(--text-on-dark);
  }
  .dc-trust__text {
    color: var(--text-muted);
    font-size: var(--type-small);
  }
  .dc-trust--dark .dc-trust__text {
    color: var(--text-on-dark-muted);
  }

  /* На телефоне три карточки по 250px в столбик — слишком много для
     полублока. Складываем каждую в компактный ряд: иконка слева, заголовок
     и текст справа. Размер текста не уменьшаем — 15px и так нижняя граница
     для сайта; заголовок берём размером с основной текст. */
  @media (max-width: 559.98px) {
    .dc-trust {
      padding: var(--space-4);
    }
    .dc-trust__grid {
      gap: var(--space-3);
    }
    .dc-trust__card {
      grid-template-columns: auto 1fr;
      column-gap: var(--space-3);
      row-gap: var(--space-1);
      padding: var(--space-4);
    }
    /* svg приходит из Icon — у него своя область видимости стилей */
    .dc-trust__card > :global(.dc-icon) {
      grid-row: 1 / span 2;
      align-self: start;
      width: 26px;
      height: 26px;
      margin-top: 1px;
    }
    .dc-trust__title {
      font-size: var(--type-body);
      line-height: var(--lh-heading);
    }
    .dc-trust__text {
      grid-column: 2;
    }
  }
</style>
