---
/**
 * Три слоя волн, дрейфующих с разной скоростью — фирменный мотив бренда.
 * Перенесено из Ds2_2d9e23.WaveField.
 *
 * Каждый слой обёрнут в div: сдвиг от прокрутки вешается на обёртку, а
 * дрейф по времени остаётся на svg — так две анимации не перетирают
 * transform друг друга (и transform в процентах на самом svg Chrome
 * считает неверно).
 *
 * Контур каждой волны продлён вниз за viewBox (до y=400, svg с
 * overflow: visible): в покое лишнее срезает overflow полосы, а когда слой
 * поднимается от прокрутки, под волной нет щели. Заливка одной фигурой,
 * а не отдельным блоком — на стыке не остаётся шва от сглаживания.
 *
 * scrollDrift — полоса-перебивка между секциями: дрейф по времени
 * выключен, слои при прокрутке расходятся по горизонтали с разной
 * скоростью. Профиль слоёв как в утверждённом демо «Прилив»: первый
 * (серый) самый высокий, последний — цвет следующей секции — самый низкий.
 */
interface Props {
  colors?: [string, string, string];
  height?: number;
  /** Фон под волнами — цвет секции сверху, нужен полосе-перебивке */
  background?: string;
  scrollDrift?: boolean;
  class?: string;
}

const {
  colors = ['rgba(194,204,196,.55)', 'rgba(143,162,172,.75)', 'var(--dc-depths)'],
  height = 180,
  background,
  scrollDrift = false,
  class: className,
} = Astro.props;

const PATHS = [
  'M0,60 C180,110 360,10 540,60 C720,110 900,10 1080,60 C1260,110 1440,10 1620,60 L1620,400 L0,400 Z',
  'M0,80 C240,20 480,130 720,80 C960,30 1200,130 1440,80 C1560,55 1620,70 1620,70 L1620,400 L0,400 Z',
  'M0,100 C200,150 400,60 600,100 C800,140 1000,60 1200,100 C1400,140 1520,80 1620,100 L1620,400 L0,400 Z',
];
const SPEEDS = ['var(--dur-wave-1)', 'var(--dur-wave-2)', 'var(--dur-wave-3)'];
const layerHeight = (i: number) =>
  Math.round(scrollDrift ? height * (0.96 - i * 0.2) : height * (0.72 + i * 0.14));
---

<div
  aria-hidden="true"
  class:list={['dc-waves', { 'dc-waves--scroll-drift': scrollDrift }, className]}
  style={`height:${height}px${background ? `;background:${background}` : ''}`}
>
  {
    PATHS.map((d, i) => (
      <div class="dc-waves__layer">
        <svg
          viewBox="0 0 1620 160"
          preserveAspectRatio="none"
          style={`height:${layerHeight(i)}px${scrollDrift ? '' : `;animation-duration:${SPEEDS[i]}`}`}
        >
          <path d={d} fill={colors[i]} />
        </svg>
      </div>
    ))
  }
</div>

<style>
  .dc-waves {
    position: relative;
    overflow: hidden;
    pointer-events: none;
  }
  .dc-waves__layer {
    position: absolute;
    inset: 0;
  }
  .dc-waves svg {
    position: absolute;
    bottom: 0;
    /* Полосы шире экрана с двух сторон, чтобы дрейф не обнажал край (правка макета) */
    width: 130vw;
    max-width: none;
    left: -15vw;
    overflow: visible;
    animation-name: dc-wave-drift;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }
  /* Перебивке дрейф по времени не нужен — её двигает прокрутка */
  .dc-waves--scroll-drift svg {
    animation: none;
  }
  @keyframes dc-wave-drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-6%, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-waves svg {
      animation: none;
    }
  }

  /* Слои расходятся по горизонтали, пока полоса проходит экран (±2/±5/±9%).
     Без поддержки animation-timeline полоса просто стоит. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .dc-waves--scroll-drift {
        view-timeline: --dc-wave-band block;
      }
      .dc-waves--scroll-drift .dc-waves__layer {
        --wave-shift: 2%;
        animation-name: dc-wave-scroll-drift;
        /* Равномерно, как в одобренном демо: с --ease-swell полоса «въезжала и замирала» */
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-duration: auto;
        animation-timeline: --dc-wave-band;
        will-change: transform;
      }
      .dc-waves--scroll-drift .dc-waves__layer:nth-child(2) {
        --wave-shift: 5%;
      }
      .dc-waves--scroll-drift .dc-waves__layer:nth-child(3) {
        --wave-shift: 9%;
      }
    }
  }
  @keyframes dc-wave-scroll-drift {
    from {
      transform: translate3d(calc(var(--wave-shift) * var(--parallax-shift)), 0, 0);
    }
    to {
      transform: translate3d(calc(var(--wave-shift) * var(--parallax-shift) * -1), 0, 0);
    }
  }
</style>
