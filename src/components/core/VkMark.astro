---
/**
 * Марка ВКонтакте для круглых кнопок.
 *
 * В Lucide нет глифа VK, а в макете вместо него стоял бумажный самолётик —
 * он читается как Telegram и вводит в заблуждение. Рисовать логотип VK
 * по памяти нельзя, поэтому здесь текстовая марка: однозначно и честно.
 * Когда клиника даст официальный SVG из брендбука VK — заменить здесь.
 */
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<span class="dc-vk" aria-hidden="true" style={`font-size:${Math.round(size * 0.72)}px`}>VK</span>

<style>
  .dc-vk {
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    letter-spacing: 0.02em;
    line-height: 1;
    color: currentColor;
    user-select: none;
  }
</style>
