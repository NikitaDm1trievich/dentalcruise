---
/**
 * Полный прайс-лист: панель фильтра по направлениям и таблицы цен.
 *
 * Источник данных — коллекция price-list (один файл на направление,
 * внутри группы позиций). Названия и порядок направлений берутся из
 * service-categories, чтобы фильтр, якоря и каталог на главной не
 * разъезжались между собой.
 */
import { getCollection } from 'astro:content';

import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Button from '../components/core/Button.astro';
import Icon from '../components/core/Icon.astro';
import PriceTable from '../components/content/PriceTable.astro';
import OfferStrip from '../components/content/OfferStrip.astro';
import { clinic } from '../data/site';
import { withBase } from '../lib/asset';
import { absolute, clinicRef, isFromPrice, priceValue } from '../lib/seo';

type Ordered = { data: { order: number } };
const byOrder = (a: Ordered, b: Ordered) => a.data.order - b.data.order;

const categories = (await getCollection('service-categories')).sort(byOrder);
const prices = await getCollection('price-list');
const servicePages = await getCollection('service-pages');

/** Позиция прайса → своя страница услуги, по совпадению названия и направления */
const pageByItem = new Map(
  servicePages.map((page) => [`${page.data.category}__${page.data.matchTitle ?? page.data.title}`, page.id]),
);

/** Направления в порядке каталога; без цен в прайсе — не показываем */
const sections = categories
  .map((category) => {
    const price = prices.find((p) => p.data.slug === category.data.slug);
    return {
      slug: category.data.slug,
      title: category.data.title,
      icon: category.data.icon,
      price,
      /** Каждая позиция — ссылка на свою карточку услуги, если она есть */
      groups: price?.data.groups.map((group) => ({
        title: group.title,
        items: group.items.map((item) => ({
          ...item,
          href: pageByItem.has(`${category.data.slug}__${item.title}`)
            ? withBase(`uslugi/${pageByItem.get(`${category.data.slug}__${item.title}`)}`)
            : undefined,
        })),
      })),
    };
  })
  .filter((section) => section.price);

/**
 * Каталог цен для поисковика.
 *
 * Прайс — главная страница под запросы вида «коронка цена Москва»:
 * человек ищет сумму, и выигрывает тот сайт, который отдаёт её в виде
 * данных, а не только картинкой таблицы. Каждая позиция уходит
 * отдельным предложением с ценой, рублями и ссылкой на свою карточку.
 *
 * Позиции без распознанной цены пропускаем: «по запросу» в разметке
 * превращается в ноль и в выдаче читается как бесплатная услуга.
 */
const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  '@id': `${absolute('pricelist', Astro.site)}#catalog`,
  name: `Прайс-лист стоматологии «${clinic.name}»`,
  url: absolute('pricelist', Astro.site),
  provider: clinicRef(Astro.site, clinic),
  itemListElement: sections.map((section) => ({
    '@type': 'OfferCatalog',
    name: section.title,
    url: `${absolute('pricelist', Astro.site)}#${section.slug}`,
    itemListElement: (section.groups ?? [])
      .flatMap((group) => group.items)
      .map((item) => ({ item, amount: priceValue(item.price) }))
      .filter(({ amount }) => amount !== null)
      .map(({ item, amount }) => ({
        '@type': 'Offer',
        name: item.title,
        priceCurrency: 'RUB',
        availability: 'https://schema.org/InStock',
        ...(item.href ? { url: absolute(item.href, Astro.site) } : {}),
        ...(isFromPrice(item.price)
          ? {
              priceSpecification: {
                '@type': 'PriceSpecification',
                minPrice: amount,
                priceCurrency: 'RUB',
              },
            }
          : { price: amount }),
      })),
  })),
};

const total = sections.reduce(
  (sum, s) => sum + (s.price?.data.groups ?? []).reduce((n, g) => n + g.items.length, 0),
  0,
);
---

<PageLayout
  title="Прайс-лист стоматологии «Дентал Круиз» — цены на коронки, виниры и импланты"
  description="Полные цены клиники «Дентал Круиз»: коронки от 15 000 ₽, виниры от 25 000 ₽, имплантация под ключ от 65 000 ₽, All-on-4 от 150 000 ₽. Консультация бесплатно. Москва, 4-я Магистральная, 5с1."
  path="/pricelist"
  heading="Цены на лечение"
  lead={`${total} позиций по шести направлениям. Цены указаны за единицу работы. Коронки, виниры и протезы делает зуботехническая лаборатория клиники — поэтому в цене нет наценки посредника.`}
  breadcrumbs={[{ label: 'Прайс-лист' }]}
  schema={[catalogSchema]}
>
  <!-- Панель фильтра: липнет под шапкой при прокрутке -->
  <div class="dc-filter" data-price-filter>
    <div class="dc-filter__inner">
      <button type="button" class="dc-filter__chip" data-filter="all" aria-pressed="true">
        Все направления
      </button>
      {
        sections.map((section) => (
          <button type="button" class="dc-filter__chip" data-filter={section.slug} aria-pressed="false">
            {section.title}
          </button>
        ))
      }
    </div>
  </div>

  <section class="dc-section dc-price-page">
    <div class="dc-container">
      <Reveal>
        <OfferStrip
          items={[
            {
              icon: 'calendar-check',
              title: 'Консультация бесплатно',
              text: 'Осмотр, снимок и план лечения с итоговой суммой — до того, как вы что-то оплатите.',
            },
            {
              icon: 'wallet',
              title: 'Рассрочка без переплат',
              text: 'Доступная рассрочка без % от клиники и банков-партнёров на масштабные планы лечения.',
            },
          ]}
        />
      </Reveal>

      {
        sections.map((section, i) => (
          <Reveal delay={i * 60}>
            <section class="dc-price-block" id={section.slug} data-price-section={section.slug}>
              <header class="dc-price-block__head">
                <span class="dc-price-block__icon">
                  <Icon name={section.icon} size={24} strokeWidth={1.75} color="var(--text-accent)" />
                </span>
                <h2>{section.title}</h2>
                {section.price?.data.note && <p>{section.price.data.note}</p>}
              </header>

              <div class="dc-price-block__groups">
                {section.groups?.map((group) => (
                  <PriceTable title={group.title} items={group.items} />
                ))}
              </div>
            </section>
          </Reveal>
        ))
      }

      <Reveal>
        <div class="dc-price-page__foot">
          <p>
            Цены действуют на сентябрь 2026 года и не являются публичной офертой: итоговую сумму
            врач называет после осмотра и снимка — до начала лечения и без доплат по ходу.
          </p>
          <div class="dc-actions">
            <Button variant="primary" size="lg" data-open="dc-book">
              <Icon slot="icon" name="calendar" size={20} />
              Записаться на консультацию
            </Button>
            <Button variant="secondary" size="lg" href={clinic.phoneHref}>
              <Icon slot="icon" name="phone" size={20} />
              {clinic.phone}
            </Button>
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</PageLayout>

<style>
  .dc-filter {
    position: sticky;
    /* Шапка на прокрученной странице ниже, чем --header-h (тот держит
       высоту непрокрученного состояния) — фиксируем фактическую высоту,
       иначе между шапкой и панелью фильтра остаётся видимая щель. */
    top: 60px;
    z-index: 20;
    padding: var(--space-3) var(--gutter);
    background: color-mix(in srgb, var(--dc-white) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-hairline);
  }
  .dc-filter__inner {
    max-width: var(--container);
    margin-inline: auto;
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    /* Полоса прокручивается на телефоне, но полосу прокрутки не показываем */
    scrollbar-width: none;
  }
  .dc-filter__inner::-webkit-scrollbar {
    display: none;
  }
  .dc-filter__chip {
    flex: 0 0 auto;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-hairline);
    background: var(--surface-card);
    color: var(--text-body);
    font-family: var(--font-body);
    font-size: var(--type-small);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .dc-filter__chip:hover {
    border-color: var(--line-strong);
  }
  .dc-filter__chip[aria-pressed='true'] {
    background: var(--cta-bg);
    border-color: var(--cta-bg);
    color: var(--cta-fg);
  }

  .dc-price-page {
    background: var(--dc-white);
  }
  /* Появление блока при переключении фильтра — отдельно от общего
     scroll-reveal (тот у уже показанных блоков не повторяется). */
  @keyframes dc-filter-enter {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-shift, 26px));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .dc-filter-enter {
    animation: dc-filter-enter 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-filter-enter {
      animation: none;
    }
  }
  .dc-price-block {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-sm);
    /* Глобальный scroll-padding-top на <html> уже учитывает шапку —
       здесь добавляем только высоту липкой панели фильтра. */
    scroll-margin-top: 64px;
  }
  .dc-price-block__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .dc-price-block__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--surface-quiet);
    box-shadow: inset 0 0 0 1px var(--dc-turquoise-soft);
  }
  .dc-price-block__head h2 {
    font-size: var(--type-h2);
  }
  .dc-price-block__head p {
    color: var(--text-muted);
    font-size: var(--type-small);
    max-width: min(var(--measure), 100%);
  }
  .dc-price-block__groups {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: start;
  }
  .dc-price-page__foot {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }
  .dc-price-page__foot p {
    color: var(--text-muted);
    font-size: var(--type-small);
    max-width: min(var(--measure), 100%);
  }
  .dc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-price-filter]');
  if (panel) {
    const chips = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-price-section]'),
    );

    const apply = (value: string, animateShown = false) => {
      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(chip.dataset.filter === value));
      }
      for (const section of sections) {
        // Прячем обёртку появления целиком, иначе от скрытого блока
        // остаётся его отступ в сетке контейнера.
        const wrapper = section.closest<HTMLElement>('.dc-reveal') ?? section;
        const shouldShow = value === 'all' || section.dataset.priceSection === value;
        const wasHidden = wrapper.hidden;
        wrapper.hidden = !shouldShow;

        // Появление по скролл-наблюдателю у блока обычно уже сыграно один раз
        // и больше не повторится — а при переключении фильтра блок должен
        // заново «появляться» каждый раз, иначе после первого клика он просто
        // мгновенно выскакивает без анимации.
        if (animateShown && shouldShow && wasHidden) {
          wrapper.classList.remove('dc-filter-enter');
          // eslint-disable-next-line no-unused-expressions
          wrapper.offsetWidth;
          wrapper.classList.add('dc-filter-enter');
        }
      }
    };

    // Выбранная кнопка не должна оставаться за краем прокручиваемой полосы —
    // нужно и при клике по чипу, и при приходе по ссылке-якорю (с главной,
    // из блока акции), иначе полоса фильтра остаётся на месте, а контент уезжает.
    const scrollChipIntoView = (value: string) => {
      const chip = chips.find((c) => c.dataset.filter === value);
      chip?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const value = chip.dataset.filter ?? 'all';
        apply(value, true);
        // Адрес отражает выбор: ссылкой можно поделиться
        const url = value === 'all' ? window.location.pathname : `#${value}`;
        history.replaceState(null, '', url);
        scrollChipIntoView(value);
      });
    }

    // Пришли по якорю из каталога или из акции — сразу нужный раздел.
    // Слушаем и hashchange: на страницу можно попасть и без перезагрузки.
    const applyHash = () => {
      const value = window.location.hash.replace('#', '');
      if (!value || !chips.some((chip) => chip.dataset.filter === value)) return;
      apply(value);
      document.getElementById(value)?.scrollIntoView();
      scrollChipIntoView(value);
    };
    applyHash();
    window.addEventListener('hashchange', applyHash);
  }
</script>
