---
/** Карточка места: адрес, часы, почта, телефон, кнопки связи. Из Ds2_2d9e23.PlaceCard. */
import Icon from '../core/Icon.astro';
import MetroStations from '../core/MetroStations.astro';
import BrandIcon from '../core/BrandIcon.astro';
import IconButton from '../core/IconButton.astro';
import Button from '../core/Button.astro';
import { clinic } from '../../data/site';
import { withBase } from '../../lib/asset';

interface Props {
  /**
   * Уровень заголовка карточки. В блоке контактов перед подвалом над ней
   * стоит h2 секции — там h3; на странице «Контакты» карточка идёт сразу
   * за h1, и h3 давал пропуск уровня (h1 → h3) — там h2. Вид не меняется:
   * размер задаёт класс, а не тег.
   */
  headingLevel?: 'h2' | 'h3';
}

const { headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const { max, telegram, instagram, yandexOrg } = clinic.links;
---

<div class="dc-place">
  <Heading class="dc-place__title">{clinic.name}</Heading>

  <div class="dc-place__row">
    <Icon name="map-pin" size={22} color="var(--text-accent)" />
    <div>
      <span class="dc-place__main">{clinic.address.locality}, {clinic.address.street}</span>
      <span class="dc-place__sub"><MetroStations note="5 минут пешком" /></span>
    </div>
  </div>

  <div class="dc-place__row">
    <Icon name="clock" size={22} color="var(--text-accent)" />
    <div><span class="dc-place__main">{clinic.scheduleLong}</span></div>
  </div>

  <div class="dc-place__row">
    <Icon name="mail" size={22} color="var(--text-accent)" />
    <div>
      <a href={`mailto:${clinic.email}`} class="dc-place__main">{clinic.email}</a>
    </div>
  </div>

  <a href={clinic.phoneHref} class="dc-place__phone">{clinic.phone}</a>

  <div class="dc-place__actions">
    {
      max && (
        <IconButton label="Написать в Max" href={max}>
          <BrandIcon name="max" size={20} />
        </IconButton>
      )
    }
    {
      telegram && (
        <IconButton label="Написать в Telegram" href={telegram}>
          <Icon name="send" size={20} />
        </IconButton>
      )
    }
    {
      instagram && (
        <IconButton label="Мы в Instagram" href={instagram}>
          <BrandIcon name="instagram" size={20} />
        </IconButton>
      )
    }
    <Button variant="secondary" size="sm" href={yandexOrg} target="_blank" rel="noopener">
      <Icon slot="icon" name="navigation" size={18} />
      Как добраться
    </Button>
    <Button
      variant="ghost"
      size="sm"
      href={withBase('images/map/route-to-clinic.png')}
      target="_blank"
      rel="noopener"
    >
      <Icon slot="icon" name="image" size={18} />
      Схема проезда картинкой
    </Button>
  </div>
</div>

<style>
  .dc-place {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-8);
    background: var(--surface-card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    align-content: start;
  }
  .dc-place__title {
    font-size: var(--type-h3);

    letter-spacing: var(--ls-display);
  }
  .dc-place__row {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .dc-place__row > :global(.dc-icon) {
    margin-top: 2px;
  }
  .dc-place__row > div {
    display: grid;
    gap: 2px;
  }
  .dc-place__main {
    color: var(--text-strong);
    font-weight: var(--fw-semibold);
  }
  a.dc-place__main {
    text-decoration: none;
  }
  a.dc-place__main:hover {
    color: var(--text-accent);
  }
  .dc-place__sub {
    color: var(--text-muted);
    font-size: var(--type-small);
  }
  .dc-place__phone {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    text-decoration: none;
  }
  .dc-place__actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }
</style>
