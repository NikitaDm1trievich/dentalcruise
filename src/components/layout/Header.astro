---
/**
 * Фиксированная шапка: лого + адрес/часы/телефон + Max/VK/звонок + бургер.
 * Перенесено из Ds2_2d9e23.Header.
 *
 * До скролла шапка прозрачная и лежит поверх видео — лого и контакты белые.
 * После 40px становится плотно-белой с тенью (правка макета).
 */
import Icon from '../core/Icon.astro';
import IconButton from '../core/IconButton.astro';
import BrandIcon from '../core/BrandIcon.astro';
import { clinic, navLinks } from '../../data/site';
import { withBase } from '../../lib/asset';
import { getCollection } from 'astro:content';

interface Props {
  /** true — под шапкой hero-видео: до скролла шапка прозрачная, лого и контакты белые.
      На внутренних страницах hero нет, поэтому шапка сразу плотная. */
  overHero?: boolean;
}

const { overHero = false } = Astro.props;

const base = withBase('');
const logo = withBase('logo-dentalcruise.svg');
const { vk, max } = clinic.links;

const categories = (await getCollection('service-categories')).sort(
  (a, b) => a.data.order - b.data.order,
);
const pricelistHref = withBase('pricelist');
const restLinks = navLinks.filter((l) => l.href !== '/' && l.href !== '/pricelist');
---

<div class:list={['dc-header', overHero && 'dc-header--over-hero']} data-scrolled={String(!overHero)}>
  <header class="dc-header__bar">
    <div class="dc-header__inner">
      <a href={base} class="dc-header__logo" aria-label={`${clinic.name} — на главную`}>
        <img src={logo} alt={clinic.name} width="180" height="44" />
      </a>

      <nav class="dc-header__nav" aria-label="Разделы сайта">
        <div class="dc-header__nav-item" data-nav-dropdown data-open="false">
          <button
            type="button"
            class="dc-header__nav-toggle"
            aria-expanded="false"
            aria-controls="header-services"
          >
            Услуги
            <Icon name="chevron-down" size={16} />
          </button>
          <div class="dc-header__dropdown" id="header-services">
            <ul>
              {
                categories.map((cat) => (
                  <li>
                    <a href={`${pricelistHref}#${cat.data.slug}`}>{cat.data.title}</a>
                  </li>
                ))
              }
            </ul>
            <a href={pricelistHref} class="dc-header__dropdown-all">
              Весь прайс-лист
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
        {restLinks.map((link) => <a href={withBase(link.href.replace(/^\//, ''))}>{link.label}</a>)}
      </nav>

      <div class="dc-header__contacts">
        <div class="dc-header__place">
          <a
            href={clinic.links.yandexPin}
            target="_blank"
            rel="noopener"
            class="dc-header__address"
            title="Открыть на Яндекс Картах"
          >
            <Icon name="map-pin" size={14} />
            {clinic.address.streetShort}
          </a>
          <span class="dc-header__schedule">{clinic.scheduleShort}</span>
        </div>
        <a href={clinic.phoneHref} class="dc-header__phone">{clinic.phone}</a>
      </div>

      <div class="dc-header__actions">
        {
          max && (
            <IconButton label="Написать в Max" href={max} size={44}>
              <BrandIcon name="max" size={20} />
            </IconButton>
          )
        }
        {
          vk && (
            <IconButton label="Написать во ВКонтакте" href={vk} size={44}>
              <BrandIcon name="vk" size={20} />
            </IconButton>
          )
        }
        <IconButton label={`Позвонить ${clinic.phone}`} href={clinic.phoneHref} variant="accent" size={44}>
          <Icon name="phone" size={20} />
        </IconButton>

        <button
          type="button"
          class="dc-burger-btn"
          data-open="dc-menu"
          aria-expanded="false"
          aria-controls="dc-menu"
          aria-label="Открыть меню"
        >
          <span class="dc-burger-btn__bars">
            <span></span><span></span><span></span>
          </span>
        </button>
      </div>
    </div>
  </header>
</div>

<style>
  .dc-header__bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    padding: 16px var(--gutter);
    background: transparent;
    transition:
      padding var(--dur-mid) var(--ease-out),
      background var(--dur-mid) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out);
  }
  .dc-header[data-scrolled='true'] .dc-header__bar {
    padding: 8px var(--gutter);
    background: var(--dc-white);
    box-shadow:
      0 1px 0 var(--line-strong),
      0 10px 30px rgba(7, 59, 75, 0.1);
  }

  .dc-header__inner {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .dc-header__logo {
    display: flex;
    align-items: center;
  }
  .dc-header__logo img {
    height: 44px;
    width: auto;
    transition:
      height var(--dur-mid) var(--ease-out),
      filter var(--dur-mid) var(--ease-out);
  }
  .dc-header[data-scrolled='true'] .dc-header__logo img {
    height: 34px;
  }
  /* Поверх видео — белая версия логотипа */
  .dc-header--over-hero[data-scrolled='false'] .dc-header__logo img {
    filter: brightness(0) invert(1) drop-shadow(0 2px 14px rgba(7, 59, 75, 0.7));
  }

  /* Десктоп-навигация и адрес/часы появляются вместе — на планшете и уже
     им попросту не хватает места рядом с лого и кнопками; вся навигация
     там живёт в бургере, дублирования нет. */
  .dc-header__nav {
    display: none;
    align-items: center;
    gap: var(--space-6);
  }
  .dc-header__contacts {
    display: none;
    gap: var(--space-6);
    align-items: center;
    text-align: center;
    min-width: 0;
  }
  @media (min-width: 1180px) {
    .dc-header__nav {
      display: flex;
    }
    .dc-header__contacts {
      display: flex;
    }
  }


  .dc-header__nav > a,
  .dc-header__nav-toggle {
    font-family: var(--font-body);
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    background: transparent;
    border: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0;
  }
  .dc-header__nav > a:hover,
  .dc-header__nav-toggle:hover {
    color: var(--text-accent);
  }
  .dc-header--over-hero[data-scrolled='false'] .dc-header__nav > a,
  .dc-header--over-hero[data-scrolled='false'] .dc-header__nav-toggle {
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(7, 59, 75, 0.55);
  }

  .dc-header__nav-item {
    position: relative;
  }
  .dc-header__nav-toggle :global(svg) {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .dc-header__nav-toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .dc-header__dropdown {
    position: absolute;
    top: calc(100% + 18px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    z-index: 5;
    width: 260px;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--dc-white);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line-hairline);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  /* Мостик через отступ между кнопкой и панелью: без него курсор по пути
     вниз выходил за пределы пункта меню и дропдаун закрывался. */
  .dc-header__dropdown::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -20px;
    height: 20px;
  }
  .dc-header__nav-item[data-open='true'] .dc-header__dropdown {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .dc-header__dropdown ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .dc-header__dropdown a {
    display: block;
    padding: 9px 10px;
    border-radius: var(--radius-sm);
    font-size: var(--type-small);
    font-weight: var(--fw-semibold);
    color: var(--text-body);
    text-decoration: none;
  }
  .dc-header__dropdown a:hover {
    background: var(--surface-quiet);
    color: var(--text-accent);
  }
  .dc-header__dropdown-all {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-2);
    padding-top: var(--space-3) !important;
    border-top: 1px solid var(--line-hairline);
    color: var(--text-accent) !important;
    font-weight: var(--fw-bold) !important;
  }
  /* Адрес и часы показываем только там, где на них честно хватает места.
     Строки внутри не переносятся, а ширины меню и кнопок фиксированы, так
     что в промежутке 1180–1360px адрес наезжал на телефон. Телефон важнее —
     он остаётся; адрес есть в подвале, бургер-меню и блоке «Контакты».
     Порог по сумме реальных ширин: лого, меню, контакты, кнопки и отступы
     складываются примерно в 1330px. */
  .dc-header__place {
    display: none;
    gap: 2px;
    min-width: 0;
  }
  @media (min-width: 1360px) {
    .dc-header__place {
      display: grid;
    }
  }
  .dc-header__address,
  .dc-header__schedule,
  .dc-header__phone {
    white-space: nowrap;
    font-family: var(--font-body);
  }
  .dc-header__address {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--type-small);
    font-weight: var(--fw-semibold);
    color: var(--text-body);
    text-decoration: none;
  }
  .dc-header__address:hover {
    color: var(--text-accent);
  }
  .dc-header__schedule {
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .dc-header__phone {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    text-decoration: none;
  }
  .dc-header--over-hero[data-scrolled='false'] .dc-header__address,
  .dc-header--over-hero[data-scrolled='false'] .dc-header__schedule,
  .dc-header--over-hero[data-scrolled='false'] .dc-header__phone {
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(7, 59, 75, 0.55);
  }

  .dc-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dc-burger-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-hairline);
    background: rgba(255, 255, 255, 0.72);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .dc-burger-btn:hover {
    background: var(--dc-white);
  }
  .dc-burger-btn__bars {
    display: grid;
    gap: 5px;
    place-items: center;
  }
  .dc-burger-btn__bars span {
    display: block;
    height: 2px;
    width: 22px;
    background: var(--text-strong);
    border-radius: 2px;
    transition:
      transform var(--dur-mid) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }
  /* Морф в «крестик», когда меню открыто */
  .dc-burger-btn[aria-expanded='true'] .dc-burger-btn__bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .dc-burger-btn[aria-expanded='true'] .dc-burger-btn__bars span:nth-child(2) {
    opacity: 0;
  }
  .dc-burger-btn[aria-expanded='true'] .dc-burger-btn__bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (hover: hover) and (min-width: 900px) {
    .dc-burger-btn:hover {
      background: var(--cta-bg);
      border-color: transparent;
    }
    .dc-burger-btn:hover .dc-burger-btn__bars span {
      background: #ffffff;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.dc-header--over-hero');
  if (header) {
    const sync = () => {
      header.dataset.scrolled = String(window.scrollY > 40);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  // Дропдаун «Услуги»: наведение мышью на десктопе + клик/тач и Escape
  document.querySelectorAll<HTMLElement>('[data-nav-dropdown]').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('.dc-header__nav-toggle');
    if (!toggle) return;

    const set = (open: boolean) => {
      item.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      // Небольшая отсрочка на уход курсора: меню прощает, если по дороге
      // к списку мышь на мгновение вышла за край пункта.
      let closeTimer = 0;
      item.addEventListener('mouseenter', () => {
        window.clearTimeout(closeTimer);
        set(true);
      });
      item.addEventListener('mouseleave', () => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => set(false), 220);
      });
    }
    toggle.addEventListener('click', () => set(item.dataset.open !== 'true'));
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node)) set(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') set(false);
    });
  });
</script>
