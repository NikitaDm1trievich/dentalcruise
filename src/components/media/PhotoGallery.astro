---
/**
 * Галерея из нескольких фотографий: кроссфейд, точки-переключатели,
 * стрелки и автопрокрутка.
 *
 * Используется там, где раньше стоял один снимок или заглушка:
 * слайды карусели преимуществ и блок «О клинике». Если фотографий
 * не передали — показывает ту же подписанную заглушку, что и раньше,
 * поэтому блок можно верстать до того, как появится съёмка.
 */
import Icon from '../core/Icon.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { withBase } from '../../lib/asset';

interface Props {
  photos?: string[];
  alt: string;
  /** Подпись заглушки, когда фотографий ещё нет */
  label?: string;
  ratio?: string;
  radius?: string;
  /** Пауза между кадрами, мс. 0 — не листать автоматически */
  interval?: number;
  cover?: boolean;
  class?: string;
}

const {
  photos = [],
  alt,
  label = 'Здесь реальное фото',
  ratio = '4 / 3',
  radius = 'var(--radius-xl)',
  interval = 5000,
  cover = false,
  class: className,
} = Astro.props;

const many = photos.length > 1;
---

{
  photos.length === 0 ? (
    <PhotoPlaceholder label={label} ratio={ratio} radius={radius} cover={cover} class={className} />
  ) : (
    <div
      class:list={['dc-gal', cover && 'dc-gal--cover', className]}
      style={`--dc-gal-ratio:${ratio};--dc-gal-radius:${radius}`}
      data-gallery
      data-interval={many ? interval : 0}
    >
      <div class="dc-gal__frame">
        {photos.map((src, i) => (
          <img
            src={withBase(src)}
            alt={i === 0 ? alt : ''}
            aria-hidden={i === 0 ? undefined : 'true'}
            loading="lazy"
            decoding="async"
            class="dc-gal__img"
            data-slide={i}
            data-active={i === 0 ? 'true' : 'false'}
          />
        ))}
      </div>

      {many && (
        <>
          <button type="button" class="dc-gal__nav dc-gal__nav--prev" aria-label="Предыдущее фото" data-gal-prev>
            <Icon name="arrow-left" size={20} />
          </button>
          <button type="button" class="dc-gal__nav dc-gal__nav--next" aria-label="Следующее фото" data-gal-next>
            <Icon name="arrow-right" size={20} />
          </button>

          <div class="dc-gal__dots" role="tablist" aria-label={`${alt}: ${photos.length} фото`}>
            {photos.map((_, i) => (
              <button
                type="button"
                role="tab"
                class="dc-gal__dot"
                aria-label={`Фото ${i + 1} из ${photos.length}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-gal-dot={i}
              />
            ))}
          </div>
        </>
      )}
    </div>
  )
}

<style>
  .dc-gal {
    position: relative;
    width: 100%;
    aspect-ratio: var(--dc-gal-ratio);
    border-radius: var(--dc-gal-radius);
    overflow: hidden;
    /* skeleton, пока кадр не догрузился */
    background: var(--grad-shallow);
  }
  .dc-gal--cover {
    height: 100%;
    aspect-ratio: auto;
  }

  .dc-gal__frame {
    position: absolute;
    inset: 0;
  }
  .dc-gal__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-crossfade) var(--ease-out);
  }
  .dc-gal__img[data-active='true'] {
    opacity: 1;
  }

  .dc-gal__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-pill);
    background: var(--glass-light);
    backdrop-filter: var(--blur-glass);
    color: var(--text-strong);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .dc-gal__nav--prev {
    left: var(--space-3);
  }
  .dc-gal__nav--next {
    right: var(--space-3);
  }
  .dc-gal:hover .dc-gal__nav,
  .dc-gal__nav:focus-visible {
    opacity: 1;
  }
  .dc-gal__nav:hover {
    background: var(--dc-white);
  }
  /* На тач-экранах наводить нечем — стрелки видны всегда */
  @media (hover: none) {
    .dc-gal__nav {
      opacity: 1;
    }
  }

  .dc-gal__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-4);
    display: flex;
    justify-content: center;
    gap: var(--space-2);
  }
  .dc-gal__dot {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .dc-gal__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 0 1px 3px rgba(7, 59, 75, 0.4);
    transition:
      width var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .dc-gal__dot[aria-selected='true']::before {
    width: 22px;
    background: var(--dc-white);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll<HTMLImageElement>('.dc-gal__img'));
    const dots = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gal-dot]'));
    if (slides.length < 2) return;

    let current = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      const index = (next + slides.length) % slides.length;
      slides.forEach((img, i) => {
        img.dataset.active = String(i === index);
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-selected', String(i === index));
      });
      current = index;
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      const ms = Number(gallery.dataset.interval ?? 0);
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (ms > 0 && !reduced) timer = window.setInterval(() => show(current + 1), ms);
    };

    gallery.querySelector('[data-gal-prev]')?.addEventListener('click', () => {
      show(current - 1);
      start();
    });
    gallery.querySelector('[data-gal-next]')?.addEventListener('click', () => {
      show(current + 1);
      start();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      }),
    );

    // Пока смотрят вручную или вкладка в фоне — не перелистываем
    gallery.addEventListener('mouseenter', stop);
    gallery.addEventListener('mouseleave', start);
    gallery.addEventListener('focusin', stop);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    start();
  });
</script>
