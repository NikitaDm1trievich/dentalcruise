---
/**
 * Список врачей. Карточка ведёт на персональную страницу /doctors/<файл>,
 * которую собирает src/pages/doctors/[slug].astro из того же JSON.
 */
import { getCollection } from 'astro:content';

import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../components/core/Reveal.astro';
import Button from '../components/core/Button.astro';
import Icon from '../components/core/Icon.astro';
import PhotoPlaceholder from '../components/media/PhotoPlaceholder.astro';
import TrustBar from '../components/content/TrustBar.astro';
import { clinic } from '../data/site';
import { withBase } from '../lib/asset';

type Ordered = { data: { order: number } };
const byOrder = (a: Ordered, b: Ordered) => a.data.order - b.data.order;

const doctors = (await getCollection('doctors')).sort(byOrder);
const trust = (await getCollection('trust')).sort(byOrder);
---

<PageLayout
  title="Врачи стоматологии «Дентал Круиз» — ортопед, терапевт, хирург, зубной техник"
  description="Команда клиники «Дентал Круиз»: ортопед-имплантолог со стажем 18 лет, терапевт, хирург и керамист собственной зуботехнической лаборатории. Москва, 4-я Магистральная, 5с1."
  path="/doctors"
  eyebrow="Врачи"
  heading="Команда, которая работает вместе"
  lead="Врач и зубной техник обсуждают вашу работу лично — они принимают в одном здании, а не переписываются с подрядчиком."
  breadcrumbs={[{ label: 'Врачи' }]}
>
  <section class="dc-section dc-bg-white">
    <div class="dc-container">
      <ul class="dc-team" role="list">
        {
          doctors.map((doctor, i) => (
            <Reveal as="li" delay={i * 70}>
              <a href={withBase(`doctors/${doctor.id}`)} class="dc-team__card">
                <PhotoPlaceholder
                  label={doctor.data.photoLabel}
                  src={doctor.data.photo}
                  alt={`${doctor.data.name}, ${doctor.data.speciality}`}
                  ratio="3 / 4"
                  radius="0"
                  cover
                />
                <span class="dc-team__body">
                  <span class="dc-team__spec">{doctor.data.speciality}</span>
                  <span class="dc-team__exp">Стаж {doctor.data.experience}</span>
                  <span class="dc-team__note">{doctor.data.note}</span>
                  <span class="dc-team__more">
                    Подробнее о враче
                    <Icon name="arrow-right" size={16} />
                  </span>
                </span>
              </a>
            </Reveal>
          ))
        }
      </ul>

      <Reveal delay={320}>
        <div class="dc-actions">
          <Button variant="primary" size="lg" data-open="dc-book">
            <Icon slot="icon" name="calendar" size={20} />
            Записаться на приём
          </Button>
          <Button variant="secondary" size="lg" href={clinic.phoneHref}>
            <Icon slot="icon" name="phone" size={20} />
            {clinic.phone}
          </Button>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="dc-section--tight dc-bg-cool">
    <div class="dc-container">
      <Reveal>
        <TrustBar items={trust.map((t) => t.data)} />
      </Reveal>
    </div>
  </section>
</PageLayout>

<style>
  .dc-team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .dc-team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1040px) {
    .dc-team {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .dc-team__card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow var(--dur-mid) var(--ease-out),
      border-color var(--dur-mid) var(--ease-out);
  }
  .dc-team__card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--line-strong);
  }
  .dc-team__body {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
  }
  .dc-team__spec {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    font-weight: var(--fw-black);
    color: var(--text-strong);
  }
  .dc-team__exp {
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    color: var(--text-accent);
  }
  .dc-team__note {
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .dc-team__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-2);
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    color: var(--text-accent);
  }

  .dc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .dc-bg-white {
    background: var(--dc-white);
  }
  .dc-bg-cool {
    background: var(--surface-cool);
  }
</style>
