---
/**
 * Виджет Яндекс Карт (карта организации или лента отзывов).
 *
 * Пока посетитель не нажал «Принять» в уведомлении о cookie, на месте
 * виджета заглушка: iframe Яндекса при загрузке передаёт Яндексу IP и данные
 * браузера и может поставить его cookie. После «Принять» (согласие
 * охватывает Метрику и виджеты Яндекс Карт — так сказано в уведомлении и в
 * политике cookie) виджеты загружаются сами, без второго нажатия — и на
 * следующих страницах, пока согласие действует. «Отказаться» убирает уже
 * загруженные виджеты. Тому, кто не принимал cookie, остаётся кнопка
 * «Показать карту» / «Показать отзывы»: по ней iframe создаётся по
 * действию посетителя. Обычная ссылка на Яндекс Карты под виджетом
 * работает и без него.
 */
import Button from '../core/Button.astro';
import Icon from '../core/Icon.astro';
import { blocks } from '../../data/ui';
import { cmsSite, type CmsLock } from '../../lib/cms-ref';

interface Props {
  src: string;
  title: string;
  height?: number;
  /** Подпись под виджетом со ссылкой на карточку организации */
  linkHref?: string;
  linkLabel?: string;
  /** Адрес подписи-ссылки в редакторе для выбора блока в предпросмотре (lib/cms-ref) */
  cms?: string;
  /** Что за виджет: карта или лента отзывов — от этого подпись замка в предпросмотре */
  lock?: Extract<CmsLock, 'map' | 'reviews'>;
  class?: string;
}

const { src, title, height = 400, linkHref, linkLabel, cms, lock = 'map', class: className } = Astro.props;
const reviews = lock === 'reviews';
const { embed } = blocks;
---

<div
  class:list={['dc-embed', className]}
  style={`--dc-embed-h:${height}px`}
  data-embed
  data-src={src}
  data-title={title}
>
  {/* Сам виджет рисует Яндекс: в редакторе сайта его не поменять */}
  <div class="dc-embed__frame" data-cms-lock={lock}>
    <div class="dc-embed__skeleton" aria-hidden="true"></div>
    <div class="dc-embed__stub" data-embed-stub>
      <Icon name={reviews ? 'message-square-text' : 'map-pinned'} size={32} color="var(--text-accent)" />
      <p data-cms={cmsSite('blocks', reviews ? 'embed.reviewsText' : 'embed.mapText')}>
        {reviews ? embed.reviewsText : embed.mapText}
      </p>
      <Button
        variant="secondary"
        data-embed-show
        data-cms={cmsSite('blocks', reviews ? 'embed.reviewsButton' : 'embed.mapButton')}
      >
        {reviews ? embed.reviewsButton : embed.mapButton}
      </Button>
    </div>
  </div>

  {
    linkHref && (
      <a class="dc-embed__link" href={linkHref} target="_blank" rel="noopener" data-cms={cms}>
        {linkLabel ?? 'Открыть в Яндекс Картах'}
      </a>
    )
  }
</div>

<style>
  .dc-embed {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    background: var(--dc-breeze);
    border: 1px solid var(--line-hairline);
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: var(--dc-embed-h);
  }
  .dc-embed__frame {
    position: relative;
    min-height: var(--dc-embed-h);
  }
  .dc-embed__frame :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: var(--dc-embed-h);
    border: 0;
    filter: saturate(0.88) contrast(1.03);
  }
  .dc-embed__skeleton {
    position: absolute;
    inset: 0;
    background: var(--grad-shallow);
  }
  /* Заглушка до нажатия: текст о передаче данных Яндексу и кнопка */
  .dc-embed__stub {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    text-align: center;
  }
  .dc-embed__stub[hidden] {
    display: none;
  }
  .dc-embed__stub p {
    max-width: 34ch;
    margin: 0;
    color: var(--text-body);
    font-size: var(--type-small);
    line-height: var(--lh-body);
  }
  .dc-embed__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    padding: 0 16px;
    text-decoration: none;
    color: var(--text-accent);
    font-family: var(--font-body);
    font-size: var(--type-small);
    font-weight: var(--fw-bold);
    background: var(--surface-quiet);
  }
</style>

<script>
  import { CONSENT_EVENT, readConsent } from '../../lib/analytics';

  const hosts = Array.from(document.querySelectorAll<HTMLElement>('[data-embed]'));

  /* iframe создаём только по согласию или по кнопке: до этого к Яндексу не уходит ни одного запроса */
  const mount = (host: HTMLElement, moveFocus: boolean) => {
    const frame = host.querySelector<HTMLElement>('.dc-embed__frame');
    if (!frame || frame.querySelector('iframe')) return;

    const iframe = document.createElement('iframe');
    iframe.src = host.dataset.src ?? '';
    iframe.title = host.dataset.title ?? '';
    iframe.setAttribute('allowfullscreen', 'true');
    iframe.addEventListener('load', () => host.querySelector('.dc-embed__skeleton')?.remove(), {
      once: true,
    });
    const stub = host.querySelector<HTMLElement>('[data-embed-stub]');
    if (stub) stub.hidden = true;
    frame.appendChild(iframe);
    // Кнопка исчезла вместе с заглушкой — фокус переходит на сам виджет
    // (только когда виджет открыли кнопкой, не сам по согласию)
    if (moveFocus) iframe.focus();
  };

  /* Отказ: убрать загруженный виджет и вернуть заглушку с кнопкой */
  const unmount = (host: HTMLElement) => {
    host.querySelector('iframe')?.remove();
    const stub = host.querySelector<HTMLElement>('[data-embed-stub]');
    if (stub) stub.hidden = false;
  };

  hosts.forEach((host) => {
    host.querySelector('[data-embed-show]')?.addEventListener('click', () => mount(host, true));
  });

  if (readConsent() === true) hosts.forEach((host) => mount(host, false));

  window.addEventListener(CONSENT_EVENT, (event) => {
    const accepted = (event as CustomEvent<{ analytics: boolean }>).detail?.analytics === true;
    hosts.forEach((host) => (accepted ? mount(host, false) : unmount(host)));
  });
</script>
