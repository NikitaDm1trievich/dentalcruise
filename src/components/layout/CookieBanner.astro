---
/**
 * Уведомление о cookie: «Принять» / «Отказаться». Яндекс Метрика
 * загружается только после «Принять» (lib/analytics) — до выбора и после
 * отказа счётчика на странице нет.
 *
 * Показывается само, пока посетитель не выбрал (или выбору больше
 * 12 месяцев), и по кнопке «Настройки cookie» (`data-cookie-settings`) в
 * подвале и на странице «Документы» — тогда с подписью «Сейчас: Метрика
 * включена / выключена» и фокусом на первой кнопке. Esc в этом режиме
 * просто прячет уведомление, выбор не меняется.
 *
 * Всплывающая карточка в правом нижнем углу, а не полоса и не модальное
 * окно: сайтом можно пользоваться, пока она открыта, фокус при автопоказе
 * не перехватывается. В разметке стоит сразу за ссылкой «Перейти к
 * содержимому» — с клавиатуры до неё два нажатия Tab. На телефоне карточка
 * стоит над нижней панелью действий, а не на ней; окно записи, меню и
 * шторка подбора (z-index выше) её накрывают. Кнопка «наверх» поднимается
 * над карточкой (ScrollToTop читает её высоту из `--dc-cookie-h`). На
 * телефоне, где карточка занимает ширину экрана, у страницы снизу отступ
 * её высоты — подвал не прячется под ней.
 *
 * Кнопки одного размера и вида: «Отказаться» не должна быть мельче или
 * бледнее «Принять» (требование юриста, ui-texts).
 *
 * Показ и запуск Метрики разделены (lib/seo): карточка рисуется, если в
 * редакторе есть номер счётчика (`hasMetrikaCounter`), — в том числе на
 * тестовой сборке, чтобы владелец мог её посмотреть, а выбор сохранялся.
 * А `data-metrika` (номер для запуска) заполнен только на боевом домене:
 * на тесте пустой номер значит «Метрику не грузить ни при каком выборе».
 * Номера счётчика в редакторе нет — компонента на странице нет: соглашаться
 * не на что, а текст «Мы используем Яндекс Метрику» был бы неправдой.
 */
import Button from '../core/Button.astro';
import { blocks } from '../../data/ui';
import { pageHref } from '../../lib/asset';
import { cmsSite } from '../../lib/cms-ref';
import { fillParts } from '../../lib/format';
import { hasMetrikaCounter, metrikaId } from '../../lib/seo';

const copy = blocks.cookie;
const parts = fillParts(copy.text, { ссылка: copy.link });
---

{
  hasMetrikaCounter && (
    <section
      class="dc-cookie"
      aria-label={copy.label}
      data-cookie-banner
      data-metrika={metrikaId}
      hidden
      data-cms={cmsSite('blocks', 'cookie')}
    >
      <div class="dc-cookie__inner">
        <div class="dc-cookie__copy">
          <p data-cms={cmsSite('blocks', 'cookie.text')}>
            {parts.map((part) =>
              part.key ? (
                <a href={pageHref('cookies')} data-cms={cmsSite('blocks', 'cookie.link')}>{part.text}</a>
              ) : (
                part.text
              ),
            )}
          </p>
          <p class="dc-cookie__state" data-cookie-state hidden>
            <span data-cookie-on hidden>{copy.stateOn}</span>
            <span data-cookie-off hidden>{copy.stateOff}</span>
          </p>
        </div>
        <div class="dc-cookie__actions">
          <Button variant="primary" data-cookie-accept data-cms={cmsSite('blocks', 'cookie.accept')}>
            {copy.accept}
          </Button>
          <Button variant="primary" data-cookie-decline data-cms={cmsSite('blocks', 'cookie.decline')}>
            {copy.decline}
          </Button>
        </div>
      </div>
    </section>
  )
}

<style>
  /* Карточка в правом нижнем углу. Над кнопкой «наверх» (50), под нижней
     панелью (65), меню (70), шторкой подбора (90) и окном записи (100):
     форму и панель действий она не закрывает. */
  .dc-cookie {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 60;
    box-sizing: border-box;
    width: min(26rem, calc(100% - 2 * var(--space-5)));
    padding: var(--space-5);
    background: var(--surface-card);
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .dc-cookie[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dc-cookie:not([hidden]) {
      animation: dc-cookie-in var(--dur-mid) var(--ease-out);
    }
  }
  @keyframes dc-cookie-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  /* Пока на экране нижняя панель действий (до 900px), карточка над ней */
  :global(html.has-sticky-actions) .dc-cookie {
    bottom: calc(var(--sticky-actions-h) + var(--space-3));
  }
  /* Фокус после выбора уходит на <main> (см. hide) — рамка вокруг всей страницы не нужна */
  :global(#main[tabindex='-1']:focus) {
    outline: none;
  }

  .dc-cookie__inner {
    display: grid;
    gap: var(--space-4);
  }
  .dc-cookie__copy {
    display: grid;
    gap: var(--space-2);
    font-size: var(--type-small);
    line-height: var(--lh-body);
    color: var(--text-body);
  }
  .dc-cookie__copy p {
    margin: 0;
  }
  .dc-cookie__copy a {
    color: var(--text-accent);
    font-weight: var(--fw-semibold);
  }
  .dc-cookie__state {
    font-weight: var(--fw-bold);
    color: var(--text-strong);
  }
  /* Кнопки равной ширины — пополам строки */
  .dc-cookie__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  /* Телефон: карточка по ширине экрана над нижней панелью «Позвонить ·
     Записаться · Max», поля плотнее. Страница получает отступ снизу на
     высоту карточки — подвал не прячется под ней. */
  @media (max-width: 559.98px) {
    .dc-cookie {
      right: var(--space-3);
      left: var(--space-3);
      width: auto;
      padding: var(--space-4);
    }
    .dc-cookie__inner {
      gap: var(--space-3);
    }
    .dc-cookie__actions {
      gap: var(--space-2);
    }
    :global(html.has-cookie-banner body) {
      padding-bottom: calc(var(--dc-cookie-h, 0px) + var(--space-3));
    }
    :global(html.has-cookie-banner.has-sticky-actions body) {
      padding-bottom: calc(var(--sticky-actions-h) + var(--dc-cookie-h, 0px) + var(--space-3));
    }
  }
</style>

<script>
  import { readConsent, saveConsent, startMetrika, stopMetrika, trackContactClicks } from '../../lib/analytics';

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
  // Пустой номер — тестовая сборка: уведомление и выбор работают, Метрика
  // не запускается и не гасится (гасить нечего).
  const id = banner?.dataset.metrika ?? '';

  if (banner) {
    const root = document.documentElement;
    const state = banner.querySelector<HTMLElement>('[data-cookie-state]');
    const stateOn = banner.querySelector<HTMLElement>('[data-cookie-on]');
    const stateOff = banner.querySelector<HTMLElement>('[data-cookie-off]');
    const accept = banner.querySelector<HTMLButtonElement>('[data-cookie-accept]');
    const decline = banner.querySelector<HTMLButtonElement>('[data-cookie-decline]');
    let opener: HTMLElement | null = null;

    // Высота карточки — в отступ страницы снизу (телефон) и в положение кнопки «наверх»
    const syncHeight = () => root.style.setProperty('--dc-cookie-h', `${banner.offsetHeight}px`);
    const resize = 'ResizeObserver' in window ? new ResizeObserver(syncHeight) : null;

    const show = (fromSettings: boolean) => {
      const choice = readConsent();
      if (state && stateOn && stateOff) {
        state.hidden = !fromSettings || choice === null;
        stateOn.hidden = choice !== true;
        stateOff.hidden = choice !== false;
      }
      banner.hidden = false;
      root.classList.add('has-cookie-banner');
      syncHeight();
      resize?.observe(banner);
      if (fromSettings) accept?.focus();
    };

    const hide = () => {
      const hadFocus = banner.contains(document.activeElement);
      banner.hidden = true;
      root.classList.remove('has-cookie-banner');
      resize?.disconnect();
      // Фокус — туда, откуда открыли настройки; при первом выборе — к началу
      // содержимого, как после «Перейти к содержимому». Иначе он остался бы
      // на исчезнувшей кнопке и следующий Tab начинался бы с начала страницы.
      if (opener && document.contains(opener)) opener.focus();
      else if (hadFocus) {
        const main = document.getElementById('main');
        if (main) {
          if (!main.hasAttribute('tabindex')) main.setAttribute('tabindex', '-1');
          main.focus({ preventScroll: true });
        }
      }
      opener = null;
    };

    accept?.addEventListener('click', () => {
      saveConsent(true);
      hide();
      if (id) startMetrika(id);
    });
    decline?.addEventListener('click', () => {
      saveConsent(false);
      hide();
      if (id) stopMetrika(id);
    });

    document.addEventListener('click', (event) => {
      const button = (event.target as Element | null)?.closest?.<HTMLElement>('[data-cookie-settings]');
      if (!button) return;
      opener = button;
      show(true);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && opener && !banner.hidden) hide();
    });

    const choice = readConsent();
    if (choice === null) show(false);
    else if (choice && id) {
      // Согласие уже дано: счётчик — когда браузер освободится, первый
      // экран из-за него не ждёт
      const start = () => startMetrika(id);
      // Safari до 18 без requestIdleCallback — тогда после загрузки страницы
      const idle = (window as { requestIdleCallback?: Window['requestIdleCallback'] }).requestIdleCallback;
      if (idle) idle.call(window, start, { timeout: 4000 });
      else if (document.readyState === 'complete') start();
      else addEventListener('load', start, { once: true });
    }

    trackContactClicks();
  }
</script>
