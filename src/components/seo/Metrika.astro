---
/**
 * Счётчик Яндекс Метрики.
 *
 * Для Яндекса это не только отчёты о посещаемости: поведение людей на
 * сайте (сколько читали, вернулись ли в выдачу) — один из сигналов, по
 * которым он решает, кого показать выше по запросу «стоматология
 * Полежаевская». Без счётчика этот сигнал не собирается вовсе. Тот же
 * номер счётчика просят Яндекс Бизнес и Вебмастер при связке сервисов.
 *
 * Пока номер в редакторе не заполнен, ничего не подключается: пустой
 * счётчик грузил бы чужой скрипт на каждой странице просто так.
 *
 * Скрипт отложен до простоя браузера: он не участвует в отрисовке, и
 * тянуть из-за него первый экран незачем.
 */
import seo from '../../data/seo.json';

const id = seo.metrikaId.trim();
---

{
  id && (
    <script is:inline define:vars={{ id }}>
      {`
      (function () {
        var start = function () {
          (function (m, e, t, r, i, k, a) {
            m[i] =
              m[i] ||
              function () {
                (m[i].a = m[i].a || []).push(arguments);
              };
            m[i].l = 1 * new Date();
            for (var j = 0; j < e.scripts.length; j++) {
              if (e.scripts[j].src === r) return;
            }
            k = e.createElement(t);
            a = e.getElementsByTagName(t)[0];
            k.async = 1;
            k.src = r;
            a.parentNode.insertBefore(k, a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

          ym(id, 'init', {
            ssr: true,
            webvisor: true,
            clickmap: true,
            trackLinks: true,
            accurateTrackBounce: true,
          });
        };

        if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 4000 });
        else window.addEventListener('load', start, { once: true });
      })();
      `}
    </script>
    <noscript>
      <div>
        <img
          src={`https://mc.yandex.ru/watch/${id}`}
          style="position:absolute; left:-9999px"
          alt=""
        />
      </div>
    </noscript>
  )
}
