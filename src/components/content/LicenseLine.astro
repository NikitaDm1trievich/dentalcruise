---
/**
 * Строка лицензии: «Лицензия на осуществление медицинской деятельности
 * № Л041-01137-77/00335542 от 30.10.2019, ООО «Дентал Круиз»». Стоит в
 * подвале и в окне лицензии. Пустые номер, дата и юрлицо не выводятся.
 *
 * Номер не рвётся по дефису: «Л041-01137-» и «77/00335542» на разных
 * строках читались бы как два номера. Каждая часть — отдельный текст, так
 * предпросмотр редактора меняет её на лету.
 */
import { clinic } from '../../data/site';

const { title, number, date } = clinic.license;
const { orgName } = clinic.legal;
---

{title}{number && <> <span class="dc-license-line__nowrap">№ {number}</span></>}{date && ` от ${date}`}{
  orgName && `, ${orgName}`
}

<style>
  .dc-license-line__nowrap {
    white-space: nowrap;
  }
</style>
