{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/icons/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onest|Golos Text))/i]",
        "message": "Font not provided by the design system. Available: Onest, Golos Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdvantageCarousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:slides|interval|imageSide|style|key|ref|className|style|children)$/]",
        "message": "<AdvantageCarousel> doesn't accept that prop. Declared props: slides, interval, imageSide, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdvantageCarousel'] > JSXAttribute[name.name='imageSide'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<AdvantageCarousel> imageSide must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:onSubmitted|compact|style|key|ref|className|style|children)$/]",
        "message": "<AppointmentForm> doesn't accept that prop. Declared props: onSubmitted, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|note|key|ref|className|style|children)$/]",
        "message": "<AppointmentModal> doesn't accept that prop. Declared props: open, onClose, title, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:quiet|accent|outline|onDark)$/]",
        "message": "<Badge> tone must be one of 'quiet' | 'accent' | 'outline' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandsMarquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|brands|speed|style|key|ref|className|style|children)$/]",
        "message": "<BrandsMarquee> doesn't accept that prop. Declared props: eyebrow, brands, speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BurgerMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|links|phone|phoneHref|schedule|routeHref|onBook|key|ref|className|style|children)$/]",
        "message": "<BurgerMenu> doesn't accept that prop. Declared props: open, onClose, links, phone, phoneHref, schedule, routeHref, onBook."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|as|fullWidth|icon|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, as, fullWidth, icon, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|onDark|solidDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'onDark' | 'solidDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonColumns'] > JSXAttribute > JSXIdentifier[name!=/^(?:theirTitle|theirItems|ourTitle|ourItems|style|key|ref|className|style|children)$/]",
        "message": "<ComparisonColumns> doesn't accept that prop. Declared props: theirTitle, theirItems, ourTitle, ourItems, style."
