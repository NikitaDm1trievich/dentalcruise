---
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import Header from '../components/layout/Header.astro';
import BurgerMenu from '../components/layout/BurgerMenu.astro';
import Footer from '../components/layout/Footer.astro';
import ContactsCta from '../components/layout/ContactsCta.astro';
import AppointmentModal from '../components/forms/AppointmentModal.astro';
import LicenseDrawer from '../components/content/LicenseDrawer.astro';
import ScrollToTop from '../components/core/ScrollToTop.astro';
import Preloader from '../components/core/Preloader.astro';
import { withBase } from '../lib/asset';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Шапка лежит поверх hero-видео (только главная) */
  overHero?: boolean;
  noindex?: boolean;
  faq?: { q: string; a: string }[];
  /** На странице контактов этот блок уже есть в основном содержимом */
  hideContactsCta?: boolean;
}

const {
  title,
  description,
  path = '/',
  overHero = false,
  noindex = false,
  faq,
  hideContactsCta = false,
} = Astro.props;
const asset = withBase;
---

<!doctype html>
<html lang="ru" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#00B189" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <script is:inline>
      // Снимаем .no-js до первой отрисовки — контент со скролл-анимацией
      // прячется только тогда, когда его точно есть кому показать.
      document.documentElement.classList.remove('no-js');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Golos+Text:wght@400;500;600;700;800&display=swap"
    />

    <Seo title={title} description={description} path={path} noindex={noindex} faq={faq} />
  </head>

  <body>
    {/* Заставка — только на входе в сайт; на внутренних страницах она
        превращается в лишнюю задержку между кликом и содержимым. */}
    {path === '/' && <Preloader />}

    <a href="#main" class="dc-skip">Перейти к содержимому</a>

    <Header overHero={overHero} />
    <BurgerMenu />

    <main id="main">
      <slot />
    </main>

    {!hideContactsCta && <ContactsCta />}
    <Footer />

    <AppointmentModal />
    <LicenseDrawer />
    <ScrollToTop />

    <script>
      import { initReveal } from '../lib/reveal';
      import { initOverlays } from '../lib/overlays';
      import { initFlipCards } from '../lib/flip';
      import { initCountUp } from '../lib/count-up';

      initOverlays();
      initReveal();
      initFlipCards();
      initCountUp();

      // Заставка уходит по готовности страницы, но живёт не меньше MIN_MS:
      // иначе на быстром соединении она мелькает одним кадром и читается
      // как сбой отрисовки. MAX_MS — предохранитель: что бы ни грузилось
      // (видео в hero, шрифты), дольше него человека не держим.
      const preloader = document.querySelector<HTMLElement>('[data-preloader]');
      if (preloader) {
        const MIN_MS = 1500;
        const MAX_MS = 3200;
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const started =
          (window as Window & { __dcPreloaderStart?: number }).__dcPreloaderStart ??
          performance.now();

        let done = false;
        const hide = () => {
          if (done) return;
          done = true;
          preloader.classList.add('is-hidden');
          // В фоновой вкладке таймлайн заморожен и transitionend не приходит —
          // подстраховываемся таймером, иначе слой навсегда остаётся в DOM.
          const drop = () => preloader.remove();
          preloader.addEventListener('transitionend', drop, { once: true });
          window.setTimeout(drop, 900);
        };
        const hideAfterMinimum = () => {
          const shown = performance.now() - started;
          window.setTimeout(hide, calm ? 0 : Math.max(0, MIN_MS - shown));
        };

        if (document.readyState === 'complete') hideAfterMinimum();
        else window.addEventListener('load', hideAfterMinimum, { once: true });
        window.setTimeout(hide, Math.max(0, MAX_MS - (performance.now() - started)));
      }
    </script>

    <style>
      .dc-skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        padding: 12px 20px;
        background: var(--dc-white);
        color: var(--text-strong);
        font-weight: var(--fw-bold);
        border-radius: 0 0 var(--radius-md) 0;
      }
      .dc-skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
