---
/**
 * Фирменные знаки мессенджеров — VK и Max.
 *
 * В Lucide их нет, поэтому пути взяты из официальных логотипов,
 * присланных клиникой (исходники — `brand-assets/`).
 *
 * Знаки монохромные и красятся в currentColor: кнопки шапки, меню и подвала
 * образуют единый ряд одинаковых круглых чипов, и цветная плитка VK или
 * белый силуэт Max выпадали бы из этого ряда — а на светлой шапке белый Max
 * просто пропал бы. Так знак остаётся узнаваемым и читается на любом фоне.
 *
 * Из логотипа VK взят только сам знак, без синей подложки; viewBox обрезан
 * по его границам, чтобы в круглой кнопке он не оказался мелким пятном.
 */
interface Props {
  name: 'vk' | 'max';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

/**
 * `scale` — множитель к базовому размеру, `ratio` — ширина/высота знака.
 * Знак VK широкий и низкий: втиснутый в квадрат, он выглядел заметно мельче
 * круглого Max в том же ряду кнопок. Поэтому размеры считаются от пропорций
 * самого знака, а не от общей квадратной рамки.
 */
const MARKS = {
  vk: {
    viewBox: '15 28 71 46',
    ratio: 71 / 46,
    scale: 1.24,
    label: 'ВКонтакте',
    path: 'M53.7085 72.042C30.9168 72.042 17.9169 56.417 17.3752 30.417H28.7919C29.1669 49.5003 37.5834 57.5836 44.25 59.2503V30.417H55.0004V46.8752C61.5837 46.1669 68.4995 38.667 70.8329 30.417H81.5832C79.7915 40.5837 72.2915 48.0836 66.9582 51.1669C72.2915 53.6669 80.8336 60.2086 84.0836 72.042H72.2499C69.7082 64.1253 63.3754 58.0003 55.0004 57.1669V72.042H53.7085Z',
  },
  max: {
    viewBox: '0 0 720 720',
    ratio: 1,
    scale: 1,
    label: 'Max',
    path: 'M350.4,9.6C141.8,20.5,4.1,184.1,12.8,390.4c3.8,90.3,40.1,168,48.7,253.7,2.2,22.2-4.2,49.6,21.4,59.3,31.5,11.9,79.8-8.1,106.2-26.4,9-6.1,17.6-13.2,24.2-22,27.3,18.1,53.2,35.6,85.7,43.4,143.1,34.3,299.9-44.2,369.6-170.3C799.6,291.2,622.5-4.6,350.4,9.6h0ZM269.4,504c-11.3,8.8-22.2,20.8-34.7,27.7-18.1,9.7-23.7-.4-30.5-16.4-21.4-50.9-24-137.6-11.5-190.9,16.8-72.5,72.9-136.3,150-143.1,78-6.9,150.4,32.7,183.1,104.2,72.4,159.1-112.9,316.2-256.4,218.6h0Z',
  },
} as const;

const mark = MARKS[name];
const width = Math.round(size * mark.scale * 10) / 10;
const height = Math.round((width / mark.ratio) * 10) / 10;
---

<svg
  width={width}
  height={height}
  viewBox={mark.viewBox}
  fill="currentColor"
  aria-hidden="true"
  class:list={['dc-brand', className]}
>
  <path d={mark.path} />
</svg>

<style>
  .dc-brand {
    flex: 0 0 auto;
    display: block;
  }
</style>
