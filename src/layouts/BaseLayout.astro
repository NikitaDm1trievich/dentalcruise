---
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import Metrika from '../components/seo/Metrika.astro';
import Header from '../components/layout/Header.astro';
import BurgerMenu from '../components/layout/BurgerMenu.astro';
import Footer from '../components/layout/Footer.astro';
import ContactsCta from '../components/layout/ContactsCta.astro';
import AppointmentModal from '../components/forms/AppointmentModal.astro';
import LicenseDrawer from '../components/content/LicenseDrawer.astro';
import ScrollToTop from '../components/core/ScrollToTop.astro';
import StickyActions from '../components/layout/StickyActions.astro';
import Preloader from '../components/core/Preloader.astro';
import ThemeVars from '../components/core/ThemeVars.astro';
import theme from '../data/theme.json';
import { withBase } from '../lib/asset';
// Кириллица обоих семейств уходит в <link rel="preload">: это первое, что
// нужно тексту над hero. Импорт с ?url даёт тот же хэшированный адрес, что
// и url() в @font-face (см. styles/tokens/fonts.css), поэтому файл не
// скачивается дважды.
import onestCyrillicUrl from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import golosCyrillicUrl from '@fontsource-variable/golos-text/files/golos-text-cyrillic-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Шапка лежит поверх hero-видео (только главная) */
  overHero?: boolean;
  noindex?: boolean;
  faq?: { q: string; a: string }[];
  /** На странице контактов этот блок уже есть в основном содержимом */
  hideContactsCta?: boolean;
  /** Хлебные крошки для микроразметки — те же, что рисует PageLayout */
  breadcrumbs?: { label: string; path?: string }[];
  /** Дополнительные блоки JSON-LD страницы: врач, услуга, галерея */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  path = '/',
  overHero = false,
  noindex = false,
  faq,
  hideContactsCta = false,
  breadcrumbs,
  schema,
} = Astro.props;
const asset = withBase;
---

<!doctype html>
<html lang="ru" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.accent.base} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />

    <script is:inline>
      // Снимаем .no-js до первой отрисовки — контент со скролл-анимацией
      // прячется только тогда, когда его точно есть кому показать.
      document.documentElement.classList.remove('no-js');
      // Страница открыта в живом предпросмотре редактора: заставку и
      // появление блоков при прокрутке выключаем, владельцу нужен сразу
      // весь текст, а не анимация на каждую перезагрузку фрейма.
      if (/[?&]cms-preview\b/.test(location.search)) {
        document.documentElement.classList.add('dc-cms-preview');
      }
    </script>

    {/* Шрифты подключает styles/tokens/fonts.css; латиницу браузер найдёт
        через @font-face, кириллицу просим заранее — до разбора CSS.
        crossorigin обязателен и для своего домена: без него шрифт
        скачался бы второй раз уже из CSS. */}
    <link rel="preload" as="font" type="font/woff2" href={onestCyrillicUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={golosCyrillicUrl} crossorigin />

    <Seo title={title} description={description} path={path} noindex={noindex} faq={faq} breadcrumbs={breadcrumbs} schema={schema} />

    <ThemeVars />
  </head>

  <body>
    {/* Заставка — только на входе в сайт; на внутренних страницах она
        превращается в лишнюю задержку между кликом и содержимым. */}
    {path === '/' && <Preloader />}

    <a href="#main" class="dc-skip">Перейти к содержимому</a>

    <Header overHero={overHero} />
    <BurgerMenu />

    <main id="main">
      <slot />
    </main>

    {!hideContactsCta && <ContactsCta />}
    <Footer />

    <AppointmentModal />
    <LicenseDrawer />
    <ScrollToTop />
    {/* Нижняя панель «Позвонить · Записаться · Max» на телефоне: после
        первого экрана кнопки записи уходят из вида на 15–19 экранов
        главной. Стоит прямо в body, не в main: её маркер первого экрана
        позиционируется от верха документа. На ≥ 900px панель скрыта. */}
    <StickyActions />
    <Metrika />

    <script>
      import { initReveal } from '../lib/reveal';
      import { initOverlays } from '../lib/overlays';
      import { initFlipCards } from '../lib/flip';
      import { initCountUp } from '../lib/count-up';

      initOverlays();
      initReveal();
      initFlipCards();
      initCountUp();
      // Код предпросмотра редактора грузится отдельным файлом и только во
      // фрейме редактора (?cms-preview): посетителям сайта он не нужен.
      if (document.documentElement.classList.contains('dc-cms-preview')) {
        void import('../lib/cms-preview').then(({ initCmsPreview }) => initCmsPreview());
      }

      // Заставка живёт ровно столько, сколько разбирается документ: уходит
      // по DOMContentLoaded, картинки и видео не ждём — у них есть poster и
      // lazy-loading. Минимального времени показа нет: на быстрой сети она
      // растворяется почти сразу, и это цена того, что контент не ждёт
      // (аудит: заставка держала главную ≥ 1,5 с). MAX_MS — предохранитель:
      // как бы ни тянулся разбор на медленной сети, дольше него не держим.
      const preloader = document.querySelector<HTMLElement>('[data-preloader]');
      if (preloader) {
        const MAX_MS = 1500;
        const started =
          (window as Window & { __dcPreloaderStart?: number }).__dcPreloaderStart ??
          performance.now();

        let done = false;
        const hide = () => {
          if (done) return;
          done = true;
          preloader.classList.add('is-hidden');
          // В фоновой вкладке таймлайн заморожен и transitionend не приходит —
          // подстраховываемся таймером, иначе слой навсегда остаётся в DOM.
          const drop = () => preloader.remove();
          preloader.addEventListener('transitionend', drop, { once: true });
          window.setTimeout(drop, 600);
        };

        // Модульный скрипт выполняется уже после разбора, так что обычно
        // документ готов и заставка уходит сразу; ветка с событием — на
        // случай, если порядок загрузки окажется иным.
        if (document.readyState !== 'loading') hide();
        else document.addEventListener('DOMContentLoaded', hide, { once: true });
        window.setTimeout(hide, Math.max(0, MAX_MS - (performance.now() - started)));
      }
    </script>

    <style>
      .dc-skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        padding: 12px 20px;
        background: var(--dc-white);
        color: var(--text-strong);
        font-weight: var(--fw-bold);
        border-radius: 0 0 var(--radius-md) 0;
      }
      .dc-skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
