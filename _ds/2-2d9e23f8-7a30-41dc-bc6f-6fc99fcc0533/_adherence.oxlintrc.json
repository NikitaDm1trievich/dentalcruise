        "selector": "JSXOpeningElement[name.name='DoctorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|speciality|experience|note|photoLabel|photoSrc|style|key|ref|className|style|children)$/]",
        "message": "<DoctorCard> doesn't accept that prop. Declared props: name, speciality, experience, note, photoLabel, photoSrc, style."
